{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (MSVC, no vcpkg)",
      "description": "Default config: no generator is pinned, so CMake picks the newest installed Visual Studio (2022 or 2026 both work). GoogleTest is fetched via FetchContent when not provided by vcpkg.",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "MRF_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-vcpkg",
      "displayName": "Windows x64 (MSVC + vcpkg)",
      "description": "Requires the VCPKG_ROOT environment variable to be set.",
      "inherits": "windows-x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "$env{VCPKG_ROOT}",
        "rhs": ""
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 (GCC/Clang + vcpkg)",
      "description": "Requires the VCPKG_ROOT environment variable to be set. Radio backends (libhackrf/librtlsdr) are expected as system packages (e.g. libhackrf0, librtlsdr0) and are picked up at runtime via dlopen, not built from the vendored submodules.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "MRF_BUILD_TESTS": "ON",
        "MRF_BUILD_RADIO_DLLS_FROM_SUBMODULES": "OFF",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-arm64",
      "displayName": "Linux arm64 (GCC/Clang + vcpkg)",
      "description": "Native arm64 build — a Raspberry Pi, a uConsole, or an arm64 CI runner. Same as linux-x64 but for the arm64-linux triplet, which vcpkg only builds with VCPKG_FORCE_SYSTEM_BINARIES set: it ships no prebuilt cmake/ninja/powershell for arm64 and has to use the system's. Radio backends come from system packages and are picked up at runtime via dlopen. Requires VCPKG_ROOT.",
      "inherits": "linux-x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-linux"
      },
      "environment": {
        "VCPKG_FORCE_SYSTEM_BINARIES": "1"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64 (AppleClang + vcpkg) — UNTESTED",
      "description": "UNTESTED: mirrors linux-x64 but has never been run on real macOS hardware. Radio backends (libhackrf/librtlsdr) are expected from Homebrew (brew install hackrf librtlsdr) and picked up at runtime via dlopen rather than built from the vendored submodules. Requires VCPKG_ROOT.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "MRF_BUILD_TESTS": "ON",
        "MRF_BUILD_RADIO_DLLS_FROM_SUBMODULES": "OFF",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-x64",
      "displayName": "macOS x64 (AppleClang + vcpkg) — UNTESTED",
      "description": "UNTESTED: Intel-Mac counterpart of macos-arm64. See that preset's notes.",
      "inherits": "macos-arm64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "VCPKG_TARGET_TRIPLET": "x64-osx"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-vcpkg-debug",
      "configurePreset": "windows-x64-vcpkg",
      "configuration": "Debug"
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64",
      "configuration": "Debug"
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64",
      "configuration": "Release"
    },
    {
      "name": "linux-arm64-release",
      "configurePreset": "linux-arm64",
      "configuration": "Release"
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64",
      "configuration": "Release"
    },
    {
      "name": "macos-x64-release",
      "configurePreset": "macos-x64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
