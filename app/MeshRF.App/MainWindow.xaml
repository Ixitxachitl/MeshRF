<Window x:Class="MeshRF.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:vm="clr-namespace:MeshRF.App.ViewModels"
        xmlns:views="clr-namespace:MeshRF.App.Views"
        xmlns:conv="clr-namespace:MeshRF.App.Converters"
        xmlns:beh="clr-namespace:MeshRF.App.Behaviors"
        Title="MeshRF"
        Height="1000" Width="1280"
        WindowStartupLocation="Manual"
        MinHeight="480" MinWidth="720">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <conv:PskTextConverter x:Key="PskText" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BrushPanelBackground}"
                BorderBrush="{DynamicResource BrushPanelBorder}"
            BorderThickness="0"
                Padding="4,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToolBar Grid.Column="0">
            <TextBlock Text="RX" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Width="150"
                      ItemsSource="{Binding DeviceOptions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                      IsEnabled="{Binding CanSelectDevice}"
                      ToolTip="Receive SDR backend (selectable when stopped)" />
            <TextBlock Text="Rate" VerticalAlignment="Center" Margin="8,0,4,0" />
            <ComboBox Width="110"
                      ItemsSource="{Binding SampleRateOptions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedRxSampleRate, Mode=TwoWay}"
                      IsEnabled="{Binding CanSelectRxSampleRate}"
                      ToolTip="RX sample rate in MS/s; choices are limited to the selected receiver's supported rates" />
            <TextBlock Text="TX" VerticalAlignment="Center" Margin="8,0,4,0" />
            <ComboBox Width="150"
                      ItemsSource="{Binding TxDeviceOptions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedTxDevice, Mode=TwoWay}"
                      IsEnabled="{Binding CanSelectDevice}"
                      ToolTip="Transmit SDR backend; HackRF can transmit, RTL-SDR cannot" />
            <Separator />
            <TextBlock Text="Region" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Width="90"
                      ItemsSource="{Binding Regions}"
                      SelectedItem="{Binding SelectedRegion, Mode=TwoWay}" />
            <TextBlock Text="Preset" VerticalAlignment="Center" Margin="8,0,4,0" />
            <ComboBox Width="130"
                      ItemsSource="{Binding Presets}"
                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
            <!-- LoRa parameter overrides: auto-filled from preset, manually editable -->
            <TextBlock Text="SF" VerticalAlignment="Center" Margin="8,0,2,0"
                       ToolTip="Spreading factor — auto-filled from preset; edit to override" />
            <TextBox Width="28"
                     Text="{Binding OverrideSf, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     ToolTip="Spreading factor (5–12). Auto-filled from preset; edit to override." />
            <TextBlock Text="BW" VerticalAlignment="Center" Margin="6,0,2,0"
                       ToolTip="Bandwidth in kHz — auto-filled from preset; edit to override" />
            <TextBox Width="52"
                     Text="{Binding OverrideBwKhz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     ToolTip="Bandwidth in kHz (e.g. 250, 125, 62.5, 15.6). Auto-filled from preset; edit to override." />
            <TextBlock Text="CR" VerticalAlignment="Center" Margin="6,0,2,0"
                       ToolTip="Coding rate denominator — auto-filled from preset; edit to override" />
            <TextBox Width="24"
                     Text="{Binding OverrideCr, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     ToolTip="Coding rate denominator (5–8 → 4/N). Auto-filled from preset; edit to override." />
            <TextBlock Text="Slot" VerticalAlignment="Center" Margin="8,0,4,0" />
            <ComboBox Width="70"
                      ItemsSource="{Binding Slots}"
                      SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                      ToolTip="Meshtastic channel slot (1-indexed)" />
            <TextBlock Text="Freq (MHz)" VerticalAlignment="Center" Margin="8,0,4,0" />
            <TextBox Width="100"
                     Text="{Binding CenterFreqMHz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"
                     ToolTip="Center frequency in MHz (auto-set from slot)" />
            <Separator />
            <Button Width="36" Height="28"
                    Command="{Binding ToggleCommand}"
                    ToolTip="Start / Stop receive">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content">
                            <Setter.Value>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="#1E9F4A"
                                           Text="&#xE768;" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="#C62828"
                                                   Text="&#xE71A;" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Width="36" Height="28"
                    Margin="4,0,0,0"
                    Command="{Binding ToggleCaptureCommand}"
                    ToolTip="Start / stop raw IQ capture (.cf32) of the modem input">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content">
                            <Setter.Value>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Text="&#xE7C8;" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="#C62828"
                                                   Text="&#xE7C8;" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Width="36" Height="28"
                    Margin="4,0,0,0"
                    Command="{Binding ToggleRecordPayloadsCommand}"
                    ToolTip="Start / stop recording decoded payloads (.json)">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content">
                            <Setter.Value>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Text="&#xE74E;" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecordingPayloads}" Value="True">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="#C62828"
                                                   Text="&#xE74E;" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding Status}" />
                </ToolBar>

                <Button Grid.Column="1"
                        Width="32" Height="28"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Click="OnAboutClick"
                        ToolTip="About MeshRF">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE946;" />
                </Button>
            </Grid>
        </Border>

                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource BrushPanelBackground}"
                        BorderBrush="{DynamicResource BrushPanelBorder}"
                        BorderThickness="0"
                        Padding="4,2">
                            <Grid>
                            <ToolBar HorizontalAlignment="Stretch">
                  <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        ClipToBounds="True"
                        Visibility="{Binding IsHackRf, Converter={StaticResource BoolToVis}}">
                 <TextBlock Text="RX" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                 <TextBlock Text="LNA" VerticalAlignment="Center" Margin="0,0,4,0"
                          ToolTip="HackRF LNA gain (RF-stage), 0..40 dB step 8" />
                 <Slider Width="110"
                        Minimum="0" Maximum="40"
                        TickFrequency="8" IsSnapToTickEnabled="True"
                        SmallChange="8" LargeChange="8"
                        Value="{Binding LnaGainDb, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                 <TextBlock Width="32" VerticalAlignment="Center"
                          Text="{Binding LnaGainDb, StringFormat={}{0} dB}" />

                 <TextBlock Text="VGA" VerticalAlignment="Center" Margin="8,0,4,0"
                          ToolTip="HackRF baseband VGA gain, 0..62 dB step 2" />
                 <Slider Width="130"
                        Minimum="0" Maximum="62"
                        TickFrequency="2" IsSnapToTickEnabled="True"
                        SmallChange="2" LargeChange="2"
                        Value="{Binding VgaGainDb, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                 <TextBlock Width="32" VerticalAlignment="Center"
                          Text="{Binding VgaGainDb, StringFormat={}{0} dB}" />

                 <Separator />
                 <ToggleButton Content="AMP (+14 dB)"
                               Style="{StaticResource {x:Type ToggleButton}}"
                           IsChecked="{Binding AmpEnable, Mode=TwoWay}"
                           VerticalAlignment="Center"
                           ToolTip="Enable HackRF front-end RF amplifier" />
              </StackPanel>

                                    <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    ClipToBounds="True"
                    Visibility="{Binding IsRtlSdr, Converter={StaticResource BoolToVis}}">
                 <TextBlock Text="RX" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                 <TextBlock Text="Gain" VerticalAlignment="Center" Margin="0,0,4,0"
                      ToolTip="RTL-SDR manual tuner gain, 0..49 dB" />
                 <Slider Width="220"
                    Minimum="0" Maximum="49"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    SmallChange="1" LargeChange="5"
                    Value="{Binding RtlGainDb, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding RtlAgcEnable, Converter={StaticResource InverseBool}}" />
                 <TextBlock Width="40" VerticalAlignment="Center"
                      Text="{Binding RtlGainDb, StringFormat={}{0} dB}" />

                 <Separator />
                 <ToggleButton Content="AGC"
                               Style="{StaticResource {x:Type ToggleButton}}"
                               IsChecked="{Binding RtlAgcEnable, Mode=TwoWay}"
                               VerticalAlignment="Center"
                               ToolTip="Tuner automatic gain control (overrides the manual gain slider)" />
                 <Separator />
                 <ToggleButton Content="Bias-T"
                               Style="{StaticResource {x:Type ToggleButton}}"
                               IsChecked="{Binding BiasTee, Mode=TwoWay}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="Enable 5 V bias-T on the antenna port to power an external LNA/active antenna" />
                  </StackPanel>

                      <Border Width="1"
                          Height="22"
                          Margin="12,0"
                          VerticalAlignment="Center"
                          Background="{DynamicResource BrushPanelBorder}"
                          Visibility="{Binding IsTxHackRf, Converter={StaticResource BoolToVis}}" />

                  <StackPanel
                        Orientation="Horizontal"
                                HorizontalAlignment="Left"
                        Visibility="{Binding IsTxHackRf, Converter={StaticResource BoolToVis}}">
                 <TextBlock Text="TX" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                 <TextBlock Text="Gain" VerticalAlignment="Center" Margin="0,0,4,0"
                          ToolTip="HackRF TX VGA gain, 0..47 dB" />
                 <Slider Width="120"
                        Minimum="0" Maximum="47"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        SmallChange="1" LargeChange="4"
                        Value="{Binding TxGainDb, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                 <TextBlock Width="40" VerticalAlignment="Center"
                          Text="{Binding TxGainDb, StringFormat={}{0} dB}" />

                 <Separator />
                 <ToggleButton Content="AMP (+14 dB)"
                               Style="{StaticResource {x:Type ToggleButton}}"
                           IsChecked="{Binding TxAmpEnable, Mode=TwoWay}"
                           VerticalAlignment="Center"
                           ToolTip="Enable the HackRF RF amplifier for transmit output" />
              </StackPanel>
              </ToolBar>
              </Grid>
          </Border>

        <Border DockPanel.Dock="Top"
            Background="{DynamicResource BrushPanelBackground}"
            BorderBrush="{DynamicResource BrushPanelBorder}"
            BorderThickness="0"
            Padding="4,2">
            <Grid>
            <ToolBar HorizontalAlignment="Stretch">
                <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="90"
                      ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding Theme, Mode=TwoWay}" />

                <Separator />
                <TextBlock Text="Units" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="92"
                      ItemsSource="{Binding UnitSystems}"
                      SelectedItem="{Binding UnitSystemName, Mode=TwoWay}"
                      ToolTip="Display units used throughout the app" />

                <Separator />
                <TextBlock Text="Colormap" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="90"
                      ItemsSource="{Binding WaterfallColormaps}"
                      SelectedItem="{Binding WaterfallColormap, Mode=TwoWay}" />

                <Separator />
                <CheckBox Content="Auto levels"
                      IsChecked="{Binding WaterfallAutoLevels, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      ToolTip="Track 5th/99th percentile of recent frames" />
                <TextBlock Text="floor" VerticalAlignment="Center" Margin="6,0,4,0" />
                <Slider Width="140"
                    Minimum="-140" Maximum="0"
                    TickFrequency="5" IsSnapToTickEnabled="False"
                    Value="{Binding WaterfallFloorDb, Mode=TwoWay}"
                    VerticalAlignment="Center" />
                <TextBlock Width="48" VerticalAlignment="Center"
                       Text="{Binding WaterfallFloorDb, StringFormat={}{0:F0} dB}" />
                <TextBlock Text="ceil" VerticalAlignment="Center" Margin="6,0,4,0" />
                <Slider Width="140"
                    Minimum="-100" Maximum="20"
                    TickFrequency="5" IsSnapToTickEnabled="False"
                    Value="{Binding WaterfallCeilDb, Mode=TwoWay}"
                    VerticalAlignment="Center" />
                <TextBlock Width="48" VerticalAlignment="Center"
                       Text="{Binding WaterfallCeilDb, StringFormat={}{0:F0} dB}" />
                <Separator />
                <TextBlock Text="Speed" VerticalAlignment="Center" Margin="6,0,4,0" />
                <Slider Width="120"
                    Minimum="5" Maximum="240"
                    TickFrequency="5" IsSnapToTickEnabled="False"
                    Value="{Binding WaterfallRowsPerSecond, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    ToolTip="Waterfall scroll speed in rows per second (time resolution). Higher = faster, finer time detail; does not affect frequency resolution." />
                <TextBlock Width="48" VerticalAlignment="Center"
                       Text="{Binding WaterfallRowsPerSecond, StringFormat={}{0:F0}/s}" />
                <Separator />
                <ToggleButton Content="DC block"
                              Style="{StaticResource {x:Type ToggleButton}}"
                              IsChecked="{Binding DcBlockEnable, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              ToolTip="IIR high-pass to remove the LO leakage spike at the tuned centre frequency. Leave on for normal use; disable only for diagnostics." />
            </ToolBar>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
            Background="{DynamicResource BrushPanelBackground}"
            BorderBrush="{DynamicResource BrushPanelBorder}"
            BorderThickness="0"
            Padding="4,2">
            <Grid>
            <ToolBar HorizontalAlignment="Stretch">
            <TextBlock Text="Ringtone" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Width="100"
                  ItemsSource="{Binding RingtoneModes}"
                  SelectedItem="{Binding RingtoneMode, Mode=TwoWay}"
                  ToolTip="How long the alert tone plays when a text message arrives" />

            <Separator />
            <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Slider Width="120"
                Minimum="0" Maximum="100"
                TickFrequency="5" IsSnapToTickEnabled="False"
                Value="{Binding RingtoneVolume, Mode=TwoWay}"
                VerticalAlignment="Center" />
            <TextBlock Width="36" VerticalAlignment="Center"
                   Text="{Binding RingtoneVolume, StringFormat={}{0:F0}%}" />

            <Separator />
            <TextBlock Text="RTTTL" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Width="600"
                 Text="{Binding RingtoneRtttl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Center"
                 ToolTip="Ringtone in Meshtastic RTTTL format" />
            <Button Content="Preview" Margin="4,0,0,0"
                Command="{Binding TestRingtoneCommand}"
                ToolTip="Preview the current ringtone" />
            </ToolBar>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="RSSI: " />
                    <Run Text="{Binding RssiDbfs, StringFormat=F1, Mode=OneWay}" />
                    <Run Text=" dBFS  Peak: " />
                    <Run Text="{Binding PeakDbfs, StringFormat=F1, Mode=OneWay}" />
                    <Run Text="  ChUtil: " />
                    <Run Text="{Binding LiveChannelUtilizationPct, StringFormat=F2, Mode=OneWay}" />
                    <Run Text="%  AirTx: " />
                    <Run Text="{Binding LiveAirUtilTxPct, StringFormat=F2, Mode=OneWay}" />
                    <Run Text="%  UI FPS: " />
                    <Run Text="{Binding UiFrameRateHz, StringFormat=F1, Mode=OneWay}" />
                    <Run Text="  " />
                    <Run Text="{Binding UiPerfSummary, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding DeviceBadge}"
                           ToolTip="{Binding DeviceStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#888" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRealRadio}" Value="True">
                                    <Setter Property="Foreground" Value="#1E9F4A" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <Grid x:Name="MainLayoutGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Left side: map (top) over nodes/identity (bottom). -->
            <Grid x:Name="LeftPaneGrid" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <views:MapView Grid.Row="0" x:Name="Map" Margin="4" />

                <GridSplitter Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="{DynamicResource BrushSplitter}"
                              ShowsPreview="False"
                              ResizeBehavior="PreviousAndNext" />

                <!-- Bottom-left quarter: node list + identity. -->
                <DockPanel x:Name="LeftBottomDock" Grid.Row="2" Margin="4">
                    <!-- Compact My Node bar — opens the identity settings window. -->
                    <Border DockPanel.Dock="Top"
                            Margin="0,0,0,4" Padding="6,4"
                            Background="{DynamicResource BrushPanelBackground}"
                            BorderBrush="{DynamicResource BrushPanelBorder}"
                            BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0">
                                <Button Padding="8,2" Margin="0,0,4,0"
                                        Content="Self telemetry"
                                        Click="OnOpenSelfTelemetryHistory"
                                        ToolTip="Open telemetry history for this node" />
                                <Button Padding="8,2" Margin="0,0,4,0"
                                        Content="Self position"
                                        Click="OnOpenSelfLocationHistory"
                                        ToolTip="Open position history for this node" />
                                <Button Padding="8,2"
                                        Content="Configure"
                                        Click="OnOpenNodeIdentity"
                                        ToolTip="Open My Node identity and settings" />
                            </StackPanel>
                            <TextBlock Text="My Node" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushSubtle}"
                                       Text="{Binding MyLongName}" />
                        </DockPanel>
                    </Border>

                        <Border DockPanel.Dock="Top"
                            Margin="0,0,0,4"
                            Padding="6,4"
                            Background="{DynamicResource BrushPanelBackground}"
                            BorderBrush="{DynamicResource BrushPanelBorder}"
                            BorderThickness="1">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                   Text="Quick send"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                            <Button DockPanel.Dock="Left"
                                Content="Node info"
                                Padding="10,3"
                                Margin="0,0,4,0"
                                Click="OnSendNodeInfoPrompted"
                                ToolTip="Choose a channel, then send your NODEINFO payload" />
                            <Button DockPanel.Dock="Left"
                                Content="Position"
                                Padding="10,3"
                                Margin="0,0,4,0"
                                Click="OnSendPositionPrompted"
                                ToolTip="Choose a channel, then send your POSITION payload" />
                            <Button DockPanel.Dock="Left"
                                Content="Device metrics"
                                Padding="10,3"
                                Margin="0,0,4,0"
                                Click="OnSendDeviceMetricsPrompted"
                                ToolTip="Choose a channel, then send your TELEMETRY device metrics" />
                            <Button DockPanel.Dock="Left"
                                Content="Env telemetry"
                                Padding="10,3"
                                Margin="0,0,4,0"
                                Click="OnSendEnvironmentMetricsPrompted"
                                ToolTip="Choose a channel, fetch weather data, then send TELEMETRY environment metrics" />
                            <Button DockPanel.Dock="Left"
                                Content="AQ telemetry"
                                Padding="10,3"
                                Margin="0,0,4,0"
                                Click="OnSendAirQualityMetricsPrompted"
                                ToolTip="Choose a channel, fetch PM2.5/PM10 from Open-Meteo Air Quality API, then send TELEMETRY air quality metrics" />
                            <Button DockPanel.Dock="Left"
                                Content="Status"
                                Padding="10,3"
                                Click="OnSendNodeStatusPrompted"
                                ToolTip="Choose a channel, then send your NODE_STATUS_APP text" />
                        </DockPanel>
                        </Border>

                    <TextBlock DockPanel.Dock="Top"
                               Text="Nodes"
                               FontWeight="SemiBold"
                               Margin="2,0,0,2" />

                    <!-- Node list filter bar -->
                    <Border DockPanel.Dock="Top"
                            Margin="0,0,0,3" Padding="4,3"
                            Background="{DynamicResource BrushPanelBackground}"
                            BorderBrush="{DynamicResource BrushPanelBorder}"
                            BorderThickness="1">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                <Button DockPanel.Dock="Right"
                                        Content="Clear"
                                        FontSize="11"
                                        Padding="8,2"
                                        Margin="6,0,0,0"
                                        Command="{Binding ClearNodeFiltersCommand}"
                                        ToolTip="Clear all filters" />
                                <TextBlock DockPanel.Dock="Left"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Margin="0,0,6,0"
                                           Text="Search" />
                                <TextBox Height="22" FontSize="11"
                                         Text="{Binding NodeSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search by name, short name, or node ID" />
                            </DockPanel>

                            <Expander Header="Filters" IsExpanded="False">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="220">
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Hops" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding NodeHopsFilterOptions}"
                                              SelectedItem="{Binding NodeHopsFilter, Mode=TwoWay}"
                                              ToolTip="Hops filter" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Key status" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding NodeKeyFilterOptions}"
                                              SelectedItem="{Binding NodeKeyFilter, Mode=TwoWay}"
                                              ToolTip="Key filter" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Signed" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding NodeSignedFilterOptions}"
                                              SelectedItem="{Binding NodeSignedFilter, Mode=TwoWay}"
                                              ToolTip="Filter by PKI-derived signed node identity (green key indicator)" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Position" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding NodeLocationFilterOptions}"
                                              SelectedItem="{Binding NodeLocationFilter, Mode=TwoWay}"
                                              ToolTip="Position filter" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Invalid pos" />
                                    <CheckBox Grid.Row="4" Grid.Column="1"
                                              VerticalAlignment="Center"
                                              FontSize="11"
                                              Content="Hide invalid"
                                              IsChecked="{Binding HideInvalidNodeLocations, Mode=TwoWay}"
                                              ToolTip="Hide nodes with out-of-range or near-0,0 positions" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Ignored nodes" />
                                    <ComboBox Grid.Row="5" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding NodeIgnoredFilterOptions}"
                                              SelectedItem="{Binding NodeIgnoredFilter, Mode=TwoWay}"
                                              ToolTip="Ignored nodes" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Via MQTT" />
                                    <ComboBox Grid.Row="6" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding NodeMqttFilterOptions}"
                                              SelectedItem="{Binding NodeMqttFilter, Mode=TwoWay}"
                                              ToolTip="Filter nodes that have been seen via MQTT" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Heard within" />
                                    <DockPanel Grid.Row="7" Grid.Column="1" LastChildFill="False">
                                        <TextBox Width="56" Height="22" FontSize="11"
                                                 Text="{Binding NodeMaxAgeMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Show only nodes heard within the last N minutes (blank = any)" />
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" Text="minutes" />
                                    </DockPanel>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Max distance" />
                                    <DockPanel Grid.Row="8" Grid.Column="1" LastChildFill="False"
                                               Opacity="{Binding HasHomeLocation, Converter={StaticResource BoolToOpacity}}">
                                        <TextBox Width="64" Height="22" FontSize="11"
                                                 IsEnabled="{Binding HasHomeLocation}"
                                                 Text="{Binding NodeDistanceKmText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding MaxDistanceFilterToolTip}" />
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" Text="{Binding DistanceUnitShort}" />
                                    </DockPanel>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has temperature" />
                                    <ComboBox Grid.Row="9" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodeTemperatureFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether temperature telemetry is present" />

                                    <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has humidity" />
                                    <ComboBox Grid.Row="10" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodeHumidityFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether humidity telemetry is present" />

                                    <TextBlock Grid.Row="11" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has pressure" />
                                    <ComboBox Grid.Row="11" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodePressureFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether pressure telemetry is present" />

                                    <TextBlock Grid.Row="12" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has gas resist." />
                                    <ComboBox Grid.Row="12" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodeGasResistanceFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether gas resistance telemetry is present" />

                                    <TextBlock Grid.Row="13" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has IAQ" />
                                    <ComboBox Grid.Row="13" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodeIaqFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether IAQ telemetry is present" />

                                    <TextBlock Grid.Row="14" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has PM1.0 std" />
                                    <ComboBox Grid.Row="14" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodePm10StdFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether PM1.0 standard air quality is present" />

                                    <TextBlock Grid.Row="15" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has PM2.5 std" />
                                    <ComboBox Grid.Row="15" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodePm25StdFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether PM2.5 standard air quality is present" />

                                    <TextBlock Grid.Row="16" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has PM10 std" />
                                    <ComboBox Grid.Row="16" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodePm100StdFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether PM10 standard air quality is present" />

                                    <TextBlock Grid.Row="17" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has PM1.0 env" />
                                    <ComboBox Grid.Row="17" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodePm10EnvFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether PM1.0 environmental air quality is present" />

                                    <TextBlock Grid.Row="18" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has PM2.5 env" />
                                    <ComboBox Grid.Row="18" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodePm25EnvFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether PM2.5 environmental air quality is present" />

                                    <TextBlock Grid.Row="19" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has PM10 env" />
                                    <ComboBox Grid.Row="19" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodePm100EnvFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether PM10 environmental air quality is present" />

                                    <TextBlock Grid.Row="20" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has Ch1 voltage" />
                                    <ComboBox Grid.Row="20" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodeCh1VoltageFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether power channel 1 voltage is present" />

                                    <TextBlock Grid.Row="21" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has Ch1 current" />
                                    <ComboBox Grid.Row="21" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodeCh1CurrentFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether power channel 1 current is present" />

                                    <TextBlock Grid.Row="22" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has Ch2 voltage" />
                                    <ComboBox Grid.Row="22" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodeCh2VoltageFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether power channel 2 voltage is present" />

                                    <TextBlock Grid.Row="23" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has Ch2 current" />
                                    <ComboBox Grid.Row="23" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodeCh2CurrentFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether power channel 2 current is present" />

                                    <TextBlock Grid.Row="24" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has Ch3 voltage" />
                                    <ComboBox Grid.Row="24" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodeCh3VoltageFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether power channel 3 voltage is present" />

                                    <TextBlock Grid.Row="25" Grid.Column="0" Margin="0,2,8,2" VerticalAlignment="Center" FontSize="11" Text="Has Ch3 current" />
                                    <ComboBox Grid.Row="25" Grid.Column="1" Height="22" FontSize="11"
                                              ItemsSource="{Binding TelemetryHasFilterOptions}"
                                              SelectedItem="{Binding NodeCh3CurrentFilter, Mode=TwoWay}"
                                              ToolTip="Filter by whether power channel 3 current is present" />
                                </Grid>
                                </ScrollViewer>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="140" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="2*" MinHeight="120" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Waypoints"
                                       FontWeight="SemiBold"
                                       Margin="2,6,0,2" />

                            <DataGrid x:Name="WaypointsGrid"
                                      ItemsSource="{Binding Waypoints}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserSortColumns="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Extended"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      KeyDown="WaypointsGrid_KeyDown">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                <Setter Property="Foreground" Value="#F57C00" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Delete"
                                                  Click="OnDeleteWaypoints"
                                                  InputGestureText="Del">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE74D;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Icon" Width="42"
                                                            SortMemberPath="Icon">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <emoji:TextBlock Text="{Binding IconText}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Name" Width="2*"
                                                        SortMemberPath="Name"
                                                        Binding="{Binding DisplayName}" />
                                    <DataGridTextColumn Header="From" Width="96"
                                                        SortMemberPath="FromNode"
                                                        Binding="{Binding FromId}"
                                                        FontFamily="Consolas" />
                                    <DataGridTextColumn Header="Lat" Width="88"
                                                        SortMemberPath="Latitude"
                                                        Binding="{Binding Latitude, StringFormat={}{0:F5}}"
                                                        FontFamily="Consolas" />
                                    <DataGridTextColumn Header="Lon" Width="88"
                                                        SortMemberPath="Longitude"
                                                        Binding="{Binding Longitude, StringFormat={}{0:F5}}"
                                                        FontFamily="Consolas" />
                                    <DataGridTextColumn Header="Status" Width="74"
                                                        SortMemberPath="IsExpired"
                                                        Binding="{Binding ExpiryStatus}" />
                                    <DataGridTextColumn Header="Expires" Width="132"
                                                        SortMemberPath="ExpireEpoch"
                                                        Binding="{Binding ExpireTime, StringFormat={}{0:M/d/yyyy h:mm:ss tt}}" />
                                    <DataGridTextColumn Header="Heard" Width="156"
                                                        SortMemberPath="RxEpoch"
                                                        Binding="{Binding RxTime, StringFormat={}{0:M/d/yyyy h:mm:ss tt}}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <GridSplitter Grid.Row="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Height="6"
                                      ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext"
                                      Background="{DynamicResource BrushSplitter}"
                                      ShowsPreview="False" />

                        <DataGrid x:Name="NodesGrid"
                                  Grid.Row="0"
                                  ItemsSource="{Binding NodesView}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Extended"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  MouseDoubleClick="NodesGrid_MouseDoubleClick"
                                  PreviewKeyDown="NodesGrid_KeyDown">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Ignored}" Value="True">
                                            <Setter Property="Foreground" Value="#E57373" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Ignored}" Value="True">
                                            <Setter Property="Foreground" Value="#E57373" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.ContextMenu>
                                <ContextMenu Opened="OnNodesContextMenuOpened"
                                             Closed="OnNodesContextMenuClosed">
                                    <MenuItem Header="Request node info"
                                              Click="OnRequestNodeInfo">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE968;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Exchange node info"
                                              Click="OnExchangeNodeInfo">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE8BD;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Request location"
                                              Click="OnRequestPosition">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE707;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Request telemetry"
                                              Click="OnRequestTelemetry">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE9D2;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Exchange location"
                                              Click="OnExchangeLocation">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE707;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="ShowOnMapMenuItem"
                                              Header="Show on map"
                                              Click="OnShowOnMap">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE909;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Traceroute"
                                              Click="OnTraceroute">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE968;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Request new keys"
                                              Click="OnRequestKeys">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE192;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="ToggleNodeIgnoredMenuItem"
                                              Header="Ignore node"
                                              Click="OnToggleNodeIgnored">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE767;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="ToggleNodeFavoriteMenuItem"
                                              Header="Add to favorites"
                                              Click="OnToggleNodeFavorite">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE734;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="CopyNodesMenuItem"
                                              Header="Copy"
                                              Click="OnCopyNodes"
                                              InputGestureText="Ctrl+C">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE8C8;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Delete"
                                              Click="OnDeleteNodes"
                                              InputGestureText="Del">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="&#xE734;" Width="Auto"
                                                        SortMemberPath="Favorite"
                                                        CanUserResize="True">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="ToolTip" Value="Favorite" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="&#xE735;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="#FFC107"
                                                       HorizontalAlignment="Center"
                                                       ToolTip="Favorite"
                                                       Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="&#xE192;" Width="Auto"
                                                        SortMemberPath="HasPublicKey"
                                                        CanUserResize="True">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="ToolTip" Value="Has encryption key" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="&#xE192;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding HasPublicKey, Converter={StaticResource BoolToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="Has encryption key (PKC direct messages enabled)" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDerivedNodeNumMatch}" Value="True">
                                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                                <Setter Property="ToolTip" Value="Public key matches this node's Meshtastic PKI-derived node number" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasKeyMismatch}" Value="True">
                                                                <Setter Property="Foreground" Value="#E53935" />
                                                                <Setter Property="ToolTip" Value="Key mismatch — this node's public key changed. Right-click → Request new keys to accept it." />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="&#xE198;" Width="Auto"
                                                        SortMemberPath="IsUnmessagable"
                                                        CanUserResize="True">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="ToolTip" Value="Marked unmessagable" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="&#xE198;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#E53935"
                                                       ToolTip="Node is marked unmessagable"
                                                       Visibility="{Binding IsUnmessagableTrue, Converter={StaticResource BoolToVis}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="&#xE707;" Width="Auto"
                                                        SortMemberPath="HasLocation"
                                                        CanUserResize="True">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="ToolTip" Value="Has position" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="&#xE707;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="Has position" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasInvalidLocation}" Value="True">
                                                                <Setter Property="Foreground" Value="#E53935" />
                                                                <Setter Property="ToolTip" Value="Invalid position (near 0,0 or out of bounds)" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Short" Width="Auto"
                                                        SortMemberPath="ShortName"
                                                        ClipboardContentBinding="{Binding ShortName}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <emoji:TextBlock Text="{Binding ShortName}" FontFamily="Consolas" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Node name" Width="*"
                                                        SortMemberPath="LongName"
                                                        ClipboardContentBinding="{Binding LongName}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <emoji:TextBlock Text="{Binding LongName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Status" Width="2*"
                                                    SortMemberPath="NodeStatus"
                                                    Binding="{Binding NodeStatus}" />
                                <DataGridTextColumn Header="Role" Width="Auto"
                                                    SortMemberPath="Role"
                                                    Binding="{Binding Role}" />
                                <DataGridTextColumn Header="Node ID" Width="Auto"
                                                    SortMemberPath="DisplayId"
                                                    Binding="{Binding DisplayId}"
                                                    FontFamily="Consolas" />
                                <DataGridTextColumn Header="Last heard" Width="Auto"
                                                    SortMemberPath="LastHeardEpoch"
                                                    Binding="{Binding LastHeard, StringFormat={}{0:M/d/yyyy h:mm:ss tt}}" />
                                <DataGridTextColumn Header="RSSI" Width="Auto"
                                                    SortMemberPath="RssiDbm"
                                                    Binding="{Binding RssiDbm, StringFormat={}{0:F0} dBm}" />
                                <DataGridTextColumn Header="SNR" Width="Auto"
                                                    SortMemberPath="SnrDb"
                                                    Binding="{Binding SnrDb, StringFormat={}{0:F1}}" />
                                <DataGridTextColumn Width="Auto"
                                                    SortMemberPath="HopsAway"
                                                    Binding="{Binding HopsAway}">
                                    <DataGridTextColumn.Header>
                                        <emoji:TextBlock Text="🐇"
                                                         ToolTip="Hops" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- Right side: spectrum/waterfall (top) over channels/messages/log (bottom). -->
            <Grid x:Name="RightPaneGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <!-- Top-right quarter: spectrum (top) over waterfall (bottom). -->
                <Grid x:Name="SpectrumLayoutGrid" Grid.Row="0" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" MinHeight="50" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="2*" MinHeight="60" />
                </Grid.RowDefinitions>

                <views:SpectrumView x:Name="Spectrum"
                                    Grid.Row="0"
                                    FloorDb="{Binding WaterfallFloorDb}"
                                    CeilDb="{Binding WaterfallCeilDb}" />

                <GridSplitter Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource BrushSplitter}"
                              ShowsPreview="False"
                              ResizeBehavior="PreviousAndNext" />

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                        <RowDefinition x:Name="LastPacketRow" Height="84" MinHeight="64" />
                    </Grid.RowDefinitions>

                    <views:FrequencyAxis Grid.Row="0"
                                         CenterFreqHz="{Binding SpectrumCenterHz}"
                                         SpanHz="{Binding SpectrumSpanHz}"
                                         Foreground="{DynamicResource BrushAppForeground}" />

                    <views:WaterfallView x:Name="Waterfall"
                                         Grid.Row="1"
                                         FloorDb="{Binding WaterfallFloorDb, Mode=TwoWay}"
                                         CeilDb="{Binding WaterfallCeilDb, Mode=TwoWay}"
                                         AutoLevels="{Binding WaterfallAutoLevels, Mode=TwoWay}" />

                    <!-- Frozen spectrogram bar of the most recently detected packet. -->
                    <Border x:Name="LastPacketPanel"
                            Grid.Row="2"
                            Margin="0,2,0,2"
                            Background="#DD101418"
                            BorderBrush="{DynamicResource BrushPanelBorder}"
                            BorderThickness="1">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top"
                                       Cursor="Hand"
                                       Background="Transparent"
                                       MouseLeftButtonUp="OnLastPacketToggle">
                                <TextBlock x:Name="LastPacketToggleIcon"
                                           DockPanel.Dock="Right"
                                           Margin="4,0,4,0"
                                           Text="&#x25BC;"
                                           Foreground="#888888"
                                           FontSize="8"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="LastPacketTitle"
                                           Margin="4,2,2,2"
                                           Text="Last packet"
                                           Foreground="#F0F0F0"
                                           FontWeight="SemiBold" FontSize="11"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <views:WaterfallView x:Name="LastPacket"
                                                 AutoLevels="True"
                                                 SmoothPixels="True"
                                                 TimeHorizontal="True"
                                                 ScaleToFit="True"
                                                 Margin="2" />
                        </DockPanel>
                    </Border>

                    </Grid>
                </Grid>

                    <GridSplitter Grid.Row="1"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource BrushSplitter}"
                                  ShowsPreview="False"
                                  ResizeBehavior="PreviousAndNext" />

                    <!-- Bottom-right quarter: channels / chats + log. -->
                    <DockPanel Grid.Row="2" Margin="4">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,2">
                        <Button DockPanel.Dock="Right"
                                Width="22" Height="22"
                                Margin="2,0,0,0"
                                Padding="0"
                                IsEnabled="{Binding CanRemoveSelectedChannel}"
                                Click="OnRemoveChannelClicked"
                                ToolTip="Remove selected channel"
                                Content="&#xE738;"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        <Button DockPanel.Dock="Right"
                                Width="22" Height="22"
                                Padding="0"
                                Command="{Binding AddChannelCommand}"
                                ToolTip="Add a new channel (random PSK)"
                                Content="&#xE710;"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        <TextBlock Text="Channels" FontWeight="SemiBold" Margin="2,0,0,0" />
                    </DockPanel>

                    <Grid x:Name="MessagesLayoutGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="120" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="1*" MinHeight="80" />
                        </Grid.RowDefinitions>

                    <Grid x:Name="MainTabsHost" Grid.Row="0">
                    <TabControl x:Name="MainTabs"
                                ItemsSource="{Binding Tabs}"
                                SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                PreviewMouseLeftButtonUp="MainTabs_PreviewMouseLeftButtonUp"
                                PreviewMouseMove="MainTabs_PreviewMouseMove">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter Property="AllowDrop" Value="True" />
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="MainTabsTab_PreviewMouseLeftButtonDown" />
                                <EventSetter Event="DragOver" Handler="MainTabsTab_DragOver" />
                                <EventSetter Event="DragLeave" Handler="MainTabsTab_DragLeave" />
                                <EventSetter Event="Drop" Handler="MainTabsTab_Drop" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TabNeedsAttention}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="TabItemFlashStoryboard">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1"
                                                                     To="0.55"
                                                                     Duration="0:0:0.35" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="TabItemFlashStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TabControl.ItemContainerStyle>

                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <emoji:TextBlock Text="{Binding TabHeader}" VerticalAlignment="Center">
                                        <emoji:TextBlock.Style>
                                            <Style TargetType="emoji:TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TabNeedsAttention}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="TabFlashStoryboard">
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="1"
                                                                                     To="0.35"
                                                                                     Duration="0:0:0.45" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="TabFlashStoryboard" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </emoji:TextBlock.Style>
                                    </emoji:TextBlock>
                                    <Button Content="&#xE711;"
                                            FontFamily="Segoe MDL2 Assets" FontSize="9"
                                            Margin="6,0,-4,0" Padding="3,0"
                                            BorderThickness="0" Background="Transparent"
                                            ToolTip="Close conversation"
                                            Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.CloseTabCommand,
                                                      RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>

                        <TabControl.Resources>
                            <DataTemplate DataType="{x:Type vm:ChannelViewModel}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="60" />
                                    </Grid.RowDefinitions>



                                    <DockPanel Grid.Row="1" Margin="4">
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2" LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Content="Clear" Padding="6,1"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Clear this channel's messages (cannot be undone)"
                                                    Command="{Binding DataContext.ClearChannelMessagesCommand,
                                                              RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="Copy" Padding="6,1"
                                                    Command="{Binding CopyMessagesCommand}" />
                                            <Button DockPanel.Dock="Right" Content="Settings"
                                                    Padding="6,1" Margin="4,0,4,0"
                                                    ToolTip="Configure channel name, role, PSK, location sharing and mute"
                                                    Click="OnOpenChannelSettings" />
                                            <ToggleButton DockPanel.Dock="Right"
                                                    Content="Auto-scroll"
                                                    Margin="4,0,0,0"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                                                    ToolTip="Automatically follow new messages in this channel" />
                                            <TextBlock Text="Messages" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <!-- Compose bar: visible only when the active device can transmit (HackRF). -->
                                        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" LastChildFill="True"
                                                   Visibility="{Binding DataContext.CanTransmit,
                                                                RelativeSource={RelativeSource AncestorType=TabControl},
                                                                Converter={StaticResource BoolToVis}}">
                                            <StackPanel DockPanel.Dock="Left"
                                                Orientation="Horizontal"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding DataContext.HasPendingReply,
                                                         RelativeSource={RelativeSource AncestorType=TabControl},
                                                         Converter={StaticResource BoolToVis}}">
                                            <TextBlock VerticalAlignment="Center"
                                                   Foreground="{DynamicResource BrushSubtle}"
                                                   Text="{Binding DataContext.PendingReplyContext,
                                                          RelativeSource={RelativeSource AncestorType=TabControl}}" />
                                            <Button Content="Clear"
                                                Margin="6,0,0,0"
                                                Padding="6,1"
                                                Command="{Binding DataContext.ClearPendingReplyCommand,
                                                          RelativeSource={RelativeSource AncestorType=TabControl}}" />
                                            </StackPanel>
                                            <Button DockPanel.Dock="Right" Content="Send" Padding="14,4"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Encode and transmit a text message on this channel"
                                                    Command="{Binding DataContext.SendMessageCommand,
                                                              RelativeSource={RelativeSource AncestorType=TabControl}}" />
                                                <Button DockPanel.Dock="Right"
                                                    Padding="8,4"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Insert emoji into this message"
                                                    Command="{Binding DataContext.InsertComposeEmojiCommand,
                                                        RelativeSource={RelativeSource AncestorType=TabControl}}">
                                                  <emoji:TextBlock Text="😀" />
                                                </Button>
                                              <TextBox VerticalContentAlignment="Center"
                                                    FontFamily="Segoe UI, Segoe UI Emoji"
                                                     ToolTip="Type a message and press Enter or Send (HackRF only)"
                                                     Text="{Binding DataContext.ComposeText,
                                                            RelativeSource={RelativeSource AncestorType=TabControl},
                                                            Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter"
                                                                Command="{Binding DataContext.SendMessageCommand,
                                                                          RelativeSource={RelativeSource AncestorType=TabControl}}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </DockPanel>
                                        <ListBox ItemsSource="{Binding Messages}"
                                                 FontFamily="Consolas"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.ScrollUnit="Pixel"
                                                 Grid.IsSharedSizeScope="True"
                                                 beh:AutoScroll.IsEnabled="{Binding AutoScroll}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}">
                                                        <Grid.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Reply"
                                                                          Command="{Binding PlacementTarget.Tag.ReplyToMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="React..."
                                                                          Command="{Binding PlacementTarget.Tag.SendReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE11D;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="12" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Grid.ContextMenu>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="NodeName" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="ChannelMessageTimeText" Grid.Column="0" Text="{Binding TimePrefix}" />
                                                        <emoji:TextBlock x:Name="ChannelMessageFromText" Grid.Column="1" Margin="6,0" Text="{Binding FromId}"
                                                                         ToolTip="{Binding FromId}" />
                                                        <StackPanel Grid.Column="2" Margin="0,0,0,2">
                                                            <RichTextBox x:Name="ChannelMessageBodyText"
                                                                         beh:MarkdownText.Text="{Binding TextWithStatus}"
                                                                         Background="Transparent"
                                                                         BorderThickness="0"
                                                                         Padding="0"
                                                                         Margin="0"
                                                                         IsReadOnly="True"
                                                                         IsDocumentEnabled="True"
                                                                         IsTabStop="False"
                                                                         HorizontalScrollBarVisibility="Disabled"
                                                                         VerticalScrollBarVisibility="Disabled"
                                                                         Hyperlink.RequestNavigate="OnMessageHyperlinkNavigate"
                                                                         TextElement.FontFamily="Consolas" />
                                                            <ItemsControl ItemsSource="{Binding Reactions}"
                                                                          Margin="0,3,0,0"
                                                                          Visibility="{Binding HasReactions, Converter={StaticResource BoolToVis}}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Margin="0,0,4,0"
                                                                                Padding="6,1"
                                                                                CornerRadius="8"
                                                                                Background="{DynamicResource BrushPanelBackground}"
                                                                                BorderBrush="{DynamicResource BrushPanelBorder}"
                                                                                BorderThickness="1"
                                                                                ToolTip="{Binding Reactors}">
                                                                            <emoji:TextBlock Text="{Binding Display}" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsIgnoredSender}" Value="True">
                                                            <Setter TargetName="ChannelMessageTimeText" Property="Foreground" Value="#E53935" />
                                                            <Setter TargetName="ChannelMessageFromText" Property="Foreground" Value="#E53935" />
                                                            <Setter TargetName="ChannelMessageBodyText" Property="Foreground" Value="#E53935" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type vm:ConversationViewModel}">
                                <DockPanel Margin="4">
                                    <Border DockPanel.Dock="Top" Padding="6,4" Margin="0,0,0,4"
                                            Background="{DynamicResource BrushPanelBackground}"
                                            BorderBrush="{DynamicResource BrushPanelBorder}"
                                            BorderThickness="1">
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Content="Clear" Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Clear this conversation (cannot be undone)"
                                                    Command="{Binding DataContext.ClearConversationMessagesCommand,
                                                              RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="Copy" Padding="6,1"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Copy this conversation to the clipboard"
                                                    Command="{Binding CopyMessagesCommand}" />
                                                <ToggleButton DockPanel.Dock="Right"
                                                    Content="Auto-scroll"
                                                    Margin="4,0,0,0"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                                                    ToolTip="Automatically follow new messages in this conversation" />
                                                <ToggleButton DockPanel.Dock="Right"
                                                      Content="Mute Ringtone"
                                                      Margin="4,0,0,0"
                                                      Padding="6,1"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding MuteRtttl, Mode=TwoWay}"
                                                      ToolTip="Mute RTTTL ringtone for text messages from this node" />
                                            <StackPanel>
                                                <emoji:TextBlock FontWeight="SemiBold"
                                                                 Text="{Binding PeerName}" />
                                                <emoji:TextBlock Foreground="{DynamicResource BrushSubtle}"
                                                                 FontFamily="Consolas"
                                                                 Text="{Binding PeerId}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                     <!-- Compose bar: visible only when the active device can transmit (HackRF). -->
                                     <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" LastChildFill="True"
                                              Visibility="{Binding DataContext.CanTransmit,
                                                        RelativeSource={RelativeSource AncestorType=TabControl},
                                                        Converter={StaticResource BoolToVis}}">
                                        <StackPanel DockPanel.Dock="Left"
                                                Orientation="Horizontal"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding DataContext.HasPendingReply,
                                                     RelativeSource={RelativeSource AncestorType=TabControl},
                                                     Converter={StaticResource BoolToVis}}">
                                            <TextBlock VerticalAlignment="Center"
                                                   Foreground="{DynamicResource BrushSubtle}"
                                                   Text="{Binding DataContext.PendingReplyContext,
                                                          RelativeSource={RelativeSource AncestorType=TabControl}}" />
                                            <Button Content="Clear"
                                                Margin="6,0,0,0"
                                                Padding="6,1"
                                                Command="{Binding DataContext.ClearPendingReplyCommand,
                                                          RelativeSource={RelativeSource AncestorType=TabControl}}" />
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right" Content="Send" Padding="14,4"
                                                Margin="4,0,0,0"
                                                ToolTip="Encode and transmit a direct message to this node"
                                                Command="{Binding DataContext.SendDirectMessageCommand,
                                                          RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right"
                                              Padding="8,4"
                                              Margin="4,0,0,0"
                                              ToolTip="Insert emoji into this message"
                                              Command="{Binding DataContext.InsertConversationEmojiCommand,
                                                  RelativeSource={RelativeSource AncestorType=TabControl}}"
                                              CommandParameter="{Binding}">
                                              <emoji:TextBlock Text="😀" />
                                            </Button>
                                                 <TextBox VerticalContentAlignment="Center"
                                                    FontFamily="Segoe UI, Segoe UI Emoji"
                                                 ToolTip="Type a direct message and press Enter or Send"
                                                 Text="{Binding ComposeText,
                                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter"
                                                            Command="{Binding DataContext.SendDirectMessageCommand,
                                                                      RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                            CommandParameter="{Binding}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>
                                    <!-- Messages (left) + resizable telemetry panel (right). -->
                                    <Grid x:Name="ConversationLayoutGrid"
                                          Loaded="ConversationLayoutGrid_Loaded">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="220" MinWidth="120" />
                                        </Grid.ColumnDefinitions>

                                        <ListBox Grid.Column="0"
                                                 ItemsSource="{Binding Messages}"
                                                 FontFamily="Consolas"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.ScrollUnit="Pixel"
                                                 Grid.IsSharedSizeScope="True"
                                                 beh:AutoScroll.IsEnabled="{Binding AutoScroll}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}">
                                                        <Grid.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Reply"
                                                                          Command="{Binding PlacementTarget.Tag.ReplyToMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="React..."
                                                                          Command="{Binding PlacementTarget.Tag.SendReactionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE11D;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="12" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Grid.ContextMenu>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="NodeName" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="ConversationMessageTimeText" Grid.Column="0" Text="{Binding TimePrefix}" />
                                                        <emoji:TextBlock x:Name="ConversationMessageFromText" Grid.Column="1" Margin="6,0" Text="{Binding FromId}"
                                                                         ToolTip="{Binding FromId}" />
                                                        <StackPanel Grid.Column="2" Margin="0,0,0,2">
                                                            <RichTextBox x:Name="ConversationMessageBodyText"
                                                                         beh:MarkdownText.Text="{Binding TextWithStatus}"
                                                                         Background="Transparent"
                                                                         BorderThickness="0"
                                                                         Padding="0"
                                                                         Margin="0"
                                                                         IsReadOnly="True"
                                                                         IsDocumentEnabled="True"
                                                                         IsTabStop="False"
                                                                         HorizontalScrollBarVisibility="Disabled"
                                                                         VerticalScrollBarVisibility="Disabled"
                                                                         Hyperlink.RequestNavigate="OnMessageHyperlinkNavigate"
                                                                         TextElement.FontFamily="Consolas" />
                                                            <ItemsControl ItemsSource="{Binding Reactions}"
                                                                          Margin="0,3,0,0"
                                                                          Visibility="{Binding HasReactions, Converter={StaticResource BoolToVis}}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Margin="0,0,4,0"
                                                                                Padding="6,1"
                                                                                CornerRadius="8"
                                                                                Background="{DynamicResource BrushPanelBackground}"
                                                                                BorderBrush="{DynamicResource BrushPanelBorder}"
                                                                                BorderThickness="1"
                                                                                ToolTip="{Binding Reactors}">
                                                                            <emoji:TextBlock Text="{Binding Display}" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsIgnoredSender}" Value="True">
                                                            <Setter TargetName="ConversationMessageTimeText" Property="Foreground" Value="#E53935" />
                                                            <Setter TargetName="ConversationMessageFromText" Property="Foreground" Value="#E53935" />
                                                            <Setter TargetName="ConversationMessageBodyText" Property="Foreground" Value="#E53935" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <GridSplitter Grid.Column="1" Width="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Stretch"
                                                      Background="{DynamicResource BrushSplitter}"
                                                      DragCompleted="ConversationMainSplitter_DragCompleted"
                                                      ShowsPreview="False"
                                                      ResizeBehavior="PreviousAndNext" />

                                        <!-- Telemetry panel for the peer node. -->
                                        <Border Grid.Column="2" Margin="6,0,0,0"
                                                Padding="8" VerticalAlignment="Stretch"
                                                Background="{DynamicResource BrushPanelBackground}"
                                                BorderBrush="{DynamicResource BrushPanelBorder}"
                                            BorderThickness="1">
                                        <Grid x:Name="ConversationTelemetryGrid">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" MinHeight="80" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
                                                <Button DockPanel.Dock="Right"
                                                        Content="Location history"
                                                        Padding="8,2"
                                                        Margin="6,0,0,0"
                                                        Click="OnOpenLocationHistory" />
                                                <Button DockPanel.Dock="Right"
                                                        Content="Telemetry history"
                                                        Padding="8,2"
                                                        Click="OnOpenTelemetryHistory" />
                                                <TextBlock Text="Node Information"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>

                                            <ScrollViewer Grid.Row="1"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel>
                                                    <TextBlock Foreground="{DynamicResource BrushSubtle}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Text="No telemetry received yet.">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasTelemetry}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <ItemsControl ItemsSource="{Binding Telemetry}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" MinWidth="92" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <emoji:TextBlock Grid.Column="0"
                                                                                     Foreground="{DynamicResource BrushSubtle}"
                                                                                     Text="{Binding Label}" />
                                                                    <emoji:TextBlock Grid.Column="1"
                                                                                     FontFamily="Consolas"
                                                                                     TextWrapping="Wrap"
                                                                                     Text="{Binding Value}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                    </Grid>
                                </DockPanel>
                            </DataTemplate>
                        </TabControl.Resources>
                        </TabControl>
                        <Border x:Name="MainTabsDividerOverlay"
                            Width="1"
                            Height="16"
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{DynamicResource BrushPanelBorder}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"
                            Panel.ZIndex="10" />
                        <Border x:Name="MainTabsDragIndicator"
                            Width="2"
                            Height="16"
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{DynamicResource BrushAppForeground}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"
                            Panel.ZIndex="11" />
                        </Grid>

                    <GridSplitter Grid.Row="1"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  Background="{DynamicResource BrushSplitter}"
                                  ShowsPreview="False"
                                  ResizeBehavior="PreviousAndNext" />

                    <DockPanel Grid.Row="2" Margin="0,2,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Clear" Padding="6,1"
                                    Margin="4,0,0,0"
                                    Command="{Binding ClearLogCommand}" />
                            <Button DockPanel.Dock="Right" Content="Copy" Padding="6,1"
                                    Command="{Binding CopyLogCommand}" />
                            <Button DockPanel.Dock="Right" Content="Raw JSON" Padding="6,1"
                                Margin="4,0,4,0"
                                Click="OnOpenRawJsonLog" />
                            <ToggleButton DockPanel.Dock="Right" Content="Auto-scroll"
                                          Padding="6,1" Margin="4,0,0,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding LogAutoScroll, Mode=TwoWay}"
                                          ToolTip="Automatically scroll the log to new entries" />
                            <TextBlock Text="Log" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding LogLines}"
                                 FontFamily="Consolas"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 beh:AutoScroll.IsEnabled="{Binding LogAutoScroll}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <RichTextBox beh:MarkdownText.Text="{Binding}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 Margin="0"
                                                 IsReadOnly="True"
                                                 IsDocumentEnabled="True"
                                                 IsTabStop="False"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 TextElement.FontFamily="Consolas" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- Keep the middle splitter for left/right width. -->
            <GridSplitter Grid.Column="1"
                          Width="5" VerticalAlignment="Stretch" HorizontalAlignment="Center"
                          Background="{DynamicResource BrushSplitter}"
                          ShowsPreview="False" ResizeBehavior="PreviousAndNext" />
        </Grid>
    </DockPanel>
</Window>
