<Window x:Class="MeshRF.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:vm="clr-namespace:MeshRF.App.ViewModels"
        xmlns:views="clr-namespace:MeshRF.App.Views"
        xmlns:conv="clr-namespace:MeshRF.App.Converters"
        xmlns:beh="clr-namespace:MeshRF.App.Behaviors"
        Title="MeshRF"
        Height="1000" Width="1280"
        WindowStartupLocation="Manual"
        MinHeight="480" MinWidth="720">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <conv:PskTextConverter x:Key="PskText" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <ToolBar DockPanel.Dock="Top">
            <TextBlock Text="RX" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Width="150"
                      ItemsSource="{Binding DeviceOptions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                      IsEnabled="{Binding CanSelectDevice}"
                      ToolTip="Receive SDR backend (selectable when stopped)" />
            <TextBlock Text="TX" VerticalAlignment="Center" Margin="8,0,4,0" />
            <ComboBox Width="150"
                      ItemsSource="{Binding TxDeviceOptions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedTxDevice, Mode=TwoWay}"
                      IsEnabled="{Binding CanSelectDevice}"
                      ToolTip="Transmit SDR backend; HackRF can transmit, RTL-SDR cannot" />
            <Separator />
            <TextBlock Text="Region" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Width="90"
                      ItemsSource="{Binding Regions}"
                      SelectedItem="{Binding SelectedRegion, Mode=TwoWay}" />
            <TextBlock Text="Preset" VerticalAlignment="Center" Margin="8,0,4,0" />
            <ComboBox Width="130"
                      ItemsSource="{Binding Presets}"
                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
            <!-- LoRa parameter overrides: auto-filled from preset, manually editable -->
            <TextBlock Text="SF" VerticalAlignment="Center" Margin="8,0,2,0"
                       ToolTip="Spreading factor — auto-filled from preset; edit to override" />
            <TextBox Width="28"
                     Text="{Binding OverrideSf, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     ToolTip="Spreading factor (5–12). Auto-filled from preset; edit to override." />
            <TextBlock Text="BW" VerticalAlignment="Center" Margin="6,0,2,0"
                       ToolTip="Bandwidth in kHz — auto-filled from preset; edit to override" />
            <TextBox Width="52"
                     Text="{Binding OverrideBwKhz, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     ToolTip="Bandwidth in kHz (e.g. 250, 125, 62.5, 15.6). Auto-filled from preset; edit to override." />
            <TextBlock Text="CR" VerticalAlignment="Center" Margin="6,0,2,0"
                       ToolTip="Coding rate denominator — auto-filled from preset; edit to override" />
            <TextBox Width="24"
                     Text="{Binding OverrideCr, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     ToolTip="Coding rate denominator (5–8 → 4/N). Auto-filled from preset; edit to override." />
            <TextBlock Text="Slot" VerticalAlignment="Center" Margin="8,0,4,0" />
            <ComboBox Width="70"
                      ItemsSource="{Binding Slots}"
                      SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                      ToolTip="Meshtastic channel slot (1-indexed)" />
            <TextBlock Text="Freq (MHz)" VerticalAlignment="Center" Margin="8,0,4,0" />
            <TextBox Width="100"
                     Text="{Binding CenterFreqMHz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"
                     ToolTip="Center frequency in MHz (auto-set from slot)" />
            <Separator />
            <Button Width="36" Height="28"
                    Command="{Binding ToggleCommand}"
                    ToolTip="Start / Stop receive">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content">
                            <Setter.Value>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="#1E9F4A"
                                           Text="&#xE768;" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="#C62828"
                                                   Text="&#xE71A;" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Width="36" Height="28"
                    Margin="4,0,0,0"
                    Command="{Binding ToggleCaptureCommand}"
                    ToolTip="Start / stop raw IQ capture (.cf32) of the modem input">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content">
                            <Setter.Value>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Text="&#xE7C8;" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="#C62828"
                                                   Text="&#xE7C8;" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Width="36" Height="28"
                    Margin="4,0,0,0"
                    Command="{Binding ToggleRecordPayloadsCommand}"
                    ToolTip="Start / stop recording decoded payloads (.jsonl)">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content">
                            <Setter.Value>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Text="&#xE74E;" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecordingPayloads}" Value="True">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="#C62828"
                                                   Text="&#xE74E;" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding Status}" />
        </ToolBar>

        <ToolBar DockPanel.Dock="Top"
                 Visibility="{Binding IsHackRf, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="LNA" VerticalAlignment="Center" Margin="0,0,4,0"
                       ToolTip="HackRF LNA gain (RF-stage), 0..40 dB step 8" />
            <Slider Width="160"
                    Minimum="0" Maximum="40"
                    TickFrequency="8" IsSnapToTickEnabled="True"
                    SmallChange="8" LargeChange="8"
                    Value="{Binding LnaGainDb, Mode=TwoWay}"
                    VerticalAlignment="Center" />
            <TextBlock Width="32" VerticalAlignment="Center"
                       Text="{Binding LnaGainDb, StringFormat={}{0} dB}" />

            <TextBlock Text="VGA" VerticalAlignment="Center" Margin="8,0,4,0"
                       ToolTip="HackRF baseband VGA gain, 0..62 dB step 2" />
            <Slider Width="200"
                    Minimum="0" Maximum="62"
                    TickFrequency="2" IsSnapToTickEnabled="True"
                    SmallChange="2" LargeChange="2"
                    Value="{Binding VgaGainDb, Mode=TwoWay}"
                    VerticalAlignment="Center" />
            <TextBlock Width="32" VerticalAlignment="Center"
                       Text="{Binding VgaGainDb, StringFormat={}{0} dB}" />

            <Separator />
            <CheckBox Content="AMP (+14 dB)"
                      IsChecked="{Binding AmpEnable, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      ToolTip="Enable HackRF front-end RF amplifier" />
            <Separator />
            <CheckBox Content="AGC"
                      IsChecked="{Binding AgcEnable, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      ToolTip="Auto-Gain-Control: keep peak power near target by nudging LNA/VGA" />
            <TextBlock Text="target" VerticalAlignment="Center" Margin="6,0,4,0" />
            <Slider Width="120"
                    Minimum="-40" Maximum="-3"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding AgcTargetDbfs, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding AgcEnable}" />
            <TextBlock Width="48" VerticalAlignment="Center"
                       Text="{Binding AgcTargetDbfs, StringFormat={}{0:F0} dBFS}" />
        </ToolBar>

        <ToolBar DockPanel.Dock="Top"
                 Visibility="{Binding IsRtlSdr, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Gain" VerticalAlignment="Center" Margin="0,0,4,0"
                       ToolTip="RTL-SDR manual tuner gain, 0..49 dB" />
            <Slider Width="220"
                    Minimum="0" Maximum="49"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    SmallChange="1" LargeChange="5"
                    Value="{Binding RtlGainDb, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding AmpEnable, Converter={StaticResource InverseBool}}" />
            <TextBlock Width="40" VerticalAlignment="Center"
                       Text="{Binding RtlGainDb, StringFormat={}{0} dB}" />

            <Separator />
            <CheckBox Content="AGC"
                      IsChecked="{Binding AmpEnable, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      ToolTip="Tuner automatic gain control (overrides the manual gain slider)" />
            <Separator />
            <CheckBox Content="Bias-T"
                      IsChecked="{Binding BiasTee, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      ToolTip="Enable 5 V bias-T on the antenna port to power an external LNA/active antenna" />
        </ToolBar>

        <ToolBar DockPanel.Dock="Top">
            <CheckBox Content="DC block"
                      IsChecked="{Binding DcBlockEnable, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      ToolTip="IIR high-pass to remove the LO leakage spike at the tuned centre frequency. Leave on for normal use; disable only for diagnostics." />
            <Separator />
            <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Width="90"
                      ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding Theme, Mode=TwoWay}" />

            <Separator />
            <TextBlock Text="Colormap" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Width="90"
                      ItemsSource="{Binding WaterfallColormaps}"
                      SelectedItem="{Binding WaterfallColormap, Mode=TwoWay}" />

            <Separator />
            <CheckBox Content="Auto levels"
                      IsChecked="{Binding WaterfallAutoLevels, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      ToolTip="Track 5th/99th percentile of recent frames" />
            <TextBlock Text="floor" VerticalAlignment="Center" Margin="6,0,4,0" />
            <Slider Width="140"
                    Minimum="-140" Maximum="0"
                    TickFrequency="5" IsSnapToTickEnabled="False"
                    Value="{Binding WaterfallFloorDb, Mode=TwoWay}"
                    VerticalAlignment="Center" />
            <TextBlock Width="48" VerticalAlignment="Center"
                       Text="{Binding WaterfallFloorDb, StringFormat={}{0:F0} dB}" />
            <TextBlock Text="ceil" VerticalAlignment="Center" Margin="6,0,4,0" />
            <Slider Width="140"
                    Minimum="-100" Maximum="20"
                    TickFrequency="5" IsSnapToTickEnabled="False"
                    Value="{Binding WaterfallCeilDb, Mode=TwoWay}"
                    VerticalAlignment="Center" />
            <TextBlock Width="48" VerticalAlignment="Center"
                       Text="{Binding WaterfallCeilDb, StringFormat={}{0:F0} dB}" />
            <Separator />
            <Button Width="32" Height="28"
                    Click="OnAboutClick"
                    ToolTip="About MeshRF">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE946;" />
            </Button>
        </ToolBar>

        <ToolBar DockPanel.Dock="Top">
            <TextBlock Text="Ringtone" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Width="100"
                      ItemsSource="{Binding RingtoneModes}"
                      SelectedItem="{Binding RingtoneMode, Mode=TwoWay}"
                      ToolTip="How long the alert tone plays when a text message arrives" />

            <Separator />
            <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Slider Width="120"
                    Minimum="0" Maximum="100"
                    TickFrequency="5" IsSnapToTickEnabled="False"
                    Value="{Binding RingtoneVolume, Mode=TwoWay}"
                    VerticalAlignment="Center" />
            <TextBlock Width="36" VerticalAlignment="Center"
                       Text="{Binding RingtoneVolume, StringFormat={}{0:F0}%}" />

            <Separator />
            <TextBlock Text="RTTTL" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Width="260"
                     Text="{Binding RingtoneRtttl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center"
                     ToolTip="Ringtone in Meshtastic RTTTL format" />
                <Button Content="Preview" Margin="4,0,0,0"
                    Command="{Binding TestRingtoneCommand}"
                    ToolTip="Preview the current ringtone" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="RSSI: " />
                    <Run Text="{Binding RssiDbfs, StringFormat=F1, Mode=OneWay}" />
                    <Run Text=" dBFS  Peak: " />
                    <Run Text="{Binding PeakDbfs, StringFormat=F1, Mode=OneWay}" />
                    <Run Text=" dBFS  Samples: " />
                    <Run Text="{Binding TotalSamples, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding DeviceBadge}"
                           ToolTip="{Binding DeviceStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#888" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRealRadio}" Value="True">
                                    <Setter Property="Foreground" Value="#1E9F4A" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <Grid x:Name="MainLayoutGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Left side: map (top) over nodes/identity (bottom). -->
            <Grid x:Name="LeftPaneGrid" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <views:MapView Grid.Row="0" x:Name="Map" Margin="4" />

                <GridSplitter Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="{DynamicResource BrushSplitter}"
                              ShowsPreview="False"
                              ResizeBehavior="PreviousAndNext" />

                <!-- Bottom-left quarter: node list + identity. -->
                <DockPanel Grid.Row="2" Margin="4">
                    <Expander x:Name="IdentityExpander" DockPanel.Dock="Top" Header="My node (identity)"
                              IsExpanded="False" Margin="0,0,0,4">
                        <Border Padding="8"
                                Background="{DynamicResource BrushPanelBackground}"
                                BorderBrush="{DynamicResource BrushPanelBorder}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Node ID"
                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,4,0,4">
                                    <Button DockPanel.Dock="Right" Content="Random"
                                            Margin="6,0,0,0" Padding="8,2"
                                            Command="{Binding GenerateRandomNodeIdCommand}"
                                            ToolTip="Generate a random node ID" />
                                    <TextBox FontFamily="Consolas"
                                             ToolTip="!a1b2c3d4, 0xA1B2C3D4 or decimal"
                                             Text="{Binding MyNodeIdText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="MAC address"
                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,4"
                                         FontFamily="Consolas"
                                         IsReadOnly="True"
                                         Foreground="{DynamicResource BrushSecondaryText}"
                                         ToolTip="Derived from node ID (02:00 + last 4 bytes). Set the node ID to change this."
                                         Text="{Binding MyMacAddress, Mode=OneWay}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Long name"
                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,4"
                                         Text="{Binding MyLongName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Short name"
                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,4"
                                         MaxLength="4"
                                         Text="{Binding MyShortName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Role"
                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4,0,4"
                                          HorizontalAlignment="Left" Width="160"
                                          ItemsSource="{Binding NodeRoleOptions}"
                                          SelectedItem="{Binding MyRole, Mode=TwoWay}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Hardware"
                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,4,0,4"
                                          HorizontalAlignment="Left" Width="200"
                                          ItemsSource="{Binding HwModelOptions}"
                                          SelectedItem="{Binding MyHwModel, Mode=TwoWay}"
                                          ToolTip="Hardware model (for when TX is added)" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Rebroadcast"
                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,4,0,4"
                                          HorizontalAlignment="Left" Width="200"
                                          ItemsSource="{Binding RebroadcastModeOptions}"
                                          SelectedItem="{Binding RebroadcastMode, Mode=TwoWay}"
                                          ToolTip="Rebroadcast mode (used once TX is enabled)" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Public key"
                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                <DockPanel Grid.Row="7" Grid.Column="1" Margin="0,4,0,4">
                                    <Button DockPanel.Dock="Right" Content="Generate"
                                            Margin="6,0,0,0" Padding="8,2"
                                            Command="{Binding GenerateKeyPairCommand}"
                                            ToolTip="Generate a new private key" />
                                    <TextBox FontFamily="Consolas"
                                             ToolTip="Base64 X25519 public key (TX/PKI)"
                                             Text="{Binding MyPublicKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Private key"
                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                <TextBox Grid.Row="8" Grid.Column="1" Margin="0,4,0,4"
                                         FontFamily="Consolas"
                                         ToolTip="Base64 X25519 private key (kept locally)"
                                         Text="{Binding MyPrivateKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Location source"
                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,4,0,4">
                                    <ComboBox HorizontalAlignment="Left" Width="160"
                                              ItemsSource="{Binding LocationSourceOptions}"
                                              SelectedItem="{Binding SelectedLocationSource, Mode=TwoWay}"
                                              DisplayMemberPath="Label"
                                              ToolTip="Choose between a fixed manual location and an auto-detected USB serial GPS." />
                                    <Grid Margin="0,6,0,0" IsEnabled="{Binding IsUsbSerialLocationSource}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Margin="0,0,4,0"
                                                 FontFamily="Consolas"
                                                 ToolTip="Optional COM port override, for example COM5. Leave blank for auto-detect."
                                                 Text="{Binding GpsPortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" Margin="4,0,0,0"
                                                 FontFamily="Consolas"
                                                 ToolTip="Optional baud override, for example 9600. Leave blank for auto-detect."
                                                 Text="{Binding GpsBaudRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource BrushSecondaryText}"
                                               Text="{Binding GpsStatus}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Home (lat, lon, alt m)"
                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                <Grid Grid.Row="10" Grid.Column="1" Margin="0,4,0,4"
                                      IsEnabled="{Binding IsManualLocationSource}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,2,0"
                                             FontFamily="Consolas"
                                             ToolTip="Latitude in degrees (-90..90)"
                                             Text="{Binding HomeLatitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="1" Margin="2,0,2,0"
                                             FontFamily="Consolas"
                                             ToolTip="Longitude in degrees (-180..180)"
                                             Text="{Binding HomeLongitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Margin="2,0,0,0"
                                             FontFamily="Consolas"
                                             ToolTip="Altitude in metres above sea level (optional)"
                                             Text="{Binding HomeAltitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <TextBlock Grid.Row="11" Grid.Column="0" Text="Hop limit"
                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                <DockPanel Grid.Row="11" Grid.Column="1" Margin="0,4,0,4">
                                    <TextBlock DockPanel.Dock="Right" Width="20"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Text="{Binding HopLimit}" />
                                    <Slider Minimum="1" Maximum="7"
                                            TickFrequency="1" TickPlacement="BottomRight"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            Value="{Binding HopLimit, Mode=TwoWay}"
                                            ToolTip="Hops a transmitted packet may travel (1..7). Meshtastic default is 3." />
                                </DockPanel>

                                <TextBlock Grid.Row="12" Grid.Column="0" Text="OK to MQTT"
                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                <CheckBox Grid.Row="12" Grid.Column="1" Margin="0,4,0,4"
                                          VerticalAlignment="Center"
                                          Content="Allow gateways to uplink my packets to public MQTT"
                                          IsChecked="{Binding OkToMqtt, Mode=TwoWay}"
                                          ToolTip="Sets the ok_to_mqtt flag on packets you transmit so MQTT gateways may forward them to the public broker." />
                            </Grid>
                        </Border>
                    </Expander>

                    <TextBlock DockPanel.Dock="Top"
                               Text="Nodes"
                               FontWeight="SemiBold"
                               Margin="2,0,0,2" />

                    <!-- Node list filter bar -->
                    <Border DockPanel.Dock="Top"
                            Margin="0,0,0,3" Padding="4,3"
                            Background="{DynamicResource BrushPanelBackground}"
                            BorderBrush="{DynamicResource BrushPanelBorder}"
                            BorderThickness="1">
                        <StackPanel>
                            <!-- Row 1: text search + dropdowns + clear -->
                            <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                <Button DockPanel.Dock="Right"
                                        Content="&#xE711;"
                                        FontFamily="Segoe MDL2 Assets" FontSize="10"
                                        Width="22" Height="22" Padding="0"
                                        Margin="3,0,0,0"
                                        Command="{Binding ClearNodeFiltersCommand}"
                                        ToolTip="Clear all filters" />
                                <ComboBox DockPanel.Dock="Right" Width="100" Height="22" Margin="3,0,0,0"
                                          FontSize="11"
                                          ItemsSource="{Binding NodeIgnoredFilterOptions}"
                                          SelectedItem="{Binding NodeIgnoredFilter, Mode=TwoWay}"
                                          ToolTip="Ignored nodes" />
                                <ComboBox DockPanel.Dock="Right" Width="100" Height="22" Margin="3,0,0,0"
                                          FontSize="11"
                                          ItemsSource="{Binding NodeLocationFilterOptions}"
                                          SelectedItem="{Binding NodeLocationFilter, Mode=TwoWay}"
                                          ToolTip="Position filter" />
                                <ComboBox DockPanel.Dock="Right" Width="90" Height="22" Margin="3,0,0,0"
                                          FontSize="11"
                                          ItemsSource="{Binding NodeKeyFilterOptions}"
                                          SelectedItem="{Binding NodeKeyFilter, Mode=TwoWay}"
                                          ToolTip="Key filter" />
                                <ComboBox DockPanel.Dock="Right" Width="80" Height="22" Margin="3,0,0,0"
                                          FontSize="11"
                                          ItemsSource="{Binding NodeHopsFilterOptions}"
                                          SelectedItem="{Binding NodeHopsFilter, Mode=TwoWay}"
                                          ToolTip="Hops filter" />
                                <TextBox Height="22" FontSize="11"
                                         Text="{Binding NodeSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search by name, short name, or node ID" />
                            </DockPanel>
                            <!-- Row 2: heard-within + distance -->
                            <DockPanel LastChildFill="False">
                                <TextBlock VerticalAlignment="Center" FontSize="11" Margin="0,0,3,0" Text="Heard within:" />
                                <TextBox Width="40" Height="22" FontSize="11" Margin="0,0,2,0"
                                         Text="{Binding NodeMaxAgeMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Show only nodes heard within the last N minutes (blank = any)" />
                                <TextBlock VerticalAlignment="Center" FontSize="11" Margin="0,0,12,0" Text="min" />
                                <TextBlock VerticalAlignment="Center" FontSize="11" Margin="0,0,3,0" Text="Max dist:"
                                           Opacity="{Binding HasHomeLocation, Converter={StaticResource BoolToOpacity}}" />
                                <TextBox Width="48" Height="22" FontSize="11" Margin="0,0,2,0"
                                         IsEnabled="{Binding HasHomeLocation}"
                                         Text="{Binding NodeDistanceKmText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Max distance from home location in km (blank = any; requires home to be set)" />
                                <TextBlock VerticalAlignment="Center" FontSize="11" Text="km"
                                           Opacity="{Binding HasHomeLocation, Converter={StaticResource BoolToOpacity}}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="140" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="2*" MinHeight="120" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Waypoints"
                                       FontWeight="SemiBold"
                                       Margin="2,6,0,2" />

                            <DataGrid x:Name="WaypointsGrid"
                                      ItemsSource="{Binding Waypoints}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserSortColumns="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Extended"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      KeyDown="WaypointsGrid_KeyDown">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                <Setter Property="Foreground" Value="#F57C00" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Delete"
                                                  Click="OnDeleteWaypoints"
                                                  InputGestureText="Del">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE74D;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Icon" Width="42"
                                                        SortMemberPath="Icon"
                                                        Binding="{Binding IconText}" />
                                    <DataGridTextColumn Header="Name" Width="2*"
                                                        SortMemberPath="Name"
                                                        Binding="{Binding DisplayName}" />
                                    <DataGridTextColumn Header="From" Width="96"
                                                        SortMemberPath="FromNode"
                                                        Binding="{Binding FromId}"
                                                        FontFamily="Consolas" />
                                    <DataGridTextColumn Header="Lat" Width="88"
                                                        SortMemberPath="Latitude"
                                                        Binding="{Binding Latitude, StringFormat={}{0:F5}}"
                                                        FontFamily="Consolas" />
                                    <DataGridTextColumn Header="Lon" Width="88"
                                                        SortMemberPath="Longitude"
                                                        Binding="{Binding Longitude, StringFormat={}{0:F5}}"
                                                        FontFamily="Consolas" />
                                    <DataGridTextColumn Header="Status" Width="74"
                                                        SortMemberPath="IsExpired"
                                                        Binding="{Binding ExpiryStatus}" />
                                    <DataGridTextColumn Header="Expires" Width="132"
                                                        SortMemberPath="ExpireEpoch"
                                                        Binding="{Binding ExpireTime, StringFormat=g}" />
                                    <DataGridTextColumn Header="Heard" Width="72"
                                                        SortMemberPath="RxEpoch"
                                                        Binding="{Binding RxTime, StringFormat=HH:mm:ss}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <GridSplitter Grid.Row="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Height="6"
                                      ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext"
                                      Background="{DynamicResource BrushSplitter}"
                                      ShowsPreview="True" />

                        <DataGrid x:Name="NodesGrid"
                                  Grid.Row="0"
                                  ItemsSource="{Binding NodesView}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Extended"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  MouseDoubleClick="NodesGrid_MouseDoubleClick"
                                  KeyDown="NodesGrid_KeyDown">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Ignored}" Value="True">
                                            <Setter Property="Foreground" Value="#E57373" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Ignored}" Value="True">
                                            <Setter Property="Foreground" Value="#E57373" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.ContextMenu>
                                <ContextMenu Opened="OnNodesContextMenuOpened"
                                             Closed="OnNodesContextMenuClosed">
                                    <MenuItem Header="Request node info"
                                              Click="OnRequestNodeInfo">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE968;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Exchange node info"
                                              Click="OnExchangeNodeInfo">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE8BD;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Request location"
                                              Click="OnRequestPosition">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE707;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Exchange location"
                                              Click="OnExchangeLocation">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE707;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Traceroute"
                                              Click="OnTraceroute">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE968;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Request new keys"
                                              Click="OnRequestKeys">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE192;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="ToggleNodeIgnoredMenuItem"
                                              Header="Ignore node"
                                              Click="OnToggleNodeIgnored">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE767;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="CopyNodesMenuItem"
                                              Header="Copy"
                                              Click="OnCopyNodes"
                                              InputGestureText="Ctrl+C">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE8C8;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Delete"
                                              Click="OnDeleteNodes"
                                              InputGestureText="Del">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="Auto"
                                                        SortMemberPath="HasPublicKey"
                                                        CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="&#xE192;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding HasPublicKey, Converter={StaticResource BoolToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="Has encryption key (PKC direct messages enabled)" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasKeyMismatch}" Value="True">
                                                                <Setter Property="Foreground" Value="#E53935" />
                                                                <Setter Property="ToolTip" Value="Key mismatch — this node's public key changed. Right-click → Request new keys to accept it." />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="Auto"
                                                        SortMemberPath="HasLocation"
                                                        CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="&#xE707;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="Has position" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasInvalidLocation}" Value="True">
                                                                <Setter Property="Foreground" Value="#E53935" />
                                                                <Setter Property="ToolTip" Value="Invalid position (0,0 or out of bounds)" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Short" Width="Auto"
                                                        SortMemberPath="ShortName"
                                                        ClipboardContentBinding="{Binding ShortName}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <emoji:TextBlock Text="{Binding ShortName}" FontFamily="Consolas" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Node name" Width="*"
                                                        SortMemberPath="LongName"
                                                        ClipboardContentBinding="{Binding LongName}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <emoji:TextBlock Text="{Binding LongName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Role" Width="Auto"
                                                    SortMemberPath="Role"
                                                    Binding="{Binding Role}" />
                                <DataGridTextColumn Header="Node ID" Width="Auto"
                                                    SortMemberPath="DisplayId"
                                                    Binding="{Binding DisplayId}"
                                                    FontFamily="Consolas" />
                                <DataGridTextColumn Header="Last heard" Width="Auto"
                                                    SortMemberPath="LastHeardEpoch"
                                                    Binding="{Binding LastHeard, StringFormat=HH:mm:ss}" />
                                <DataGridTextColumn Header="RSSI" Width="Auto"
                                                    SortMemberPath="RssiDbm"
                                                    Binding="{Binding RssiDbm, StringFormat={}{0:F0} dBm}" />
                                <DataGridTextColumn Header="SNR" Width="Auto"
                                                    SortMemberPath="SnrDb"
                                                    Binding="{Binding SnrDb, StringFormat={}{0:F1}}" />
                                <DataGridTextColumn Header="Hops" Width="Auto"
                                                    SortMemberPath="HopsAway"
                                                    Binding="{Binding HopsAway}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- Right side: spectrum/waterfall (top) over channels/messages/log (bottom). -->
            <Grid x:Name="RightPaneGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <!-- Top-right quarter: spectrum (top) over waterfall (bottom). -->
                <Grid x:Name="SpectrumLayoutGrid" Grid.Row="0" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" MinHeight="50" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="2*" MinHeight="60" />
                </Grid.RowDefinitions>

                <views:SpectrumView x:Name="Spectrum"
                                    Grid.Row="0"
                                    FloorDb="{Binding WaterfallFloorDb}"
                                    CeilDb="{Binding WaterfallCeilDb}" />

                <GridSplitter Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource BrushSplitter}"
                              ShowsPreview="False"
                              ResizeBehavior="PreviousAndNext" />

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>

                    <views:WaterfallView x:Name="Waterfall"
                                         Grid.Row="0"
                                         FloorDb="{Binding WaterfallFloorDb, Mode=TwoWay}"
                                         CeilDb="{Binding WaterfallCeilDb, Mode=TwoWay}"
                                         AutoLevels="{Binding WaterfallAutoLevels, Mode=TwoWay}" />

                    <!-- Frozen spectrogram of the most recently detected packet.
                         Hidden until the first packet is captured. -->
                    <Border x:Name="LastPacketPanel"
                            Grid.Row="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="540" Height="170"
                            Margin="0,6,6,0"
                            Background="#DD101418"
                            BorderBrush="{DynamicResource BrushPanelBorder}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Thumb Grid.Column="0"
                                   HorizontalAlignment="Stretch"
                                   Cursor="SizeWE"
                                   Background="#20FFFFFF"
                                   DragDelta="OnLastPacketResizeDelta"
                                   ToolTip="Drag to resize" />

                            <DockPanel Grid.Column="1">
                                <DockPanel DockPanel.Dock="Top" Margin="4,2,2,2">
                                    <Button DockPanel.Dock="Right"
                                            Width="18" Height="18" Padding="0"
                                            Click="OnCloseLastPacket"
                                            ToolTip="Hide"
                                            Content="&#xE711;"
                                            FontFamily="Segoe MDL2 Assets" FontSize="9" />
                                    <TextBlock x:Name="LastPacketTitle"
                                               Text="Last packet"
                                               Foreground="#F0F0F0"
                                               FontWeight="SemiBold" FontSize="11"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <views:WaterfallView x:Name="LastPacket"
                                                     AutoLevels="True"
                                                     SmoothPixels="False"
                                                     TimeHorizontal="True"
                                                     Margin="2" />
                            </DockPanel>
                        </Grid>
                    </Border>

                    <views:FrequencyAxis Grid.Row="1"
                                         CenterFreqHz="{Binding SpectrumCenterHz}"
                                         SpanHz="{Binding SpectrumSpanHz}"
                                         Foreground="{DynamicResource BrushAppForeground}" />
                    </Grid>
                </Grid>

                    <GridSplitter Grid.Row="1"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource BrushSplitter}"
                                  ShowsPreview="False"
                                  ResizeBehavior="PreviousAndNext" />

                    <!-- Bottom-right quarter: channels / chats + log. -->
                    <DockPanel Grid.Row="2" Margin="4">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,2">
                        <Button DockPanel.Dock="Right"
                                Width="22" Height="22"
                                Margin="2,0,0,0"
                                Padding="0"
                                Command="{Binding RemoveSelectedChannelCommand}"
                                ToolTip="Remove selected channel"
                                Content="&#xE738;"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        <Button DockPanel.Dock="Right"
                                Width="22" Height="22"
                                Padding="0"
                                Command="{Binding AddChannelCommand}"
                                ToolTip="Add a new channel (random PSK)"
                                Content="&#xE710;"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        <TextBlock Text="Channels" FontWeight="SemiBold" Margin="2,0,0,0" />
                    </DockPanel>

                    <Grid x:Name="MessagesLayoutGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="120" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="1*" MinHeight="80" />
                        </Grid.RowDefinitions>

                    <TabControl x:Name="MainTabs" Grid.Row="0"
                                ItemsSource="{Binding Tabs}"
                                SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TabNeedsAttention}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="TabItemFlashStoryboard">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1"
                                                                     To="0.55"
                                                                     Duration="0:0:0.35" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="TabItemFlashStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TabControl.ItemContainerStyle>

                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <emoji:TextBlock Text="{Binding TabHeader}" VerticalAlignment="Center">
                                        <emoji:TextBlock.Style>
                                            <Style TargetType="emoji:TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TabNeedsAttention}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="TabFlashStoryboard">
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="1"
                                                                                     To="0.35"
                                                                                     Duration="0:0:0.45" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="TabFlashStoryboard" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </emoji:TextBlock.Style>
                                    </emoji:TextBlock>
                                    <Button Content="&#xE711;"
                                            FontFamily="Segoe MDL2 Assets" FontSize="9"
                                            Margin="6,0,-4,0" Padding="3,0"
                                            BorderThickness="0" Background="Transparent"
                                            ToolTip="Close conversation"
                                            Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.CloseTabCommand,
                                                      RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>

                        <TabControl.Resources>
                            <DataTemplate DataType="{x:Type vm:ChannelViewModel}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="60" />
                                    </Grid.RowDefinitions>

                                    <Expander Grid.Row="0" Header="Channel settings" IsExpanded="False"
                                              Margin="2">
                                        <Border Padding="8"
                                                Background="{DynamicResource BrushPanelBackground}"
                                                BorderBrush="{DynamicResource BrushPanelBorder}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name"
                                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                                <TextBox Grid.Row="0" Grid.Column="1"
                                                         Margin="0,4,0,4"
                                                         Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Row="0" Grid.Column="2"
                                                           Margin="8,4,0,4"
                                                           Foreground="{DynamicResource BrushSubtle}"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Hash, StringFormat=hash 0x{0:X2}}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Role"
                                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                                <ComboBox Grid.Row="1" Grid.Column="1"
                                                          Margin="0,4,0,4"
                                                          HorizontalAlignment="Left" Width="160"
                                                          ItemsSource="{Binding RoleOptions}"
                                                          SelectedItem="{Binding EditRole, Mode=TwoWay}" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="PSK"
                                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                                <TextBox Grid.Row="2" Grid.Column="1"
                                                         Margin="0,4,0,4"
                                                         FontFamily="Consolas"
                                                         ToolTip="default | none | base64:... | hex:..."
                                                         Text="{Binding EditPsk, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource PskText}}" />
                                                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="8,4,0,4">
                                                    <Button Content="Default"  Margin="2,0"
                                                            Padding="8,2"
                                                            Command="{Binding UseDefaultKeyCommand}" />
                                                    <Button Content="Random 16" Margin="2,0"
                                                            Padding="8,2"
                                                            Command="{Binding GenerateRandomKey128Command}" />
                                                    <Button Content="Random 32" Margin="2,0"
                                                            Padding="8,2"
                                                            Command="{Binding GenerateRandomKeyCommand}" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Location sharing"
                                                           Margin="0,4,8,4" VerticalAlignment="Center" />
                                                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,4"
                                                          VerticalAlignment="Center"
                                                          ItemsSource="{Binding PositionPrecisionOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Bits"
                                                          SelectedValue="{Binding EditPositionPrecision, Mode=TwoWay}"
                                                          ToolTip="How precisely your location is shared on this channel: off, an approximate radius, or precise (matches Meshtastic)" />

                                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"
                                                            Margin="0,8,0,0" HorizontalAlignment="Right">
                                                    <Button Content="Revert" Margin="0,0,4,0" Padding="14,4"
                                                            Command="{Binding RevertCommand}" />
                                                    <Button Content="Save"   Padding="14,4"
                                                            Command="{Binding SaveCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Expander>

                                    <DockPanel Grid.Row="1" Margin="4">
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2" LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Content="Clear" Padding="6,1"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Clear this channel's messages (cannot be undone)"
                                                    Command="{Binding DataContext.ClearChannelMessagesCommand,
                                                              RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="Copy" Padding="6,1"
                                                    Command="{Binding CopyMessagesCommand}" />
                                                <CheckBox DockPanel.Dock="Right"
                                                    Content="Auto-scroll"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                                                    ToolTip="Automatically follow new messages in this channel" />
                                                <CheckBox DockPanel.Dock="Right"
                                                      Content="Mute RTTTL"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding MuteRtttl, Mode=TwoWay}"
                                                      ToolTip="Mute RTTTL ringtone for text messages on this channel" />
                                            <TextBlock Text="Messages" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <!-- Compose bar: visible only when the active device can transmit (HackRF). -->
                                        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" LastChildFill="True"
                                                   Visibility="{Binding DataContext.CanTransmit,
                                                                RelativeSource={RelativeSource AncestorType=TabControl},
                                                                Converter={StaticResource BoolToVis}}">
                                            <Button DockPanel.Dock="Right" Content="Send" Padding="14,4"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Encode and transmit a text message on this channel"
                                                    Command="{Binding DataContext.SendMessageCommand,
                                                              RelativeSource={RelativeSource AncestorType=TabControl}}" />
                                            <Button DockPanel.Dock="Right" Content="Node info" Padding="14,4"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Broadcast your node info (id / name / role) on the primary channel"
                                                    Command="{Binding DataContext.SendNodeInfoCommand,
                                                              RelativeSource={RelativeSource AncestorType=TabControl}}" />
                                            <Button DockPanel.Dock="Right" Content="Position" Padding="14,4"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Broadcast your position on the primary channel (uses the channel's position precision and your home location)"
                                                    Command="{Binding DataContext.SendPositionCommand,
                                                              RelativeSource={RelativeSource AncestorType=TabControl}}" />
                                              <TextBox VerticalContentAlignment="Center"
                                                    FontFamily="Segoe UI, Segoe UI Emoji"
                                                     ToolTip="Type a message and press Enter or Send (HackRF only)"
                                                     Text="{Binding DataContext.ComposeText,
                                                            RelativeSource={RelativeSource AncestorType=TabControl},
                                                            Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter"
                                                                Command="{Binding DataContext.SendMessageCommand,
                                                                          RelativeSource={RelativeSource AncestorType=TabControl}}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </DockPanel>
                                        <ListBox ItemsSource="{Binding Messages}"
                                                 FontFamily="Consolas"
                                                 HorizontalContentAlignment="Stretch"
                                                 Grid.IsSharedSizeScope="True"
                                                 beh:AutoScroll.IsEnabled="{Binding AutoScroll}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="NodeName" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding TimePrefix}" />
                                                        <emoji:TextBlock Grid.Column="1" Margin="6,0" Text="{Binding FromId}"
                                                                         ToolTip="{Binding FromId}" />
                                                        <emoji:TextBlock Grid.Column="2" beh:MarkdownText.Text="{Binding TextWithStatus}"
                                                                         TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type vm:ConversationViewModel}">
                                <DockPanel Margin="4">
                                    <Border DockPanel.Dock="Top" Padding="6,4" Margin="0,0,0,4"
                                            Background="{DynamicResource BrushPanelBackground}"
                                            BorderBrush="{DynamicResource BrushPanelBorder}"
                                            BorderThickness="1">
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Content="Clear" Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Clear this conversation (cannot be undone)"
                                                    Command="{Binding DataContext.ClearConversationMessagesCommand,
                                                              RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="Copy" Padding="6,1"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Copy this conversation to the clipboard"
                                                    Command="{Binding CopyMessagesCommand}" />
                                                <CheckBox DockPanel.Dock="Right"
                                                    Content="Auto-scroll"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                                                    ToolTip="Automatically follow new messages in this conversation" />
                                                <CheckBox DockPanel.Dock="Right"
                                                      Content="Mute RTTTL"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding MuteRtttl, Mode=TwoWay}"
                                                      ToolTip="Mute RTTTL ringtone for text messages from this node" />
                                            <StackPanel>
                                                <emoji:TextBlock FontWeight="SemiBold"
                                                                 Text="{Binding PeerName}" />
                                                <emoji:TextBlock Foreground="{DynamicResource BrushSubtle}"
                                                                 FontFamily="Consolas"
                                                                 Text="{Binding PeerId}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                     <!-- Compose bar: visible only when the active device can transmit (HackRF). -->
                                     <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" LastChildFill="True"
                                              Visibility="{Binding DataContext.CanTransmit,
                                                        RelativeSource={RelativeSource AncestorType=TabControl},
                                                        Converter={StaticResource BoolToVis}}">
                                        <Button DockPanel.Dock="Right" Content="Send" Padding="14,4"
                                                Margin="4,0,0,0"
                                                ToolTip="Encode and transmit a direct message to this node"
                                                Command="{Binding DataContext.SendDirectMessageCommand,
                                                          RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                CommandParameter="{Binding}" />
                                                 <TextBox VerticalContentAlignment="Center"
                                                    FontFamily="Segoe UI, Segoe UI Emoji"
                                                 ToolTip="Type a direct message and press Enter or Send"
                                                 Text="{Binding ComposeText,
                                                        Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter"
                                                            Command="{Binding DataContext.SendDirectMessageCommand,
                                                                      RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                            CommandParameter="{Binding}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>
                                    <!-- Messages (left) + resizable telemetry panel (right). -->
                                    <Grid x:Name="ConversationLayoutGrid"
                                          Loaded="ConversationLayoutGrid_Loaded">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="220" MinWidth="120" />
                                        </Grid.ColumnDefinitions>

                                        <ListBox Grid.Column="0"
                                                 ItemsSource="{Binding Messages}"
                                                 FontFamily="Consolas"
                                                 HorizontalContentAlignment="Stretch"
                                                 Grid.IsSharedSizeScope="True"
                                                 beh:AutoScroll.IsEnabled="{Binding AutoScroll}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="NodeName" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding TimePrefix}" />
                                                        <emoji:TextBlock Grid.Column="1" Margin="6,0" Text="{Binding FromId}"
                                                                         ToolTip="{Binding FromId}" />
                                                        <emoji:TextBlock Grid.Column="2" beh:MarkdownText.Text="{Binding TextWithStatus}"
                                                                         TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <GridSplitter Grid.Column="1" Width="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Stretch"
                                                      Background="{DynamicResource BrushSplitter}"
                                                      DragCompleted="ConversationMainSplitter_DragCompleted"
                                                      ShowsPreview="False"
                                                      ResizeBehavior="PreviousAndNext" />

                                        <!-- Telemetry panel for the peer node. -->
                                        <Border Grid.Column="2" Margin="6,0,0,0"
                                                Padding="8" VerticalAlignment="Stretch"
                                                Background="{DynamicResource BrushPanelBackground}"
                                                BorderBrush="{DynamicResource BrushPanelBorder}"
                                            BorderThickness="1">
                                        <Grid x:Name="ConversationTelemetryGrid">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" MinHeight="80" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" MinHeight="80" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
                                                <TextBlock Text="Telemetry"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>

                                            <ScrollViewer Grid.Row="1"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel>
                                                    <TextBlock Foreground="{DynamicResource BrushSubtle}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Text="No telemetry received yet.">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasTelemetry}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <ItemsControl ItemsSource="{Binding Telemetry}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" MinWidth="92" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Foreground="{DynamicResource BrushSubtle}"
                                                                               Text="{Binding Label}" />
                                                                    <TextBlock Grid.Column="1"
                                                                               FontFamily="Consolas"
                                                                               TextWrapping="Wrap"
                                                                               Text="{Binding Value}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>

                                            <GridSplitter Grid.Row="2"
                                                          Height="5"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"
                                                          Background="{DynamicResource BrushSplitter}"
                                                          DragCompleted="ConversationTelemetrySplitter_DragCompleted"
                                                          ShowsPreview="False"
                                                          ResizeBehavior="PreviousAndNext" />

                                            <Grid Grid.Row="3">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,6,0,4">
                                                    <Button DockPanel.Dock="Right"
                                                            Content="Clear"
                                                            Padding="8,2"
                                                            Command="{Binding ClearLocationHistoryCommand}" />
                                                    <CheckBox DockPanel.Dock="Right"
                                                              Content="Show on map"
                                                              Margin="0,0,8,0"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding ShowLocationHistoryOnMap, Mode=TwoWay}" />
                                                    <TextBlock Text="Location history"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>

                                                <TextBlock Grid.Row="1"
                                                           Foreground="{DynamicResource BrushSubtle}"
                                                           FontSize="11"
                                                           Margin="0,0,0,4"
                                                           Text="No location samples yet.">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLocationHistory}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <DataGrid Grid.Row="2"
                                                          ItemsSource="{Binding LocationHistory}"
                                                          AutoGenerateColumns="False"
                                                          HeadersVisibility="Column"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          CanUserResizeRows="False"
                                                          IsReadOnly="True"
                                                          SelectionMode="Single"
                                                          SelectionUnit="FullRow"
                                                          Margin="0,0,0,0"
                                                          MinHeight="80"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          Visibility="{Binding HasLocationHistory, Converter={StaticResource BoolToVis}}">
                                                    <DataGrid.InputBindings>
                                                        <KeyBinding Key="Delete"
                                                                    Command="{Binding DeleteLocationHistoryPointCommand}"
                                                                    CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                    </DataGrid.InputBindings>
                                                    <DataGrid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Delete"
                                                                      Command="{Binding PlacementTarget.DataContext.DeleteLocationHistoryPointCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </DataGrid.ContextMenu>
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Time"
                                                                            Width="*"
                                                                            Binding="{Binding TimestampLocal, StringFormat={}{0:g}}" />
                                                        <DataGridTextColumn Header="Lat"
                                                                            Width="Auto"
                                                                            Binding="{Binding Latitude, StringFormat={}{0:0.#####}}" />
                                                        <DataGridTextColumn Header="Lon"
                                                                            Width="Auto"
                                                                            Binding="{Binding Longitude, StringFormat={}{0:0.#####}}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    </Grid>
                                </DockPanel>
                            </DataTemplate>
                        </TabControl.Resources>
                    </TabControl>

                    <GridSplitter Grid.Row="1"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  Background="{DynamicResource BrushSplitter}"
                                  ShowsPreview="False"
                                  ResizeBehavior="PreviousAndNext" />

                    <DockPanel Grid.Row="2" Margin="0,2,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Clear" Padding="6,1"
                                    Margin="4,0,0,0"
                                    Command="{Binding ClearLogCommand}" />
                            <Button DockPanel.Dock="Right" Content="Copy" Padding="6,1"
                                    Command="{Binding CopyLogCommand}" />
                            <TextBlock Text="Log" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding LogLines}"
                                 FontFamily="Consolas"
                                 beh:AutoScroll.IsEnabled="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <emoji:TextBlock Text="{Binding}" FontFamily="Consolas" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- Keep the middle splitter for left/right width. -->
            <GridSplitter Grid.Column="1"
                          Width="5" VerticalAlignment="Stretch" HorizontalAlignment="Center"
                          Background="{DynamicResource BrushSplitter}"
                          ShowsPreview="False" ResizeBehavior="PreviousAndNext" />
        </Grid>
    </DockPanel>
</Window>
