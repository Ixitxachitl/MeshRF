<Project>
  <PropertyGroup>
    <AssemblyName>MeshRF</AssemblyName>
    <IntermediateOutputPath>obj\x64\Debug\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>C:\Users\krame\Documents\VSCode\MeshRF\app\MeshRF.App\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>MeshRF.App</_TargetAssemblyProjectName>
    <RootNamespace>MeshRF.App</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>MeshRF.App</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Avoid the WPF "_wpftmp.csproj" temporary-target-assembly dance, which
         races with the VS Code C# project system and produces spurious
         "Cannot open project file ..._wpftmp.csproj" errors. -->
    <IncludePackageReferencesDuringMarkupCompilation>true</IncludePackageReferencesDuringMarkupCompilation>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The legacy WPF app is versioned independently of the repo (2.0.0, the
         Avalonia app's). This is its final release: after it ships alongside
         the first Avalonia build, only Avalonia is maintained. -->
    <VersionPrefix>1.0.9</VersionPrefix>
    <AssemblyVersion>1.0.9.0</AssemblyVersion>
    <FileVersion>1.0.9.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <!-- MQTTnet arrives transitively via MeshRF.Core, which owns MqttBridge. -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MeshRF.Core\MeshRF.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <!-- Copy the native bridge DLL produced by CMake into the WPF output dir so
       P/Invoke can find it at runtime. The native DSP hot path is far too slow
       in a Debug (unoptimized, bounds-checked) build to sustain 2.4 MS/s, so
       we default to the optimized RelWithDebInfo native build even when the
       managed app is built Debug. Override with -p:NativeConfig=Debug if you
       need to debug the C++ side. The CMake build must have produced
       build/windows-x64/bin/$(NativeConfig)/MeshRF.Native.dll first. -->
  <PropertyGroup>
    <NativeConfig Condition="'$(NativeConfig)' == ''">RelWithDebInfo</NativeConfig>
  </PropertyGroup>
  <Target Name="CopyNativeBridge" AfterTargets="Build">
    <PropertyGroup>
      <_NativeBinDir>$(MSBuildThisFileDirectory)..\..\build\windows-x64\bin\$(NativeConfig)</_NativeBinDir>
      <_NativeBridgeDll>$(_NativeBinDir)\MeshRF.Native.dll</_NativeBridgeDll>
    </PropertyGroup>
    <ItemGroup>
      <_NativeRuntimeDll Include="$(_NativeBinDir)\hackrf.dll" />
      <_NativeRuntimeDll Include="$(_NativeBinDir)\libusb-1.0.dll" />
      <_NativeRuntimeDll Include="$(_NativeBinDir)\pthreadVC2.dll" />
      <_NativeRuntimeDll Include="$(_NativeBinDir)\rtlsdr.dll" />
    </ItemGroup>
    <Copy SourceFiles="$(_NativeBridgeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(_NativeBridgeDll)')" />
    <Copy SourceFiles="@(_NativeRuntimeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(_NativeRuntimeDll.FullPath)')" />
    <Warning Text="Native bridge DLL not found at $(_NativeBridgeDll). Build the native CMake project first (cmake --build build/windows-x64 --config $(NativeConfig))." Condition="!Exists('$(_NativeBridgeDll)')" />
  </Target>
