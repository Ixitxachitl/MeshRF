<Application x:Class="MeshRF.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Bundled emoji font: file name before '#', internal family name after '#'. -->
            <FontFamily x:Key="EmojiFont">./NotoColorEmoji-Regular.ttf#Noto Color Emoji</FontFamily>

            <ResourceDictionary.MergedDictionaries>
                <!-- Default to Light; ThemeManager swaps this at startup
                     based on AppSettings.Theme. -->
                <ResourceDictionary Source="Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
