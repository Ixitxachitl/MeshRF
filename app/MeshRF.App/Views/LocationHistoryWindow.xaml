<Window x:Class="MeshRF.App.Views.LocationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Location History"
        Width="920"
        Height="430"
        MinWidth="760"
        MinHeight="390"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushAppForeground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right"
                    Content="Clear"
                    Padding="8,2"
                    Margin="6,0,0,0"
                    Command="{Binding ClearLocationHistoryCommand}" />
            <TextBlock Text="{Binding TabHeader}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1"
                   Foreground="{DynamicResource BrushSubtle}"
                   FontSize="11"
                   Margin="0,0,0,4"
                   Text="No location samples yet.">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasLocationHistory}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MapPaneColumn" Width="360" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="HistoryPaneColumn" Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    MinHeight="260"
                    MaxHeight="520"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                    Background="{DynamicResource BrushPanelBackground}"
                    BorderBrush="{DynamicResource BrushPanelBorder}"
                    BorderThickness="1">
                <Grid ClipToBounds="True">
                    <Canvas x:Name="MiniMapCanvas"
                            ClipToBounds="True"
                            Focusable="True"
                            SizeChanged="MiniMapCanvas_SizeChanged"
                            MouseLeftButtonDown="MiniMapCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="MiniMapCanvas_MouseLeftButtonUp"
                            MouseMove="MiniMapCanvas_MouseMove"
                            MouseWheel="MiniMapCanvas_MouseWheel" />
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="8"
                            Padding="2"
                            Background="#CC202020"
                            CornerRadius="3">
                        <StackPanel Orientation="Vertical">
                            <Button Width="28"
                                    Height="28"
                                    FontSize="11"
                                    Content="&#xE740;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Click="FitMap_Click"
                                    ToolTip="Fit location history" />
                            <ToggleButton x:Name="FollowLatestButton"
                                          Width="28"
                                          Height="28"
                                          FontSize="11"
                                          Margin="0,2,0,0"
                                          Content="&#xE707;"
                                          FontFamily="Segoe MDL2 Assets"
                                          Click="FollowLatest_Click"
                                          ToolTip="Follow latest location" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BrushSplitter}"
                          ShowsPreview="False"
                          ResizeBehavior="PreviousAndNext" />

            <DataGrid Grid.Column="2"
                      ItemsSource="{Binding LocationHistory}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeight="22"
                      ColumnHeaderHeight="24"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Visibility="{Binding HasLocationHistory, Converter={StaticResource BoolToVis}}">
                <DataGrid.InputBindings>
                    <KeyBinding Key="Delete"
                                Command="{Binding DeleteLocationHistoryPointCommand}"
                                CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                </DataGrid.InputBindings>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Delete"
                                  Command="{Binding PlacementTarget.DataContext.DeleteLocationHistoryPointCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time"
                                        Width="*"
                                        Binding="{Binding TimestampLocal, StringFormat={}{0:M/d/yyyy h:mm:ss tt}}" />
                    <DataGridTextColumn Header="Lat"
                                        Width="Auto"
                                        Binding="{Binding Latitude, StringFormat={}{0:0.#####}}" />
                    <DataGridTextColumn Header="Lon"
                                        Width="Auto"
                                        Binding="{Binding Longitude, StringFormat={}{0:0.#####}}" />
                    <DataGridTextColumn Header="Alt"
                                        Width="Auto"
                                        Binding="{Binding AltitudeDisplay}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>