<Window x:Class="MeshRF.App.Views.MqttSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MQTT Bridge"
        Width="600" Height="480"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushAppForeground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Border Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource BrushSubtle}" FontSize="12"
                           Text="Gateways mesh traffic to/from an MQTT broker, mirroring Meshtastic firmware's MQTT module. Defaults match firmware exactly: the public mqtt.meshtastic.org broker, username/password meshdev/large4cats, root topic &quot;msh&quot;, and encrypted (not JSON) publishing. Per-channel Uplink/Downlink is set in each channel's Settings." />

                <!-- Row 1: Enabled -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Enabled" Margin="0,4,8,4" VerticalAlignment="Center" />
                <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,4"
                          VerticalAlignment="Center"
                          Content="Enable the MQTT bridge"
                          IsChecked="{Binding MqttEnabled, Mode=TwoWay}"
                          ToolTip="Master switch. Off by default, matching firmware ModuleConfig.MQTTConfig.enabled." />

                <!-- Row 2: Status -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Status" Margin="0,4,8,4" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,4"
                           FontFamily="Consolas" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushSubtle}"
                           Text="{Binding MqttStatus}" />

                <!-- Row 3: Server address -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Server" Margin="0,4,8,4" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,4"
                         FontFamily="Consolas"
                         Text="{Binding MqttAddress, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Broker address, optionally host:port. Empty = the public mqtt.meshtastic.org broker (port 1883, or 8883 with TLS)." />

                <!-- Row 4: Username -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Username" Margin="0,4,8,4" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4,0,4"
                         FontFamily="Consolas"
                         Text="{Binding MqttUsername, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Empty = firmware default username (meshdev)." />

                <!-- Row 5: Password -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Password" Margin="0,4,8,4" VerticalAlignment="Center" />
                <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,4,0,4">
                    <Button DockPanel.Dock="Right" Content="Show"
                            Margin="6,0,0,0" Padding="8,2"
                            Visibility="{Binding IsMqttPasswordHidden, Converter={StaticResource BoolToVis}}"
                            Command="{Binding ToggleRevealMqttPasswordCommand}"
                            ToolTip="Reveal the password" />
                    <Button DockPanel.Dock="Right" Content="Hide"
                            Margin="6,0,0,0" Padding="8,2"
                            Visibility="{Binding IsMqttPasswordRevealed, Converter={StaticResource BoolToVis}}"
                            Command="{Binding ToggleRevealMqttPasswordCommand}"
                            ToolTip="Hide the password" />
                    <Grid>
                        <TextBox FontFamily="Consolas"
                                 Visibility="{Binding IsMqttPasswordRevealed, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding MqttPassword, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Empty = firmware default password (large4cats)." />
                        <TextBox FontFamily="Consolas" IsReadOnly="True" Focusable="False"
                                 Visibility="{Binding IsMqttPasswordHidden, Converter={StaticResource BoolToVis}}"
                                 ToolTip="Password is hidden — click Show to reveal or edit"
                                 Text="●●●●●●●●●●●●" />
                    </Grid>
                </DockPanel>

                <!-- Row 6: Root topic -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Root topic" Margin="0,4,8,4" VerticalAlignment="Center" />
                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4,0,4"
                         FontFamily="Consolas"
                         Text="{Binding MqttRootTopic, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Empty = firmware default (&quot;msh&quot;)." />

                <!-- Row 7: Encryption / TLS / JSON -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Options" Margin="0,4,8,4" VerticalAlignment="Center" />
                <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,4,0,4">
                    <CheckBox Content="Publish/accept channel-encrypted packets (not decrypted contents)"
                              IsChecked="{Binding MqttEncryptionEnabled, Mode=TwoWay}"
                              ToolTip="On by default, matching firmware encryption_enabled. Turning this off is not recommended — it publishes decrypted channel contents to the broker." />
                    <CheckBox Margin="0,6,0,0" Content="Connect over TLS"
                              IsChecked="{Binding MqttTlsEnabled, Mode=TwoWay}"
                              ToolTip="Off by default, matching firmware tls_enabled." />
                    <CheckBox Margin="0,6,0,0" Content="Also publish human-readable JSON"
                              IsChecked="{Binding MqttJsonEnabled, Mode=TwoWay}"
                              ToolTip="Publishes a parallel JSON copy of every uplinked packet to &quot;.../2/json/...&quot; and accepts 'sendtext'/'sendposition' JSON commands on a channel named 'mqtt' (with Downlink enabled), matching firmware json_enabled. Off by default." />
                </StackPanel>

                <!-- Row 8: Map reporting -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Map reporting" Margin="0,4,8,4" VerticalAlignment="Center" />
                <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,4,0,4">
                    <CheckBox Content="Publish periodic map reports"
                              IsChecked="{Binding MqttMapReportingEnabled, Mode=TwoWay}"
                              ToolTip="Publishes an unencrypted MapReport (name, role, hardware, firmware version, region/preset, approximate location) to the broker's map topic, matching firmware's map-reporting feature (ModuleConfig.MQTTConfig.map_reporting_enabled). Off by default." />
                    <DockPanel Margin="0,6,0,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Margin="0,0,4,0" VerticalAlignment="Center" Text="Interval" />
                        <TextBox DockPanel.Dock="Left" Width="60" FontFamily="Consolas"
                                 Text="{Binding MqttMapReportIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock DockPanel.Dock="Left" Margin="4,0,16,0" VerticalAlignment="Center" Text="sec" />
                        <TextBlock DockPanel.Dock="Left" Margin="0,0,4,0" VerticalAlignment="Center" Text="Precision" />
                        <ComboBox DockPanel.Dock="Left" Width="130"
                                  ItemsSource="{Binding MqttMapReportPrecisionOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Bits"
                                  SelectedValue="{Binding MqttMapReportPositionPrecision, Mode=TwoWay}"
                                  ToolTip="Approximate radius your location is fuzzed to before publishing. Firmware default: 14 bits (~1.5 km)." />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
