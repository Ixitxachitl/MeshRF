<Window x:Class="MeshRF.App.Views.ChannelSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MeshRF.App.Converters"
        Title="Channel Settings"
        Width="620" Height="260"
        MinWidth="480" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushAppForeground}">
    <Window.Resources>
        <conv:PskTextConverter x:Key="PskText" />
    </Window.Resources>
    <Border Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="0,4,8,4" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4,0,4"
                     Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,4,0,4"
                       Foreground="{DynamicResource BrushSubtle}" VerticalAlignment="Center"
                       Text="{Binding Hash, StringFormat=hash 0x{0:X2}}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Role" Margin="0,4,8,4" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,4"
                      HorizontalAlignment="Left" Width="160"
                      ItemsSource="{Binding RoleOptions}"
                      SelectedItem="{Binding EditRole, Mode=TwoWay}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="PSK" Margin="0,4,8,4" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,4"
                     FontFamily="Consolas"
                     ToolTip="Empty = no encryption, AQ== = default key, or paste base64/hex"
                     Text="{Binding EditPsk, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource PskText}}" />
            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="8,4,0,4">
                <Button Content="Default" Margin="2,0" Padding="8,2" Command="{Binding UseDefaultKeyCommand}" />
                <Button Content="Rnd 16" Margin="2,0" Padding="8,2" Command="{Binding GenerateRandomKey128Command}" />
                <Button Content="Rnd 32" Margin="2,0" Padding="8,2" Command="{Binding GenerateRandomKeyCommand}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Location sharing" Margin="0,4,8,4" VerticalAlignment="Center" />
            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,4"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding PositionPrecisionOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Bits"
                      SelectedValue="{Binding EditPositionPrecision, Mode=TwoWay}"
                      ToolTip="How precisely your location is shared on this channel: off, an approximate radius, or precise (matches Meshtastic)" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Mute ringtone" Margin="0,4,8,4" VerticalAlignment="Center" />
            <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,4,0,4"
                      VerticalAlignment="Center"
                      Content="Mute incoming ringtone on this channel"
                      IsChecked="{Binding MuteRtttl, Mode=TwoWay}"
                      ToolTip="Mute RTTTL ringtone for text messages on this channel" />

            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                        Margin="0,8,0,0" HorizontalAlignment="Right">
                <Button Content="Revert" Margin="0,0,4,0" Padding="14,4" Command="{Binding RevertCommand}" />
                <Button Content="Save" Padding="14,4" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
