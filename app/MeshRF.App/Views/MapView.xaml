<UserControl x:Class="MeshRF.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1B1B1B"
             ClipToBounds="True"
             Focusable="True">
    <Grid>
        <!-- Base layer: tile images. IsHitTestVisible=False so mouse events
             fall through to the marker canvas above. -->
        <Canvas x:Name="TileCanvas"
                Background="#FF1B1B1B"
                IsHitTestVisible="False" />
        <!-- Overlay layer: node markers + interaction. Transparent background
             keeps the full canvas area hit-testable for dragging/right-click. -->
        <Canvas x:Name="MarkerCanvas"
                Background="Transparent"
                MouseLeftButtonDown="OnMouseDown"
                MouseLeftButtonUp="OnMouseUp"
                MouseMove="OnMouseMove"
                MouseWheel="OnMouseWheel"
                MouseRightButtonUp="OnRightClick" />

        <TextBlock x:Name="AttributionText"
                   Text="© OpenStreetMap contributors  ·  Ctrl+right-click to set home"
                   IsHitTestVisible="False"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,4,2"
                   FontSize="10"
                   Foreground="#AAFFFFFF" />

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="8" Padding="2"
                Background="#CC202020" CornerRadius="3">
            <StackPanel Orientation="Vertical">
                <Button Content="+" Width="28" Height="28" FontSize="16"
                        Click="OnZoomIn" ToolTip="Zoom in" />
                <Button Content="&#x2013;" Width="28" Height="28" FontSize="16"
                        Margin="0,2,0,0"
                        Click="OnZoomOut" ToolTip="Zoom out" />
                <Button Width="28" Height="28" FontSize="12"
                        Margin="0,2,0,0"
                        Content="&#xE80F;"
                        FontFamily="Segoe MDL2 Assets"
                        Click="OnGoHome" ToolTip="Go to home location" />
                <Button Width="28" Height="28" FontSize="11"
                        Margin="0,2,0,0"
                        Content="&#xE740;"
                        FontFamily="Segoe MDL2 Assets"
                        Click="OnFitAll" ToolTip="Fit all visible nodes" />
                <ToggleButton x:Name="FollowHomeButton"
                              Width="28" Height="28" FontSize="11"
                              Margin="0,2,0,0"
                              Content="&#xE707;"
                              FontFamily="Segoe MDL2 Assets"
                              Click="OnFollowHomeToggle"
                              ToolTip="Follow GPS / home location" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
