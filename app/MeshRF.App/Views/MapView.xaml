<UserControl x:Class="MeshRF.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             Background="#FF1B1B1B"
             ClipToBounds="True"
             Focusable="True">
        <UserControl.Resources>
                <Style x:Key="MapCalendarDayButtonStyle" TargetType="CalendarDayButton">
                        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
                        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
                        <Setter Property="BorderThickness" Value="1" />
                </Style>
                <Style x:Key="MapCalendarButtonStyle" TargetType="CalendarButton">
                        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
                        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
                        <Setter Property="BorderThickness" Value="1" />
                </Style>
                <Style x:Key="MapCalendarStyle" TargetType="Calendar">
                        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource MapCalendarDayButtonStyle}" />
                        <Setter Property="CalendarButtonStyle" Value="{StaticResource MapCalendarButtonStyle}" />
                </Style>
                <Style TargetType="{x:Type DatePicker}">
                        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
                        <Setter Property="CalendarStyle" Value="{StaticResource MapCalendarStyle}" />
                </Style>
                <Style TargetType="{x:Type Calendar}">
                        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
                        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource MapCalendarDayButtonStyle}" />
                        <Setter Property="CalendarButtonStyle" Value="{StaticResource MapCalendarButtonStyle}" />
                </Style>
        </UserControl.Resources>
    <Grid>
        <!-- Base layer: tile images. IsHitTestVisible=False so mouse events
             fall through to the marker canvas above. -->
        <Canvas x:Name="TileCanvas"
                Background="#FF1B1B1B"
                IsHitTestVisible="False" />
        <!-- Overlay layer: node markers + interaction. Transparent background
             keeps the full canvas area hit-testable for dragging/right-click. -->
        <Canvas x:Name="MarkerCanvas"
                Background="Transparent"
                MouseLeftButtonDown="OnMouseDown"
                MouseLeftButtonUp="OnMouseUp"
                MouseMove="OnMouseMove"
                MouseWheel="OnMouseWheel"
                MouseRightButtonUp="OnRightClick" />

        <TextBlock x:Name="AttributionText"
                   Text="© OpenStreetMap contributors  ·  Ctrl+left-click send waypoint  ·  Ctrl+right-click set home"
                   IsHitTestVisible="False"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,4,2"
                   FontSize="10"
                   Foreground="#AAFFFFFF" />

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="8" Padding="2"
                Background="#CC202020" CornerRadius="3">
            <StackPanel Orientation="Vertical">
                <Button Content="+" Width="28" Height="28" FontSize="16"
                        Click="OnZoomIn" ToolTip="Zoom in" />
                <Button Content="&#x2013;" Width="28" Height="28" FontSize="16"
                        Margin="0,2,0,0"
                        Click="OnZoomOut" ToolTip="Zoom out" />
                <Button Width="28" Height="28" FontSize="12"
                        Margin="0,2,0,0"
                        Content="&#xE80F;"
                        FontFamily="Segoe MDL2 Assets"
                        Click="OnGoHome" ToolTip="Go to home location" />
                <Button Width="28" Height="28" FontSize="11"
                        Margin="0,2,0,0"
                        Content="&#xE740;"
                        FontFamily="Segoe MDL2 Assets"
                        Click="OnFitAll" ToolTip="Fit all visible nodes" />
                <ToggleButton x:Name="FollowHomeButton"
                              Width="28" Height="28" FontSize="11"
                              Margin="0,2,0,0"
                              Content="&#xE707;"
                              FontFamily="Segoe MDL2 Assets"
                              Click="OnFollowHomeToggle"
                              ToolTip="Follow GPS / home location" />
                                <ToggleButton x:Name="ClusterNodesButton"
                                                          Width="28" Height="28" FontSize="11"
                                                          Margin="0,2,0,0"
                                                          IsChecked="True"
                                                          Content="&#xE81E;"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          Click="OnClusterToggle"
                                                          ToolTip="Cluster overlapping nodes" />
            </StackPanel>
        </Border>

        <Expander HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="8"
                  Header="Waypoint"
                  IsExpanded="False"
                  Background="{DynamicResource BrushPanelBackground}"
                  BorderBrush="{DynamicResource BrushPanelBorder}"
                  BorderThickness="1">
            <Border Padding="6,4"
                    Background="{DynamicResource BrushPanelBackground}"
                    BorderBrush="{DynamicResource BrushPanelBorder}"
                    BorderThickness="1">
                <StackPanel Orientation="Vertical" Width="176">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="WP"
                                   Foreground="{DynamicResource BrushAppForeground}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox Width="62"
                                  Height="24"
                                  ItemsSource="{Binding WaypointEmojiOptions}"
                                  SelectedItem="{Binding SelectedWaypointEmoji, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Waypoint emoji preset.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <emoji:TextBlock Text="{Binding}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBox Width="58"
                                 Height="24"
                                 Margin="4,0,0,0"
                                 FontFamily="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontFamily}"
                                 FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize}"
                                 Text="{Binding SelectedWaypointEmoji, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Custom emoji (paste/type any emoji, e.g. Win + .)" />
                    </StackPanel>

                    <TextBlock Text="Name" Foreground="{DynamicResource BrushAppForeground}" Margin="0,6,0,0" />
                    <TextBox Width="170"
                             Margin="0,2,0,0"
                             Text="{Binding WaypointNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Waypoint name for new Ctrl+left-click waypoints" />

                    <TextBlock Text="Description" Foreground="{DynamicResource BrushAppForeground}" Margin="0,6,0,0" />
                    <TextBox Width="170"
                             Margin="0,2,0,0"
                             Text="{Binding WaypointDescriptionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Waypoint description for new Ctrl+left-click waypoints" />

                    <CheckBox Content="Set expiration"
                              Margin="0,6,0,0"
                              Foreground="{DynamicResource BrushAppForeground}"
                              IsChecked="{Binding UseWaypointExpiry, Mode=TwoWay}" />
                    <TextBlock Text="Expiration" Foreground="{DynamicResource BrushAppForeground}" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <DatePicker Width="106"
                                    SelectedDate="{Binding WaypointExpiryDate, Mode=TwoWay}"
                                    CalendarStyle="{StaticResource MapCalendarStyle}"
                                    IsEnabled="{Binding UseWaypointExpiry}"
                                                                        ToolTip="Expiration date (local time)">
                                                        <DatePicker.Resources>
                                                                <Style TargetType="{x:Type TextBox}">
                                                                        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
                                                                        <Setter Property="CaretBrush" Value="{DynamicResource BrushAppForeground}" />
                                                                </Style>
                                                        </DatePicker.Resources>
                                                </DatePicker>
                        <TextBox Width="58"
                                 Margin="4,0,0,0"
                                 IsEnabled="{Binding UseWaypointExpiry}"
                                 Text="{Binding WaypointExpiryTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Time in HH:mm:ss (local time)" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Expander>
    </Grid>
</UserControl>
