<Window x:Class="MeshRF.App.Views.NodeIdentityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MeshRF.App.Converters"
        Title="My Node — Identity &amp; Settings"
        Width="630" Height="820"
        MinWidth="480" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushAppForeground}"
        PreviewMouseWheel="OnPreviewMouseWheel">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Border Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Node ID -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Node ID"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,4,0,4">
                    <Button DockPanel.Dock="Right" Content="Random"
                            Margin="6,0,0,0" Padding="8,2"
                            Command="{Binding GenerateRandomNodeIdCommand}"
                            ToolTip="Generate a random node ID" />
                    <Button DockPanel.Dock="Right" Content="From Key"
                            Margin="6,0,0,0" Padding="8,2"
                            Command="{Binding GenerateNodeIdFromKeyCommand}"
                            ToolTip="Derive the node ID from the current PKI public key the same way Meshtastic firmware does" />
                    <TextBox FontFamily="Consolas"
                             ToolTip="!a1b2c3d4, 0xA1B2C3D4 or decimal"
                             Text="{Binding MyNodeIdText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </DockPanel>

                <!-- Row 1: MAC address -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="MAC address"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,4"
                         FontFamily="Consolas"
                         IsReadOnly="True"
                         Foreground="{DynamicResource BrushSubtle}"
                         ToolTip="Derived from node ID (02:00 + last 4 bytes). Set the node ID to change this."
                         Text="{Binding MyMacAddress, Mode=OneWay}" />

                <!-- Row 2: Long name -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Long name"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,4"
                         Text="{Binding MyLongName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                <!-- Row 3: Short name -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Short name"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,4"
                         MaxLength="4"
                         Text="{Binding MyShortName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                <!-- Row 4: Role -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Role"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4,0,4"
                          HorizontalAlignment="Left" Width="160"
                          ItemsSource="{Binding NodeRoleOptions}"
                          SelectedItem="{Binding MyRole, Mode=TwoWay}" />

                <!-- Row 5: Hardware -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Hardware"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,4,0,4"
                          HorizontalAlignment="Left" Width="200"
                          ItemsSource="{Binding HwModelOptions}"
                          SelectedItem="{Binding MyHwModel, Mode=TwoWay}"
                          ToolTip="Hardware model (for when TX is added)" />

                <!-- Row 6: Rebroadcast -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Rebroadcast"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,4,0,4"
                          HorizontalAlignment="Left" Width="200"
                          ItemsSource="{Binding RebroadcastModeOptions}"
                          SelectedItem="{Binding RebroadcastMode, Mode=TwoWay}"
                          ToolTip="Rebroadcast mode (used once TX is enabled)" />

                <!-- Row 7: Public key -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Public key"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <TextBox Grid.Row="7" Grid.Column="1" Margin="0,4,0,4"
                         FontFamily="Consolas" IsReadOnly="True"
                         ToolTip="Derived from private key — not editable"
                         Text="{Binding MyPublicKey, Mode=OneWay}" />

                <!-- Row 8: Private key -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Private key"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <DockPanel Grid.Row="8" Grid.Column="1" Margin="0,4,0,4">
                    <Button DockPanel.Dock="Right" Content="Generate"
                            Margin="6,0,0,0" Padding="8,2"
                            Command="{Binding GenerateKeyPairCommand}"
                            ToolTip="Generate a new random key pair" />
                    <TextBox FontFamily="Consolas"
                             ToolTip="Base64 X25519 private key (kept locally)"
                             Text="{Binding MyPrivateKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </DockPanel>

                <!-- Row 9: Location source -->
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Location source"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,4,0,4">
                    <ComboBox HorizontalAlignment="Left" Width="160"
                              ItemsSource="{Binding LocationSourceOptions}"
                              SelectedItem="{Binding SelectedLocationSource, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              ToolTip="Choose between a fixed manual location and an auto-detected USB serial GPS." />
                    <Grid Margin="0,6,0,0" IsEnabled="{Binding IsUsbSerialLocationSource}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,4,0"
                                 FontFamily="Consolas"
                                 ToolTip="Optional COM port override, for example COM5. Leave blank for auto-detect."
                                 Text="{Binding GpsPortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="1" Margin="4,0,0,0"
                                 FontFamily="Consolas"
                                 ToolTip="Optional baud override, for example 9600. Leave blank for auto-detect."
                                 Text="{Binding GpsBaudRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource BrushSubtle}"
                               Text="{Binding GpsStatus}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Row 10: Home location -->
                <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding HomeLocationLabel}"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <Grid Grid.Row="10" Grid.Column="1" Margin="0,4,0,4"
                      IsEnabled="{Binding IsManualLocationSource}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,2,0"
                             FontFamily="Consolas"
                             ToolTip="Latitude in degrees (-90..90)"
                             Text="{Binding HomeLatitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Margin="2,0,2,0"
                             FontFamily="Consolas"
                             ToolTip="Longitude in degrees (-180..180)"
                             Text="{Binding HomeLongitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" Margin="2,0,0,0"
                             FontFamily="Consolas"
                             ToolTip="{Binding HomeAltitudeToolTip}"
                             Text="{Binding HomeAltitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Row 11: Hop limit -->
                <TextBlock Grid.Row="11" Grid.Column="0" Text="Hop limit"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <DockPanel Grid.Row="11" Grid.Column="1" Margin="0,4,0,4">
                    <TextBlock DockPanel.Dock="Right" Width="20"
                               Margin="6,0,0,0" VerticalAlignment="Center"
                               TextAlignment="Center"
                               Text="{Binding HopLimit}" />
                    <Slider Minimum="1" Maximum="7"
                            TickFrequency="1" TickPlacement="BottomRight"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            Value="{Binding HopLimit, Mode=TwoWay}"
                            ToolTip="Hops a transmitted packet may travel (1..7). Meshtastic default is 3." />
                </DockPanel>

                <!-- Row 12: OK to MQTT -->
                <TextBlock Grid.Row="12" Grid.Column="0" Text="OK to MQTT"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <CheckBox Grid.Row="12" Grid.Column="1" Margin="0,4,0,4"
                          VerticalAlignment="Center"
                          Content="Allow gateways to uplink my packets to public MQTT"
                          IsChecked="{Binding OkToMqtt, Mode=TwoWay}"
                          ToolTip="Sets the ok_to_mqtt flag on packets you transmit so MQTT gateways may forward them to the public broker." />

                <!-- Row 13: Auto node info -->
                <TextBlock Grid.Row="13" Grid.Column="0" Text="Auto node info"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <DockPanel Grid.Row="13" Grid.Column="1" Margin="0,4,0,4" LastChildFill="False">
                    <CheckBox Content="Enabled" VerticalAlignment="Center"
                              IsChecked="{Binding AutoReportNodeInfoEnabled, Mode=TwoWay}" />
                    <TextBlock Margin="12,0,4,0" VerticalAlignment="Center" Text="Interval" />
                    <TextBox Width="60" FontFamily="Consolas"
                             Text="{Binding AutoReportNodeInfoSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="sec" />
                </DockPanel>

                <!-- Row 14: Auto position -->
                <TextBlock Grid.Row="14" Grid.Column="0" Text="Auto position"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <DockPanel Grid.Row="14" Grid.Column="1" Margin="0,4,0,4" LastChildFill="False">
                    <CheckBox Content="Enabled" VerticalAlignment="Center"
                              IsChecked="{Binding AutoReportPositionEnabled, Mode=TwoWay}" />
                    <TextBlock Margin="12,0,4,0" VerticalAlignment="Center" Text="Interval" />
                    <TextBox Width="60" FontFamily="Consolas"
                             Text="{Binding AutoReportPositionSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="sec" />
                </DockPanel>

                <!-- Row 15: Auto device metrics -->
                <TextBlock Grid.Row="15" Grid.Column="0" Text="Auto device metrics"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <DockPanel Grid.Row="15" Grid.Column="1" Margin="0,4,0,4" LastChildFill="False">
                    <CheckBox Content="Enabled" VerticalAlignment="Center"
                              IsChecked="{Binding AutoReportDeviceMetricsEnabled, Mode=TwoWay}" />
                    <TextBlock Margin="12,0,4,0" VerticalAlignment="Center" Text="Interval" />
                    <TextBox Width="60" FontFamily="Consolas"
                             Text="{Binding AutoReportDeviceMetricsSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="sec" />
                </DockPanel>

                <!-- Row 16: Auto status -->
                <TextBlock Grid.Row="16" Grid.Column="0" Text="Auto status"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <DockPanel Grid.Row="16" Grid.Column="1" Margin="0,4,0,4" LastChildFill="False">
                    <CheckBox Content="Enabled" VerticalAlignment="Center"
                              IsChecked="{Binding AutoReportNodeStatusEnabled, Mode=TwoWay}" />
                    <TextBlock Margin="12,0,4,0" VerticalAlignment="Center" Text="Interval" />
                    <TextBox Width="60" FontFamily="Consolas"
                             Text="{Binding AutoReportNodeStatusSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="sec" />
                </DockPanel>

                <!-- Row 17: Auto env telemetry -->
                <TextBlock Grid.Row="17" Grid.Column="0" Text="Auto env telemetry"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <DockPanel Grid.Row="17" Grid.Column="1" Margin="0,4,0,4" LastChildFill="False">
                    <CheckBox Content="Enabled" VerticalAlignment="Center"
                              IsChecked="{Binding AutoReportEnvironmentMetricsEnabled, Mode=TwoWay}" />
                    <TextBlock Margin="12,0,4,0" VerticalAlignment="Center" Text="Interval" />
                    <TextBox Width="60" FontFamily="Consolas"
                             Text="{Binding AutoReportEnvironmentMetricsSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="sec" />
                </DockPanel>

                <!-- Row 18: Auto AQ telemetry -->
                <TextBlock Grid.Row="18" Grid.Column="0" Text="Auto AQ telemetry"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <DockPanel Grid.Row="18" Grid.Column="1" Margin="0,4,0,4" LastChildFill="False">
                    <CheckBox Content="Enabled" VerticalAlignment="Center"
                              IsChecked="{Binding AutoReportAirQualityMetricsEnabled, Mode=TwoWay}" />
                    <TextBlock Margin="12,0,4,0" VerticalAlignment="Center" Text="Interval" />
                    <TextBox Width="60" FontFamily="Consolas"
                             Text="{Binding AutoReportAirQualityMetricsSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="sec" />
                </DockPanel>

                <!-- Row 19: Last sent summary -->
                <TextBlock Grid.Row="19" Grid.Column="1" Margin="0,2,0,6"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="{DynamicResource BrushSubtle}"
                           Text="{Binding AutoReportLastSentSummary}"
                           TextWrapping="Wrap"
                           ToolTip="Last successful auto-send times for NodeInfo, Position, Device Metrics, Environment Metrics, Air Quality, and Status." />

                <!-- Row 20: Weather status -->
                <TextBlock Grid.Row="20" Grid.Column="0" Text="Weather status"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <TextBlock Grid.Row="20" Grid.Column="1" Margin="0,4,0,4"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="{DynamicResource BrushSubtle}"
                           Text="{Binding WeatherTelemetryStatus}"
                           TextWrapping="Wrap"
                           ToolTip="Live status of weather-source fetches used for environment telemetry." />

                <!-- Row 21: AQ status -->
                <TextBlock Grid.Row="21" Grid.Column="0" Text="AQ status"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <TextBlock Grid.Row="21" Grid.Column="1" Margin="0,4,0,4"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="{DynamicResource BrushSubtle}"
                           Text="{Binding AirQualityTelemetryStatus}"
                           TextWrapping="Wrap"
                           ToolTip="Live status of air quality API fetches used for air quality telemetry (Open-Meteo AQ API)." />

                <!-- Row 22: Routing -->
                <TextBlock Grid.Row="22" Grid.Column="0" Text="Routing"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <CheckBox Grid.Row="22" Grid.Column="1" Margin="0,4,0,4"
                          VerticalAlignment="Center"
                          Content="Enable relay routing (role + rebroadcast mode)"
                          IsChecked="{Binding RoutingRelayEnabled, Mode=TwoWay}"
                          ToolTip="When enabled, this node may rebroadcast received packets using your selected role and rebroadcast mode policy." />

                <!-- Row 23: Status text -->
                <TextBlock Grid.Row="23" Grid.Column="0" Text="Status text"
                           Margin="0,4,8,4" VerticalAlignment="Center" />
                <TextBox Grid.Row="23" Grid.Column="1" Margin="0,4,0,4"
                         MaxLength="280"
                         Text="{Binding MyNodeStatus, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Status string broadcast by NODE_STATUS_APP." />
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
