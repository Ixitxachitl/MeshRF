<Window x:Class="MeshRF.App.Views.TelemetryHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telemetry History"
        Width="920"
        Height="430"
        MinWidth="760"
        MinHeight="390"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushAppForeground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="BatteryTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FF2ECC71" /></Style>
        <Style x:Key="VoltageTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FF3498DB" /></Style>
        <Style x:Key="ChannelUtilTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FFF1C40F" /></Style>
        <Style x:Key="AirUtilTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FFE67E22" /></Style>
        <Style x:Key="UptimeTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FF7F8C8D" /></Style>
        <Style x:Key="TemperatureTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FFE74C3C" /></Style>
        <Style x:Key="HumidityTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FF1ABC9C" /></Style>
        <Style x:Key="PressureTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FF9B59B6" /></Style>
        <Style x:Key="GasTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FF95A5A6" /></Style>
        <Style x:Key="IaqTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FFFF6B9A" /></Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Clear" Padding="8,2" Command="{Binding ClearTelemetryHistoryCommand}" />
            <TextBlock Text="{Binding TabHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1" Foreground="{DynamicResource BrushSubtle}" FontSize="11" Margin="0,0,0,4" Text="No telemetry samples yet.">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasTelemetryHistory}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="DevicePaneRow" Height="*" MinHeight="130" />
                <RowDefinition Height="6" />
                <RowDefinition x:Name="EnvironmentPaneRow" Height="*" MinHeight="130" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GraphPaneColumn" Width="360" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="HistoryPaneColumn" Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Device" FontWeight="SemiBold" Margin="0,0,0,3" />
                <Border Grid.Row="1" Background="{DynamicResource BrushPanelBackground}" BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                    <Canvas x:Name="DeviceSparkCanvas" ClipToBounds="True" SizeChanged="SparkCanvas_SizeChanged" />
                </Border>
                <WrapPanel Grid.Row="2" Margin="0,4,0,0">
                    <CheckBox x:Name="BatteryToggle" IsChecked="True" Margin="0,0,10,2" Checked="SparkGraphChanged" Unchecked="SparkGraphChanged"><TextBlock Text="Battery" Style="{StaticResource BatteryTextStyle}" /></CheckBox>
                    <CheckBox x:Name="VoltageToggle" IsChecked="True" Margin="0,0,10,2" Checked="SparkGraphChanged" Unchecked="SparkGraphChanged"><TextBlock Text="Voltage" Style="{StaticResource VoltageTextStyle}" /></CheckBox>
                    <CheckBox x:Name="ChannelUtilToggle" IsChecked="True" Margin="0,0,10,2" Checked="SparkGraphChanged" Unchecked="SparkGraphChanged"><TextBlock Text="Channel" Style="{StaticResource ChannelUtilTextStyle}" /></CheckBox>
                    <CheckBox x:Name="AirUtilToggle" IsChecked="True" Margin="0,0,10,2" Checked="SparkGraphChanged" Unchecked="SparkGraphChanged"><TextBlock Text="Air TX" Style="{StaticResource AirUtilTextStyle}" /></CheckBox>
                    <CheckBox x:Name="UptimeToggle" IsChecked="True" Margin="0,0,10,2" Checked="SparkGraphChanged" Unchecked="SparkGraphChanged"><TextBlock Text="Uptime" Style="{StaticResource UptimeTextStyle}" /></CheckBox>
                </WrapPanel>
            </Grid>

            <DataGrid Grid.Row="0" Grid.Column="2" ItemsSource="{Binding DeviceTelemetryHistory}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="22" ColumnHeaderHeight="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="{Binding HasTelemetryHistory, Converter={StaticResource BoolToVis}}">
                <DataGrid.InputBindings><KeyBinding Key="Delete" Command="{Binding DeleteTelemetryHistoryPointCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" /></DataGrid.InputBindings>
                <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Delete" Command="{Binding PlacementTarget.DataContext.DeleteTelemetryHistoryPointCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /></ContextMenu></DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Width="*" Binding="{Binding TimestampLocal, StringFormat={}{0:M/d/yyyy h:mm:ss tt}}" />
                    <DataGridTextColumn Width="Auto" Binding="{Binding Battery}" ElementStyle="{StaticResource BatteryTextStyle}"><DataGridTextColumn.Header><TextBlock Text="Battery" Style="{StaticResource BatteryTextStyle}" /></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Width="Auto" Binding="{Binding Voltage}" ElementStyle="{StaticResource VoltageTextStyle}"><DataGridTextColumn.Header><TextBlock Text="Voltage" Style="{StaticResource VoltageTextStyle}" /></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Width="Auto" Binding="{Binding ChannelUtil}" ElementStyle="{StaticResource ChannelUtilTextStyle}"><DataGridTextColumn.Header><TextBlock Text="Ch util" Style="{StaticResource ChannelUtilTextStyle}" /></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Width="Auto" Binding="{Binding AirUtilTx}" ElementStyle="{StaticResource AirUtilTextStyle}"><DataGridTextColumn.Header><TextBlock Text="Air TX" Style="{StaticResource AirUtilTextStyle}" /></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Width="Auto" Binding="{Binding Uptime}" ElementStyle="{StaticResource UptimeTextStyle}"><DataGridTextColumn.Header><TextBlock Text="Uptime" Style="{StaticResource UptimeTextStyle}" /></DataGridTextColumn.Header></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BrushSplitter}" ShowsPreview="False" ResizeBehavior="PreviousAndNext" />
            <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BrushSplitter}" ShowsPreview="False" ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Environmental" FontWeight="SemiBold" Margin="0,0,0,3" />
                <Border Grid.Row="1" Background="{DynamicResource BrushPanelBackground}" BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                    <Canvas x:Name="EnvironmentSparkCanvas" ClipToBounds="True" SizeChanged="SparkCanvas_SizeChanged" />
                </Border>
                <WrapPanel Grid.Row="2" Margin="0,4,0,0">
                    <CheckBox x:Name="TemperatureToggle" IsChecked="True" Margin="0,0,10,2" Checked="SparkGraphChanged" Unchecked="SparkGraphChanged"><TextBlock Text="Temp" Style="{StaticResource TemperatureTextStyle}" /></CheckBox>
                    <CheckBox x:Name="HumidityToggle" IsChecked="True" Margin="0,0,10,2" Checked="SparkGraphChanged" Unchecked="SparkGraphChanged"><TextBlock Text="Humidity" Style="{StaticResource HumidityTextStyle}" /></CheckBox>
                    <CheckBox x:Name="PressureToggle" IsChecked="True" Margin="0,0,10,2" Checked="SparkGraphChanged" Unchecked="SparkGraphChanged"><TextBlock Text="Pressure" Style="{StaticResource PressureTextStyle}" /></CheckBox>
                    <CheckBox x:Name="GasToggle" IsChecked="True" Margin="0,0,10,2" Checked="SparkGraphChanged" Unchecked="SparkGraphChanged"><TextBlock Text="Gas" Style="{StaticResource GasTextStyle}" /></CheckBox>
                    <CheckBox x:Name="IaqToggle" IsChecked="True" Margin="0,0,10,2" Checked="SparkGraphChanged" Unchecked="SparkGraphChanged"><TextBlock Text="IAQ" Style="{StaticResource IaqTextStyle}" /></CheckBox>
                </WrapPanel>
            </Grid>

            <DataGrid Grid.Row="2" Grid.Column="2" ItemsSource="{Binding EnvironmentalTelemetryHistory}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="22" ColumnHeaderHeight="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="{Binding HasTelemetryHistory, Converter={StaticResource BoolToVis}}">
                <DataGrid.InputBindings><KeyBinding Key="Delete" Command="{Binding DeleteTelemetryHistoryPointCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" /></DataGrid.InputBindings>
                <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Delete" Command="{Binding PlacementTarget.DataContext.DeleteTelemetryHistoryPointCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /></ContextMenu></DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Width="*" Binding="{Binding TimestampLocal, StringFormat={}{0:M/d/yyyy h:mm:ss tt}}" />
                    <DataGridTextColumn Width="Auto" Binding="{Binding Temperature}" ElementStyle="{StaticResource TemperatureTextStyle}"><DataGridTextColumn.Header><TextBlock Text="Temp" Style="{StaticResource TemperatureTextStyle}" /></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Width="Auto" Binding="{Binding Humidity}" ElementStyle="{StaticResource HumidityTextStyle}"><DataGridTextColumn.Header><TextBlock Text="Humidity" Style="{StaticResource HumidityTextStyle}" /></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Width="Auto" Binding="{Binding Pressure}" ElementStyle="{StaticResource PressureTextStyle}"><DataGridTextColumn.Header><TextBlock Text="Pressure" Style="{StaticResource PressureTextStyle}" /></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Width="Auto" Binding="{Binding GasResistance}" ElementStyle="{StaticResource GasTextStyle}"><DataGridTextColumn.Header><TextBlock Text="Gas" Style="{StaticResource GasTextStyle}" /></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Width="Auto" Binding="{Binding AirQuality}" ElementStyle="{StaticResource IaqTextStyle}"><DataGridTextColumn.Header><TextBlock Text="IAQ" Style="{StaticResource IaqTextStyle}" /></DataGridTextColumn.Header></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>