<Window x:Class="MeshRF.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About MeshRF"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushAppForeground}">
    <Grid Margin="22" Width="440">
        <StackPanel>
            <TextBlock Text="MeshRF" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="{Binding VersionText}" Margin="0,4,0,0" FontSize="13" />
            <TextBlock Text="{Binding CommitText}"
                       Foreground="{DynamicResource BrushSubtle}" FontSize="12" />
            <TextBlock Text="{Binding RuntimeText}"
                       Foreground="{DynamicResource BrushSubtle}"
                       FontSize="12" Margin="0,0,0,14" />

            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Text="Windows-native Meshtastic client. Demodulates and modulates LoRa chirps in software using a HackRF One or RTL-SDR and decodes Meshtastic frames on the host CPU." />

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource BrushSubtle}"
                       Text="This is the final release of the WPF app. Development continues in the cross-platform MeshRF build (Windows, Linux and macOS), which reads the same settings and databases." />

            <TextBlock Margin="0,14,0,0" FontSize="12">
                <Hyperlink NavigateUri="https://meshtastic.org/"
                           RequestNavigate="OnNavigate">Meshtastic project</Hyperlink>
                <Run Text="  ·  " Foreground="{DynamicResource BrushSubtle}" />
                <Hyperlink NavigateUri="https://github.com/tapparelj/gr-lora_sdr"
                           RequestNavigate="OnNavigate">gr-lora_sdr</Hyperlink>
                <Run Text="  ·  " Foreground="{DynamicResource BrushSubtle}" />
                <Hyperlink NavigateUri="https://www.openstreetmap.org/copyright"
                           RequestNavigate="OnNavigate">© OpenStreetMap</Hyperlink>
            </TextBlock>

            <TextBlock Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushSubtle}"
                       Text="Licensed under GPL-3.0-or-later. This project is not affiliated with or endorsed by the Meshtastic project." />

            <CheckBox Margin="0,14,0,0"
                      Content="Show game high scores (Snake / Tetris / Breakout / Chirpy Runner)"
                      IsChecked="{Binding Vm.ShowGameHighScores, Mode=TwoWay}"
                      ToolTip="Shows buttons on the primary channel tab for high-score leaderboards broadcast by the mesh's built-in games. Off by default." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button Content="Copy version info" MinWidth="120" Padding="10,4"
                        Click="OnCopy" />
                <Button Content="Close" MinWidth="80" Padding="10,4" Margin="8,0,0,0"
                        IsDefault="True" IsCancel="True" Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
