<UserControl x:Class="MeshRF.App.Views.WaypointBoundingBoxPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" Height="220"
             ClipToBounds="True"
             Focusable="True"
             Background="#FF1B1B1B">
    <Grid>
        <Canvas x:Name="TileCanvas"
                Background="#FF1B1B1B"
                IsHitTestVisible="False" />
        <Canvas x:Name="OverlayCanvas"
                Background="Transparent"
                MouseLeftButtonDown="OnMouseDown"
                MouseMove="OnMouseMove"
                MouseLeftButtonUp="OnMouseUp"
                MouseWheel="OnMouseWheel" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="4">
            <ToggleButton x:Name="RedrawButton"
                          Content="Redraw box"
                          Padding="6,2"
                          Foreground="{DynamicResource BrushAppForeground}"
                          Background="{DynamicResource BrushPanelBackground}"
                          Checked="OnRedrawToggled"
                          Unchecked="OnRedrawToggled"
                          ToolTip="Click, then click two opposite corners on the preview" />
            <Button Content="Clear"
                    Margin="4,0,0,0"
                    Padding="6,2"
                    Foreground="{DynamicResource BrushAppForeground}"
                    Background="{DynamicResource BrushPanelBackground}"
                    Click="OnClearClick" />
        </StackPanel>
        <TextBlock Foreground="#DDDDDD"
                   Background="#AA000000"
                   Padding="4,2"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Stretch"
                   TextAlignment="Center"
                   FontSize="11"
                   IsHitTestVisible="False"
                   Text="Scroll to zoom, drag to pan, © OpenStreetMap · © CARTO" />
    </Grid>
</UserControl>
