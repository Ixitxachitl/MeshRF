<Window x:Class="MeshRF.App.Views.WaypointEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:local="clr-namespace:MeshRF.App.Views"
        Title="Edit Waypoint"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushAppForeground}">
    <Window.Resources>
        <Style x:Key="EditCalendarDayButtonStyle" TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="EditCalendarButtonStyle" TargetType="CalendarButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="EditCalendarStyle" TargetType="Calendar">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource EditCalendarDayButtonStyle}" />
            <Setter Property="CalendarButtonStyle" Value="{StaticResource EditCalendarButtonStyle}" />
        </Style>
        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
            <Setter Property="CalendarStyle" Value="{StaticResource EditCalendarStyle}" />
        </Style>
        <Style TargetType="{x:Type Calendar}">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource EditCalendarDayButtonStyle}" />
            <Setter Property="CalendarButtonStyle" Value="{StaticResource EditCalendarButtonStyle}" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="720">
        <StackPanel Margin="10" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Icon"
                           Foreground="{DynamicResource BrushAppForeground}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <Button x:Name="IconButton"
                        Width="28"
                        Height="28"
                        Click="OnPickIconClick"
                        ToolTip="Click to pick waypoint icon">
                    <emoji:TextBlock x:Name="IconGlyphText"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center" />
                </Button>
            </StackPanel>

            <TextBlock Text="Name" Foreground="{DynamicResource BrushAppForeground}" Margin="0,8,0,0" />
            <TextBox x:Name="NameBox"
                     Margin="0,2,0,0"
                     Background="{DynamicResource BrushPanelBackground}"
                     Foreground="{DynamicResource BrushAppForeground}"
                     BorderBrush="{DynamicResource BrushPanelBorder}"
                     CaretBrush="{DynamicResource BrushAppForeground}" />

            <TextBlock Text="Description" Foreground="{DynamicResource BrushAppForeground}" Margin="0,6,0,0" />
            <TextBox x:Name="DescriptionBox"
                     Margin="0,2,0,0"
                     Background="{DynamicResource BrushPanelBackground}"
                     Foreground="{DynamicResource BrushAppForeground}"
                     BorderBrush="{DynamicResource BrushPanelBorder}"
                     CaretBrush="{DynamicResource BrushAppForeground}" />

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Latitude" Foreground="{DynamicResource BrushAppForeground}" />
                    <TextBox x:Name="LatitudeBox"
                             Margin="0,2,0,0"
                             Background="{DynamicResource BrushPanelBackground}"
                             Foreground="{DynamicResource BrushAppForeground}"
                             BorderBrush="{DynamicResource BrushPanelBorder}"
                             CaretBrush="{DynamicResource BrushAppForeground}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Longitude" Foreground="{DynamicResource BrushAppForeground}" />
                    <TextBox x:Name="LongitudeBox"
                             Margin="0,2,0,0"
                             Background="{DynamicResource BrushPanelBackground}"
                             Foreground="{DynamicResource BrushAppForeground}"
                             BorderBrush="{DynamicResource BrushPanelBorder}"
                             CaretBrush="{DynamicResource BrushAppForeground}" />
                </StackPanel>
            </Grid>

            <CheckBox x:Name="LockToMeCheck"
                      Content="Lock to me"
                      Margin="0,10,0,0"
                      Foreground="{DynamicResource BrushAppForeground}"
                      ToolTip="Sets Waypoint.locked_to to your node number, so compliant clients refuse edits/deletes from other nodes" />

            <CheckBox x:Name="UseExpiryCheck"
                      Content="Set expiration"
                      Margin="0,8,0,0"
                      Foreground="{DynamicResource BrushAppForeground}"
                      Checked="OnExpiryToggled"
                      Unchecked="OnExpiryToggled" />
            <StackPanel x:Name="ExpiryPanel" Orientation="Vertical" Margin="0,2,0,0">
                <DatePicker x:Name="ExpiryDatePicker" Width="140" HorizontalAlignment="Left">
                    <DatePicker.Resources>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
                            <Setter Property="CaretBrush" Value="{DynamicResource BrushAppForeground}" />
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <ComboBox x:Name="ExpiryHourCombo" Width="46" IsEditable="True" StaysOpenOnEdit="True" ToolTip="Hour (01-12)" />
                    <TextBlock Text=":" Margin="3,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAppForeground}" />
                    <ComboBox x:Name="ExpiryMinuteCombo" Width="46" IsEditable="True" StaysOpenOnEdit="True" ToolTip="Minute (00-59)" />
                    <TextBlock Text=":" Margin="3,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAppForeground}" />
                    <ComboBox x:Name="ExpirySecondCombo" Width="46" IsEditable="True" StaysOpenOnEdit="True" ToolTip="Second (00-59)" />
                    <ComboBox x:Name="ExpiryMeridiemCombo" Width="58" Margin="4,0,0,0" ToolTip="AM or PM" />
                </StackPanel>
            </StackPanel>

            <CheckBox x:Name="UseGeofenceCheck"
                      Content="Add geofence (circular)"
                      Margin="0,10,0,0"
                      Foreground="{DynamicResource BrushAppForeground}"
                      Checked="OnGeofenceToggled"
                      Unchecked="OnGeofenceToggled" />
            <StackPanel x:Name="GeofenceRadiusPanel" Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="Radius (m)" Foreground="{DynamicResource BrushAppForeground}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="GeofenceRadiusBox"
                         Width="80"
                         Background="{DynamicResource BrushPanelBackground}"
                         Foreground="{DynamicResource BrushAppForeground}"
                         BorderBrush="{DynamicResource BrushPanelBorder}"
                         CaretBrush="{DynamicResource BrushAppForeground}" />
            </StackPanel>

            <TextBlock Text="Bounding box geofence" Foreground="{DynamicResource BrushAppForeground}" Margin="0,10,0,2" />
            <Border BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                <local:WaypointBoundingBoxPreview x:Name="BboxPreview" />
            </Border>

            <StackPanel x:Name="NotifyPanel" Orientation="Vertical" Margin="0,10,0,0">
                <TextBlock Text="Geofence notifications" Foreground="{DynamicResource BrushAppForeground}" />
                <CheckBox x:Name="NotifyOnEnterCheck" Content="Notify on enter" Margin="0,2,0,0" Foreground="{DynamicResource BrushAppForeground}" />
                <CheckBox x:Name="NotifyOnExitCheck" Content="Notify on exit" Margin="0,2,0,0" Foreground="{DynamicResource BrushAppForeground}" />
                <CheckBox x:Name="NotifyFavoritesOnlyCheck" Content="Favorites only" Margin="0,2,0,0" Foreground="{DynamicResource BrushAppForeground}" />
            </StackPanel>

            <DockPanel Margin="0,14,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        MinWidth="72"
                        IsCancel="True"
                        Content="Cancel"
                        Click="OnCancelClick" />
                <Button DockPanel.Dock="Right"
                        Margin="0,0,6,0"
                        MinWidth="72"
                        IsDefault="True"
                        Content="Save"
                        Click="OnSaveClick" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
