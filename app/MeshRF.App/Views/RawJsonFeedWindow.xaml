<Window x:Class="MeshRF.App.Views.RawJsonFeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="Raw JSON Feed"
        Width="980"
        Height="520"
        MinWidth="700"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushAppBackground}"
        Foreground="{DynamicResource BrushAppForeground}">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="Clear"
                    Padding="8,2"
                    Margin="4,0,0,0"
                    Command="{Binding ClearDecodedPacketJsonFeedCommand}" />
            <Button DockPanel.Dock="Right"
                    Content="Copy"
                    Padding="8,2"
                    Command="{Binding CopyDecodedPacketJsonFeedCommand}" />
            <TextBlock VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="Decoded Packet JSON Feed" />
        </DockPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding DecodedPacketJsonLines}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <emoji:TextBlock FontFamily="Consolas"
                                     TextWrapping="Wrap"
                                     Text="{Binding}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
