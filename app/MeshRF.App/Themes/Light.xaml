<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme: mostly relies on default WPF chrome. We define the
         brushes used by name in MainWindow.xaml so the same XAML works for
         both themes. -->
    <SolidColorBrush x:Key="BrushAppBackground"     Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BrushAppForeground"     Color="#FF202020" />
    <SolidColorBrush x:Key="BrushSubtle"            Color="#FF606060" />
    <SolidColorBrush x:Key="BrushPanelBackground"   Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="BrushPanelBorder"       Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="BrushSplitter"          Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="BrushSpectrumBackground" Color="#FF101418" />
     <SolidColorBrush x:Key="BrushMenuHover"         Color="#FFF0F0F0" />
     <SolidColorBrush x:Key="BrushMenuPressed"       Color="#FFE6E6E6" />

     <ContextMenu x:Key="TextEditingContextMenu" x:Shared="False">
          <MenuItem Header="Cut"
                      Command="{x:Static ApplicationCommands.Cut}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
          <MenuItem Header="Copy"
                      Command="{x:Static ApplicationCommands.Copy}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
          <MenuItem Header="Paste"
                      Command="{x:Static ApplicationCommands.Paste}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
          <Separator />
          <MenuItem Header="Select All"
                      Command="{x:Static ApplicationCommands.SelectAll}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
     </ContextMenu>

     <Style TargetType="{x:Type ContextMenu}">
          <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
          <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushAppForeground}" />
     </Style>
     <Style TargetType="{x:Type MenuItem}">
          <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
          <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
          <Style.Triggers>
               <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushMenuHover}" />
               </Trigger>
               <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushMenuPressed}" />
               </Trigger>
          </Style.Triggers>
     </Style>

     <Style TargetType="{x:Type TextBox}">
          <Setter Property="ContextMenu" Value="{StaticResource TextEditingContextMenu}" />
     </Style>

     <Style TargetType="{x:Type ComboBox}">
          <Setter Property="MaxDropDownHeight" Value="260" />
          <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
          <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
          <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
     </Style>

     <Style TargetType="{x:Type ToolBar}">
          <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
          <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
          <Setter Property="Padding" Value="4,2" />
          <Setter Property="Template">
               <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolBar}">
                         <Border x:Name="Bd"
                                 Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}"
                                 BorderThickness="{TemplateBinding BorderThickness}"
                                 Padding="{TemplateBinding Padding}">
                              <DockPanel>
                                   <ToggleButton x:Name="OverflowButton"
                                                 DockPanel.Dock="Right"
                                                 IsEnabled="{TemplateBinding HasOverflowItems}"
                                                 IsChecked="{Binding IsOverflowOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                 ClickMode="Press"
                                                 Focusable="False">
                                        <ToggleButton.Template>
                                             <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                  <Border x:Name="ObBd" Background="Transparent" Width="14">
                                                       <Path x:Name="Arrow"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Bottom"
                                                             Margin="0,0,0,4"
                                                             Data="M 0 0 L 3.5 3.5 L 7 0 Z"
                                                             Fill="{DynamicResource BrushAppForeground}" />
                                                  </Border>
                                                  <ControlTemplate.Triggers>
                                                       <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ObBd" Property="Background" Value="#FFEDEDED" />
                                                       </Trigger>
                                                       <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="Arrow" Property="Fill"
                                                                    Value="{DynamicResource BrushSubtle}" />
                                                       </Trigger>
                                                  </ControlTemplate.Triggers>
                                             </ControlTemplate>
                                        </ToggleButton.Template>
                                   </ToggleButton>

                                   <Popup x:Name="OverflowPopup"
                                          AllowsTransparency="True"
                                          Placement="Bottom"
                                          IsOpen="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          StaysOpen="False"
                                          Focusable="False"
                                          PopupAnimation="Slide">
                                        <Border Background="{DynamicResource BrushPanelBackground}"
                                                BorderBrush="{DynamicResource BrushPanelBorder}"
                                                BorderThickness="1">
                                             <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel"
                                                                   Margin="2"
                                                                   WrapWidth="200"
                                                                   Focusable="True"
                                                                   FocusVisualStyle="{x:Null}"
                                                                   KeyboardNavigation.TabNavigation="Cycle"
                                                                   KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </Border>
                                   </Popup>

                                   <ToolBarPanel x:Name="PART_ToolBarPanel"
                                                 IsItemsHost="True"
                                                 Margin="0" />
                              </DockPanel>
                         </Border>
                         <ControlTemplate.Triggers>
                              <Trigger Property="HasOverflowItems" Value="False">
                                   <Setter TargetName="OverflowButton" Property="Visibility" Value="Collapsed" />
                              </Trigger>
                         </ControlTemplate.Triggers>
                    </ControlTemplate>
               </Setter.Value>
          </Setter>
     </Style>

     <Style TargetType="{x:Type ToolBarTray}">
          <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
     </Style>
</ResourceDictionary>
