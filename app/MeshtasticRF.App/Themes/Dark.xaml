<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="BrushAppBackground"      Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="BrushAppForeground"      Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="BrushSubtle"             Color="#FFB0B0B0" />
    <SolidColorBrush x:Key="BrushPanelBackground"    Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="BrushPanelBorder"        Color="#FF3F3F3F" />
    <SolidColorBrush x:Key="BrushSplitter"           Color="#FF3F3F3F" />
    <SolidColorBrush x:Key="BrushSpectrumBackground" Color="#FF101418" />

    <!-- Override the WPF system colors used by default control templates so
         text blocks, list items, etc., adopt the dark palette without
         needing to re-template every control. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"        Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"       Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}"  Color="#FF333333" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}"   Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"   Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"    Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}"      Color="#FF8C8C8C" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"          Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"      Color="#FFE6E6E6" />
    <Color x:Key="{x:Static SystemColors.WindowColorKey}">#FF1E1E1E</Color>
    <Color x:Key="{x:Static SystemColors.ControlColorKey}">#FF2A2A2A</Color>
    <Color x:Key="{x:Static SystemColors.ControlTextColorKey}">#FFE6E6E6</Color>
    <Color x:Key="{x:Static SystemColors.WindowTextColorKey}">#FFE6E6E6</Color>

    <!-- Implicit styles for the controls actually used in the window. We
         only override Background/Foreground/BorderBrush; the rest of the
         default templates carry through. -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource BrushAppBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
    </Style>
    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
    </Style>
    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1,1,1,0"
                            Margin="0,0,2,0">
                        <ContentPresenter x:Name="Content"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource BrushAppBackground}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="#FF3A3A3A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource BrushSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
    </Style>
    <Style TargetType="{x:Type StatusBar}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style TargetType="{x:Type ToolBar}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style TargetType="{x:Type ToolBarTray}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
    </Style>
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
    </Style>
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Bd"
                                Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" />
                        <ToggleButton Grid.ColumnSpan="2"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent">
                                        <Path HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{DynamicResource BrushAppForeground}" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite"
                                          Grid.Column="0"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource BrushPanelBackground}"
                                    BorderBrush="{DynamicResource BrushPanelBorder}"
                                    BorderThickness="1">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource BrushAppForeground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource BrushSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="#FF3A3A3A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource BrushSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type Slider}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBorder}" />
    </Style>
    <Style TargetType="{x:Type StatusBarItem}">
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="{DynamicResource BrushSplitter}" />
    </Style>

    <!-- ToolBar replaces child styles via its own resource keys; map those
         back to our implicit styles so labels/checkboxes inside a ToolBar
         use the dark palette instead of the default light one. -->
    <Style x:Key="{x:Static ToolBar.CheckBoxStyleKey}" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style x:Key="{x:Static ToolBar.RadioButtonStyleKey}" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
    </Style>
    <Style x:Key="{x:Static ToolBar.ToggleButtonStyleKey}" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style x:Key="{x:Static ToolBar.ComboBoxStyleKey}"
           TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource {x:Type ComboBox}}" />
    <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBorder}" />
    </Style>
    <Style x:Key="{x:Static ToolBar.TextBoxStyleKey}" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource BrushAppForeground}" />
    </Style>

    <!-- DataGrid (nodes table). Default templates pull SystemColors that read
         as white-on-white in dark mode, so we set the palette explicitly. -->
    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
        <Setter Property="RowBackground" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="AlternatingRowBackground" Value="#FF252525" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushPanelBorder}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BrushPanelBorder}" />
    </Style>
    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="6,3" />
    </Style>
    <Style TargetType="{x:Type DataGridRowHeader}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
    </Style>
    <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
    </Style>
    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="4,2">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF094771" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToolTips default to the system info colors (light), which render as
         white-on-white in dark mode. Re-template to use the dark palette. -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Padding="6,3">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
