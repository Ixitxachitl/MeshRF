<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted: net8.0-windows for the WPF app (MeshRF.App), plain
         net8.0 for the cross-platform Avalonia app (MeshRF.App.Avalonia).
         Nothing in this project actually uses Windows-only APIs today. -->
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <!-- AnyCPU, not x64: this is a pure managed library, and pinning it to x64
         made it unreferenceable from an arm64 app ("CS8012: Referenced assembly
         'MeshRF.Core' targets a different processor" when publishing for
         osx-arm64). The bitness that matters is the host process's, which comes
         from the app; the P/Invokes follow it either way. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>MeshRF</RootNamespace>
    <AssemblyName>MeshRF.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- MQTT uplink/downlink bridge. Lives here rather than in an app project
         so MeshRF.App and MeshRF.App.Avalonia share one implementation. -->
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="MQTTnet.Extensions.ManagedClient" Version="4.3.7.1207" />
    <!-- USB serial GPS. Cross-platform, so the reader lives here rather than
         in either app. -->
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <!-- Automation scripts are hand-edited YAML files under
         %APPDATA%\MeshRF\scripts. Only the representation model is used (see
         ScriptParser) — never the reflection-based serializer — so every
         parse error keeps the line/column the user needs to fix it. -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\third_party\meshtastic_protobufs\meshtastic\*.proto"
              ProtoRoot="..\..\third_party\meshtastic_protobufs"
              GrpcServices="None" />
    <Protobuf Include="..\..\third_party\meshtastic_protobufs\nanopb.proto"
              ProtoRoot="..\..\third_party\meshtastic_protobufs"
              GrpcServices="None" />
  </ItemGroup>

  <Target Name="EnsureMeshtasticProtobufSubmodule"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('..\..\third_party\meshtastic_protobufs\meshtastic\mesh.proto')"
           Text="Missing Meshtastic protobuf schema files in third_party/meshtastic_protobufs. Initialize submodules with: git submodule update --init --recursive" />
  </Target>

</Project>
