<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mesh="clr-namespace:MeshRF;assembly=MeshRF.Core"
        x:Class="MeshRF.AvaloniaApp.ChannelSettingsWindow"
        Title="Channel Settings"
        Width="560" SizeToContent="Height"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushAppBackground}">
    <Grid Margin="12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="0,4,8,4" VerticalAlignment="Center" />
        <!-- Text fields commit on LostFocus rather than per keystroke: the name
             feeds the channel hash and the PSK is only meaningful once fully
             typed, so saving mid-edit would churn the store and briefly define
             a channel nobody meant. -->
        <TextBox Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,4,0,4" LostFocus="OnFieldChanged" />
        <TextBlock Name="HashText" Grid.Row="0" Grid.Column="2" Margin="8,4,0,4"
                   Foreground="{DynamicResource BrushSubtle}" VerticalAlignment="Center" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Role" Margin="0,4,8,4" VerticalAlignment="Center" />
        <ComboBox Name="RoleCombo" Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" HorizontalAlignment="Left" Width="160"
                  SelectionChanged="OnFieldChanged" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="PSK" Margin="0,4,8,4" VerticalAlignment="Center" />
        <!-- Masked by default. A channel key is the whole of that channel's
             privacy, and this dialog gets opened in front of other people and
             on shared screens. -->
        <TextBox Name="PskBox" Grid.Row="2" Grid.Column="1" Margin="0,4,0,4" FontFamily="Consolas"
                 LostFocus="OnFieldChanged" PasswordChar="●"
                 RevealPassword="{Binding #PskReveal.IsChecked}"
                 ToolTip.Tip="Empty = the primary's key on a secondary, no encryption on the primary. AQ== = the default public key, as the other Meshtastic apps write it. Otherwise paste base64 or hex" />
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="8,4,0,4" Spacing="4">
            <ToggleButton Name="PskReveal" Content="Show" Padding="8,2"
                          ToolTip.Tip="Show the key in the clear" />
            <Button Content="Default" Padding="8,2" Click="OnUseDefaultKey" />
            <Button Content="Rnd 16" Padding="8,2" Click="OnRandom16" />
            <Button Content="Rnd 32" Padding="8,2" Click="OnRandom32" />
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Location sharing" Margin="0,4,8,4" VerticalAlignment="Center" />
        <ComboBox Name="PrecisionCombo" Grid.Row="3" Grid.Column="1" Margin="0,4,0,4" VerticalAlignment="Center"
                  SelectionChanged="OnFieldChanged"
                  ToolTip.Tip="How precisely your location is shared on this channel">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="mesh:PositionPrecisionOption">
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <!-- Says why the finer settings are missing when the key is a public
             one; blank and collapsed otherwise. -->
        <TextBlock Name="PrecisionNote" Grid.Row="3" Grid.Column="2" Margin="8,4,0,4"
                   VerticalAlignment="Center" MaxWidth="260" TextWrapping="Wrap"
                   FontSize="11" Foreground="{DynamicResource BrushSubtle}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Mute ringtone" Margin="0,4,8,4" VerticalAlignment="Center" />
        <CheckBox Name="MuteRtttlCheck" Grid.Row="4" Grid.Column="1" Margin="0,4,0,4" VerticalAlignment="Center"
                  Content="Mute incoming ringtone on this channel" Click="OnFieldChanged"
                  ToolTip.Tip="Mute RTTTL ringtone for text messages on this channel" />

        <!-- Hidden on a preset's own list: only the primary's traffic is
             uplinked or downlinked, so the boxes would promise nothing. -->
        <TextBlock Name="MqttLabel" Grid.Row="5" Grid.Column="0" Text="MQTT" Margin="0,4,8,4" VerticalAlignment="Center" />
        <StackPanel Name="MqttRow" Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4" Spacing="16">
            <CheckBox Name="UplinkCheck" VerticalAlignment="Center" Content="Uplink" Click="OnFieldChanged"
                      ToolTip.Tip="Publish this channel's traffic to the configured MQTT broker (requires the MQTT bridge to be enabled)." />
            <CheckBox Name="DownlinkCheck" VerticalAlignment="Center" Content="Downlink" Click="OnFieldChanged"
                      ToolTip.Tip="Accept this channel's traffic from the MQTT broker and inject it into the local mesh (requires the MQTT bridge to be enabled)." />
        </StackPanel>

        <!-- Empty unless something is wrong: this is where a rejected PSK is
             reported, since the PSK box itself must keep whatever was typed. -->
        <!-- Which mesh this channel belongs to. Fixed when the channel is
             made: its list is which listener decodes and sends it. -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="Listened on" Margin="0,4,8,4" VerticalAlignment="Center" />
        <TextBlock Name="ListText" Grid.Row="6" Grid.Column="1" Margin="0,4,0,4" VerticalAlignment="Center"
                   Foreground="{DynamicResource BrushSubtle}" />

        <TextBlock Name="StatusText" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                   Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrushSubtle}" />
    </Grid>
</Window>
