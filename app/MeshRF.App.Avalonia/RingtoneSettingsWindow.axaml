<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:MeshRF.AvaloniaApp"
        x:Class="MeshRF.AvaloniaApp.RingtoneSettingsWindow"
        x:DataType="app:RadioViewModel"
        Title="Notifications"
        Width="760" MinWidth="620"
        SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushAppBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="12" ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,10"
                       Foreground="{DynamicResource BrushSubtle}" FontSize="11"
                       Text="All three tunes are Meshtastic RTTTL, the same format the firmware's external notification module takes. Volume is shared; each tune plays for as long as its own dropdown says, so one kind of alert can be silenced without silencing the others. A script's ring: action follows the message tone." />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Volume" Margin="0,4,8,4" VerticalAlignment="Center" />
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,4">
                <TextBlock DockPanel.Dock="Right" Width="44" VerticalAlignment="Center"
                           Text="{Binding RingtoneVolume, StringFormat='{}{0:F0}%'}" />
                <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding RingtoneVolume, Mode=TwoWay}" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Message tone" Margin="0,4,8,4" VerticalAlignment="Center" />
            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,4,0,4">
                <ComboBox DockPanel.Dock="Left" Width="110" Margin="0,0,6,0"
                          ItemsSource="{Binding RingtoneModes}" SelectedItem="{Binding RingtoneMode, Mode=TwoWay}"
                          ToolTip.Tip="How long the message tone plays. Off silences it, and silences a script's ring: action with it." />
                <Button DockPanel.Dock="Right" Content="Test" Margin="6,0,0,0" Padding="10,2"
                        Command="{Binding TestRingtoneCommand}"
                        ToolTip.Tip="Preview the message tone" />
                <TextBox FontFamily="Consolas" FontSize="11"
                         Text="{Binding RingtoneRtttl, Mode=TwoWay}"
                         ToolTip.Tip="Sounded for a direct message, and for channel traffic that is not muted." />
            </DockPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Geofence tone" Margin="0,4,8,4" VerticalAlignment="Center" />
            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,4,0,4">
                <ComboBox DockPanel.Dock="Left" Width="110" Margin="0,0,6,0"
                          ItemsSource="{Binding RingtoneModes}"
                          SelectedItem="{Binding GeofenceRingtoneMode, Mode=TwoWay}"
                          ToolTip.Tip="How long the geofence chime plays. Off silences crossings only." />
                <Button DockPanel.Dock="Right" Content="Test" Margin="6,0,0,0" Padding="10,2"
                        Command="{Binding TestGeofenceToneCommand}"
                        ToolTip.Tip="Preview the geofence tone" />
                <TextBox FontFamily="Consolas" FontSize="11"
                         Text="{Binding GeofenceRtttl, Mode=TwoWay}"
                         ToolTip.Tip="Sounded when a node enters or leaves a waypoint's geofence. A short chime by default, so a crossing reads differently from someone talking to you." />
            </DockPanel>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Alert bell tone" Margin="0,4,8,4" VerticalAlignment="Center" />
            <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,4,0,4">
                <ComboBox DockPanel.Dock="Left" Width="110" Margin="0,0,6,0"
                          ItemsSource="{Binding RingtoneModes}"
                          SelectedItem="{Binding AlertBellRingtoneMode, Mode=TwoWay}"
                          ToolTip.Tip="How long the alert bell tone plays. Off falls back to nothing for a belled message — the message tone does not stand in for it." />
                <Button DockPanel.Dock="Right" Content="Test" Margin="6,0,0,0" Padding="10,2"
                        Command="{Binding TestAlertBellToneCommand}"
                        ToolTip.Tip="Preview the alert bell tone" />
                <TextBox FontFamily="Consolas" FontSize="11"
                         Text="{Binding AlertBellRtttl, Mode=TwoWay}"
                         ToolTip.Tip="Sounded instead of the message tone when a message carries Meshtastic's alert bell character — the sender saying this one matters. The bell button beside the compose box adds one." />
            </DockPanel>

            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Restore defaults" Padding="10,3"
                        Command="{Binding RestoreDefaultTonesCommand}"
                        ToolTip.Tip="Put all three tunes back to the stock Meshtastic ringtone, the default geofence chime and the default alert bell. Durations and volume are left alone." />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
