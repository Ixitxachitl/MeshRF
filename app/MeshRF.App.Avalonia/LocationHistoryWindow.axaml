<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeshRF.AvaloniaApp"
        x:Class="MeshRF.AvaloniaApp.LocationHistoryWindow"
        x:DataType="local:ConversationTabViewModel"
        Title="Location History"
        Width="960" Height="640" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BrushAppBackground}">
    <Grid Margin="6" RowDefinitions="Auto,*">

        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Clear" Padding="8,2"
                    Click="OnClear" />
            <ToggleButton x:Name="AutoScrollToggle" DockPanel.Dock="Right" Content="Auto-scroll"
                          Padding="8,2" Margin="16,0,4,0" IsChecked="True"
                          ToolTip.Tip="Keep the newest fix in view" />
            <TextBlock Text="{Binding TabHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Track on the left, the points that make it up on the right. Shown
             empty rather than replaced by a line of text: the map still gives
             somewhere to look, and the window keeps the same shape whether or
             not the node has been heard from yet. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,6,420">
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushSpectrumBackground}"
                    BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                <local:MapCanvas x:Name="Map" />
            </Border>

            <GridSplitter Grid.Column="1" Width="6" Background="{DynamicResource BrushSplitter}" />

            <DataGrid Grid.Column="2" x:Name="PointsGrid"
                      ItemsSource="{Binding LocationHistory}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" SelectionMode="Extended"
                      CanUserResizeColumns="True"
                      KeyDown="OnGridKeyDown"
                      local:DataGridAutoScrollBehavior.IsEnabled="{Binding #AutoScrollToggle.IsChecked}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Delete selected" Click="OnDeleteSelected" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <!-- Widths are start sizes wide enough for a full stamp and
                     five-decimal coordinates, not limits: the headers can be
                     dragged. Time takes the slack so a longer date convention
                     still fits without a horizontal scrollbar. -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Width="*" MinWidth="160"
                                        Binding="{Binding TimestampLocal, Converter={x:Static local:UiStampConverter.Instance}}" />
                    <DataGridTextColumn Header="Lat" Width="82" MinWidth="52" Binding="{Binding Latitude, StringFormat='{}{0:0.#####}'}" />
                    <DataGridTextColumn Header="Lon" Width="82" MinWidth="52" Binding="{Binding Longitude, StringFormat='{}{0:0.#####}'}" />
                    <DataGridTextColumn Header="Alt" Width="72" MinWidth="48" Binding="{Binding AltitudeDisplay}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
