<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MeshRF.AvaloniaApp</RootNamespace>
    <AssemblyName>MeshRF</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Windows PE icon for the published executable. The same .ico is also an
         AvaloniaResource below so the window/taskbar icon works on every OS. -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Column grids for the node and waypoint tables. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeshRF.Core\MeshRF.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unicode's emoji set, generated from UTS #51 emoji-test.txt; see
         EmojiCatalog.cs, which filters it down to what the platform colour
         emoji font can actually draw. -->
    <EmbeddedResource Include="Assets\emoji-catalog.txt" LogicalName="emoji-catalog.txt" />
    <!-- Window/taskbar icon, loaded at runtime via avares://. The .png is the
         source art, shipped for the Linux .desktop entry and macOS bundling. -->
    <AvaloniaResource Include="Assets\icon.ico" />
    <AvaloniaResource Include="Assets\icon.png" />
  </ItemGroup>

  <!-- SkiaSharp's and HarfBuzzSharp's Windows packages ship native debug
       symbols (libSkiaSharp.pdb ~80 MB, libHarfBuzzSharp.pdb ~20 MB) that are
       only useful for stepping through their C++ — they roughly doubled the
       published zip. Dropped at publish only; local builds keep everything,
       and our own MeshRF*.pdb still ship for crash diagnostics. -->
  <Target Name="PruneThirdPartyNativeSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Extension)' == '.pdb' And ('%(Filename)' == 'libSkiaSharp' Or '%(Filename)' == 'libHarfBuzzSharp')" />
    </ItemGroup>
  </Target>

  <!-- Stages the CMake-built native bridge next to the managed output; see
       the file for how the native build directory is chosen and overridden. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\NativeBridge.targets" />


</Project>
