<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MeshRF.AvaloniaApp</RootNamespace>
    <AssemblyName>MeshRF</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Windows PE icon for the published executable. The same .ico is also an
         AvaloniaResource below so the window/taskbar icon works on every OS. -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Node/waypoint tables are column grids in MeshRF.App (WPF DataGrid);
         this is the Avalonia equivalent so the two apps' tables match. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeshRF.Core\MeshRF.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unicode's emoji set, generated from UTS #51 emoji-test.txt; see
         EmojiCatalog.cs, which filters it down to what the platform colour
         emoji font can actually draw. -->
    <EmbeddedResource Include="Assets\emoji-catalog.txt" LogicalName="emoji-catalog.txt" />
    <!-- Window/taskbar icon, loaded at runtime via avares://. The .png is the
         source art, shipped for the Linux .desktop entry and macOS bundling. -->
    <AvaloniaResource Include="Assets\icon.ico" />
    <AvaloniaResource Include="Assets\icon.png" />
  </ItemGroup>

  <!-- SkiaSharp's and HarfBuzzSharp's Windows packages ship native debug
       symbols (libSkiaSharp.pdb ~80 MB, libHarfBuzzSharp.pdb ~20 MB) that are
       only useful for stepping through their C++ — they roughly doubled the
       published zip. Dropped at publish only; local builds keep everything,
       and our own MeshRF*.pdb still ship for crash diagnostics. -->
  <Target Name="PruneThirdPartyNativeSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Extension)' == '.pdb' And ('%(Filename)' == 'libSkiaSharp' Or '%(Filename)' == 'libHarfBuzzSharp')" />
    </ItemGroup>
  </Target>

  <!-- Copy the native bridge library produced by CMake into the output dir so
       P/Invoke can find it at runtime. Mirrors MeshRF.App.csproj's
       CopyNativeBridge target; see that file for the RelWithDebInfo rationale.
       Each OS has its own CMake preset (and so its own build dir) and its own
       shared-library extension; override NativeConfig/NativeBinDir directly to
       point somewhere else. The macOS branch is untested — see the
       macos-arm64 preset in CMakePresets.json. -->
  <PropertyGroup>
    <NativeConfig Condition="'$(NativeConfig)' == ''">RelWithDebInfo</NativeConfig>
    <NativeBinDir Condition="'$(NativeBinDir)' == '' AND '$(OS)' == 'Windows_NT'">$(MSBuildThisFileDirectory)..\..\build\windows-x64\bin\$(NativeConfig)</NativeBinDir>
    <NativeBinDir Condition="'$(NativeBinDir)' == '' AND '$([MSBuild]::IsOSPlatform(`Linux`))'">$(MSBuildThisFileDirectory)../../build/linux-x64/bin</NativeBinDir>
    <NativeBinDir Condition="'$(NativeBinDir)' == '' AND '$([MSBuild]::IsOSPlatform(`OSX`))'">$(MSBuildThisFileDirectory)../../build/macos-arm64/bin</NativeBinDir>
  </PropertyGroup>
  <Target Name="CopyNativeBridge" AfterTargets="Build">
    <ItemGroup>
      <_NativeBridgeLib Include="$(NativeBinDir)\MeshRF.Native.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <_NativeBridgeLib Include="$(NativeBinDir)/libMeshRF.Native.so" Condition="'$([MSBuild]::IsOSPlatform(`Linux`))'" />
      <_NativeBridgeLib Include="$(NativeBinDir)/libMeshRF.Native.dylib" Condition="'$([MSBuild]::IsOSPlatform(`OSX`))'" />
      <_NativeRuntimeDll Include="$(NativeBinDir)\hackrf.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <_NativeRuntimeDll Include="$(NativeBinDir)\libusb-1.0.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <_NativeRuntimeDll Include="$(NativeBinDir)\pthreadVC2.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <_NativeRuntimeDll Include="$(NativeBinDir)\rtlsdr.dll" Condition="'$(OS)' == 'Windows_NT'" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeBridgeLib)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_NativeBridgeLib.FullPath)')" />
    <Copy SourceFiles="@(_NativeRuntimeDll)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_NativeRuntimeDll.FullPath)')" />
    <Warning Text="Native bridge library not found under $(NativeBinDir). Build the native CMake project first."
             Condition="'@(_NativeBridgeLib)' == '' Or !Exists('%(_NativeBridgeLib.FullPath)')" />
  </Target>

</Project>
