<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MeshRF.AvaloniaApp.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- Mirrors MeshRF.App's Themes/Dark.xaml palette, so the two apps
             read as the same product. Light theme isn't ported yet. -->
        <SolidColorBrush x:Key="BrushAppBackground"      Color="#FF1E1E1E" />
        <SolidColorBrush x:Key="BrushAppForeground"      Color="#FFE6E6E6" />
        <SolidColorBrush x:Key="BrushSubtle"             Color="#FFB0B0B0" />
        <SolidColorBrush x:Key="BrushPanelBackground"    Color="#FF2A2A2A" />
        <SolidColorBrush x:Key="BrushPanelBorder"        Color="#FF3F3F3F" />
        <SolidColorBrush x:Key="BrushSplitter"           Color="#FF3F3F3F" />
        <SolidColorBrush x:Key="BrushSpectrumBackground" Color="#FF101418" />
        <SolidColorBrush x:Key="BrushHover"              Color="#FF3A3A3A" />
        <SolidColorBrush x:Key="BrushPressed"             Color="#FF222222" />

        <!-- Compact sliders. Avalonia's Fluent Slider is built for touch: its
             natural height is 50px (15px pre-margin + 20px thumb + 15px
             post-margin), which is what made the gain/waterfall toolbar rows
             tower over MeshRF.App's. Overriding these theme resources shrinks
             the template itself to ~16px; forcing Height on the control instead
             just clips the thumb, since the template still wants its 50px. -->
        <GridLength x:Key="SliderPreContentMargin">0</GridLength>
        <GridLength x:Key="SliderPostContentMargin">0</GridLength>
        <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
        <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
        <x:Double x:Key="SliderHorizontalHeight">16</x:Double>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Node/waypoint tables (Avalonia.Controls.DataGrid). -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- MeshRF.App runs at WPF's default ~12px control text; Avalonia's
             FluentTheme defaults noticeably larger (14px+, with generous
             touch-sized padding) which reads as oversized next to it. Pull
             the baseline down app-wide rather than per-control. -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource BrushAppBackground}" />
            <Setter Property="FontSize" Value="12" />
            <!-- Applied app-wide rather than per-window so every dialog gets the
                 title-bar icon too, not just the taskbar entry for MainWindow. -->
            <Setter Property="Icon" Value="/Assets/icon.ico" />
            <!-- Inter only. Emoji come from the per-codepoint font fallback that
                 Program.cs registers; do not append emoji fonts here. A chain
                 like "Inter, Segoe UI Emoji, ..." looks cross-platform but is
                 not: fontconfig resolves every name to something, so on Linux
                 the Windows and macOS links both become real fonts and text
                 lands in an emoji font with no Latin glyphs. -->
            <Setter Property="FontFamily" Value="Inter" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
            <!-- Avalonia's default is Top, which floats the caret/text against
                 the top edge on any TextBox given an explicit Height. -->
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <!-- Centre the label in the button box (Avalonia defaults to Left/Top). -->
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPressed}" />
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        </Style>
        <Style Selector="ToggleButton:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF2F5D8A" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
            <!-- Keep the selected item vertically centred in the fixed-height
                 toolbar combos rather than hugging the top edge. -->
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Fluent's Expander is touch-sized (tall header, wide padding) and
             left-aligns its content. Compact the header and let the expanded
             content fill the panel width. -->
        <Style Selector="Expander">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <!-- Fluent's DatePicker/TimePicker are touch-sized: a ~32px segmented
             bar with wide padding. Compact them to the app's control height so
             the waypoint composer doesn't give two rows of chrome to a date.
             MinWidth matters as much as height: Fluent's 296px minimum (242 for
             TimePicker) makes them overflow a narrow panel and clip rather than
             shrink to fit. -->
        <Style Selector="DatePicker, TimePicker">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="DatePicker /template/ Button#PART_FlyoutButton, TimePicker /template/ Button#PART_FlyoutButton">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="DatePicker /template/ Button#PART_FlyoutButton /template/ ContentPresenter#PART_ContentPresenter, TimePicker /template/ Button#PART_FlyoutButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushAppForeground}" />
        </Style>
        <Style Selector="DatePicker /template/ Button#PART_FlyoutButton:pointerover /template/ ContentPresenter#PART_ContentPresenter, TimePicker /template/ Button#PART_FlyoutButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushAppForeground}" />
        </Style>

        <Style Selector="Expander /template/ Border#ExpanderContent">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Expander /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Node/waypoint tables: pull the Fluent DataGrid onto this app's dark
             palette and down to the compact row height MeshRF.App's grids use. -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="RowBackground" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushPanelBorder}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BrushPanelBorder}" />
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="20" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <!-- Fluent's DataGridCell centres its content; MeshRF.App's grids
                 are left-aligned like a normal table. -->
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <!-- DataGridTextColumn gives its generated CellTextBlock a 12px margin
             on the left AND right. The text is technically left-aligned, but
             that symmetric 24px inset makes short values sit in the middle of a
             narrow column — which is what read as "centered". Alignment setters
             don't touch it; the margin has to be zeroed, and the cell's own
             Padding then supplies the single left inset. Measured: x=12 before,
             x=6 (the cell padding) after. -->
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAppForeground}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="4,1,0,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource BrushPanelBorder}" />
            <!-- The stock header template parks the sort arrow in its own grid
                 column, which holds ~32px whether or not the column is sorted —
                 on a narrow column that reserve is most of the width and clips
                 the title. This template puts the arrow directly after the
                 label instead, so nothing is reserved when unsorted. -->
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Name="PART_ColumnHeaderRoot" ColumnDefinitions="*,Auto">
                        <Border Name="HeaderBorder" Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center" />
                            <Path Name="SortIcon" Width="8" Height="5" Stretch="Fill" Margin="4,0,0,0"
                                  Fill="{TemplateBinding Foreground}" IsVisible="False"
                                  Data="M 0,0 L 8,0 L 4,5 Z" />
                        </StackPanel>
                        <Rectangle Name="VerticalSeparator" Grid.Column="1" Width="1"
                                   VerticalAlignment="Stretch"
                                   Fill="{TemplateBinding SeparatorBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="DataGridColumnHeader:sortascending /template/ Path#SortIcon">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Data" Value="M 0,5 L 8,5 L 4,0 Z" />
        </Style>
        <Style Selector="DataGridColumnHeader:sortdescending /template/ Path#SortIcon">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Data" Value="M 0,0 L 8,0 L 4,5 Z" />
        </Style>
        <Style Selector="DataGridColumnHeader TextBlock">
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Application.Styles>

</Application>
