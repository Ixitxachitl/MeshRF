<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeshRF.AvaloniaApp"
        x:Class="MeshRF.AvaloniaApp.TelemetryHistoryWindow"
        x:DataType="local:ConversationTabViewModel"
        Title="Telemetry History"
        Width="1180" Height="800" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BrushAppBackground}">
    <Grid Margin="6" RowDefinitions="Auto,*">

        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Clear" Padding="8,2"
                    Click="OnClear" />
            <ToggleButton x:Name="AutoScrollToggle" DockPanel.Dock="Right" Content="Auto-scroll"
                          Padding="8,2" Margin="16,0,4,0" IsChecked="True"
                          ToolTip.Tip="Keep the newest sample in view" />
            <TextBlock Text="{Binding TabHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Four metric groups, each a graph beside its table. Splitters let a
             pane be grown when one group is the one being studied.

             Always shown, empty or not: a node with no samples yet still has
             the same four groups, and swapping the whole layout for a line of
             text hides the column headers that say what would be recorded. -->
        <Grid Grid.Row="1"
              ColumnDefinitions="340,6,*"
              RowDefinitions="*,6,*,6,*,6,*">

            <local:TelemetryGraph Grid.Row="0" Grid.Column="0" x:Name="DeviceGraph" Title="Device" />
            <DataGrid Grid.Row="0" Grid.Column="2" x:Name="DeviceGrid"
                      ItemsSource="{Binding DeviceTelemetryHistory}"
                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                      SelectionMode="Extended" CanUserResizeColumns="True" KeyDown="OnGridKeyDown"
                      local:DataGridAutoScrollBehavior.IsEnabled="{Binding #AutoScrollToggle.IsChecked}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Delete selected" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <!-- Metric widths are start sizes that fit the formatted value
                     and its unit, not limits: every header here can be dragged.
                     Time takes the slack, so widening the pane widens the
                     stamp column rather than leaving a gap at the right. -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Width="*" MinWidth="160" Binding="{Binding TimestampLocal, Converter={x:Static local:UiStampConverter.Instance}}" />
                    <DataGridTextColumn Header="Battery" Width="64" MinWidth="48" Binding="{Binding Battery}" />
                    <DataGridTextColumn Header="Voltage" Width="64" MinWidth="48" Binding="{Binding Voltage}" />
                    <DataGridTextColumn Header="Ch util" Width="64" MinWidth="48" Binding="{Binding ChannelUtil}" />
                    <DataGridTextColumn Header="Air TX" Width="60" MinWidth="48" Binding="{Binding AirUtilTx}" />
                    <DataGridTextColumn Header="Uptime" Width="70" MinWidth="48" Binding="{Binding Uptime}" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="0" Grid.RowSpan="7" Grid.Column="1" Width="6"
                          Background="{DynamicResource BrushSplitter}" />
            <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="6"
                          HorizontalAlignment="Stretch" Background="{DynamicResource BrushSplitter}" />
            <GridSplitter Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Height="6"
                          HorizontalAlignment="Stretch" Background="{DynamicResource BrushSplitter}" />
            <GridSplitter Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Height="6"
                          HorizontalAlignment="Stretch" Background="{DynamicResource BrushSplitter}" />

            <local:TelemetryGraph Grid.Row="2" Grid.Column="0" x:Name="EnvironmentGraph" Title="Environmental" />
            <DataGrid Grid.Row="2" Grid.Column="2" x:Name="EnvironmentGrid"
                      ItemsSource="{Binding EnvironmentalTelemetryHistory}"
                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                      SelectionMode="Extended" CanUserResizeColumns="True" KeyDown="OnGridKeyDown"
                      local:DataGridAutoScrollBehavior.IsEnabled="{Binding #AutoScrollToggle.IsChecked}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Delete selected" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Width="*" MinWidth="160" Binding="{Binding TimestampLocal, Converter={x:Static local:UiStampConverter.Instance}}" />
                    <DataGridTextColumn Header="Temp" Width="70" MinWidth="48" Binding="{Binding Temperature}" />
                    <DataGridTextColumn Header="Humidity" Width="72" MinWidth="48" Binding="{Binding Humidity}" />
                    <DataGridTextColumn Header="Pressure" Width="80" MinWidth="52" Binding="{Binding Pressure}" />
                    <DataGridTextColumn Header="Gas" Width="76" MinWidth="48" Binding="{Binding GasResistance}" />
                    <DataGridTextColumn Header="IAQ" Width="52" MinWidth="40" Binding="{Binding AirQuality}" />
                </DataGrid.Columns>
            </DataGrid>

            <local:TelemetryGraph Grid.Row="4" Grid.Column="0" x:Name="AirQualityGraph" Title="Air Quality" />
            <DataGrid Grid.Row="4" Grid.Column="2" x:Name="AirQualityGrid"
                      ItemsSource="{Binding AirQualityTelemetryHistory}"
                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                      SelectionMode="Extended" CanUserResizeColumns="True" KeyDown="OnGridKeyDown"
                      local:DataGridAutoScrollBehavior.IsEnabled="{Binding #AutoScrollToggle.IsChecked}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Delete selected" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Width="*" MinWidth="160" Binding="{Binding TimestampLocal, Converter={x:Static local:UiStampConverter.Instance}}" />
                    <DataGridTextColumn Header="PM2.5" Width="78" MinWidth="52" Binding="{Binding Pm25Std}" />
                    <DataGridTextColumn Header="PM10" Width="78" MinWidth="52" Binding="{Binding Pm100Std}" />
                    <DataGridTextColumn Header="PM1.0" Width="78" MinWidth="52" Binding="{Binding Pm10Std}" />
                    <DataGridTextColumn Header="PM2.5e" Width="80" MinWidth="52" Binding="{Binding Pm25Env}" />
                    <DataGridTextColumn Header="PM10e" Width="80" MinWidth="52" Binding="{Binding Pm100Env}" />
                    <DataGridTextColumn Header="PM1.0e" Width="80" MinWidth="52" Binding="{Binding Pm10Env}" />
                </DataGrid.Columns>
            </DataGrid>

            <local:TelemetryGraph Grid.Row="6" Grid.Column="0" x:Name="PowerGraph" Title="Power" />
            <DataGrid Grid.Row="6" Grid.Column="2" x:Name="PowerGrid"
                      ItemsSource="{Binding PowerTelemetryHistory}"
                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                      SelectionMode="Extended" CanUserResizeColumns="True" KeyDown="OnGridKeyDown"
                      local:DataGridAutoScrollBehavior.IsEnabled="{Binding #AutoScrollToggle.IsChecked}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Delete selected" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Width="*" MinWidth="160" Binding="{Binding TimestampLocal, Converter={x:Static local:UiStampConverter.Instance}}" />
                    <DataGridTextColumn Header="CH1 V" Width="74" MinWidth="52" Binding="{Binding Ch1Voltage}" />
                    <DataGridTextColumn Header="CH1 A" Width="78" MinWidth="52" Binding="{Binding Ch1Current}" />
                    <DataGridTextColumn Header="CH2 V" Width="74" MinWidth="52" Binding="{Binding Ch2Voltage}" />
                    <DataGridTextColumn Header="CH2 A" Width="78" MinWidth="52" Binding="{Binding Ch2Current}" />
                    <DataGridTextColumn Header="CH3 V" Width="74" MinWidth="52" Binding="{Binding Ch3Voltage}" />
                    <DataGridTextColumn Header="CH3 A" Width="78" MinWidth="52" Binding="{Binding Ch3Current}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
