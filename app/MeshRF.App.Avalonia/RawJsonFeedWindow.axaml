<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeshRF.AvaloniaApp"
        x:Class="MeshRF.AvaloniaApp.RawJsonFeedWindow"
        x:DataType="local:RadioViewModel"
        Title="Raw JSON Feed"
        Width="1000" Height="560" MinWidth="700" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BrushAppBackground}">
    <Grid Margin="6" RowDefinitions="Auto,*">

        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Clear" Padding="8,2" Margin="4,0,0,0"
                    Click="OnClear" />
            <Button DockPanel.Dock="Right" Content="Export…" Padding="8,2" Margin="4,0,0,0"
                    Click="OnExport" ToolTip.Tip="Save the whole feed to a .json file" />
            <Button DockPanel.Dock="Right" Content="Copy" Padding="8,2"
                    Click="OnCopy" ToolTip.Tip="Copy the whole feed to the clipboard" />
            <ToggleButton x:Name="AutoScrollToggle" DockPanel.Dock="Right" Content="Auto-scroll"
                          Padding="8,2" Margin="16,0,4,0" IsChecked="True"
                          ToolTip.Tip="Scroll to new entries as they arrive" />
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Decoded Packet JSON Feed" />
        </DockPanel>

        <!-- Built like the node list's Filters dropdown rather than as a list of
             Expanders: a plain ToggleButton header over a Border that appears
             when it is checked. Fluent's Expander header is a fixed-height
             ToggleButton, so a wrapped packet summary was clipped, and the
             ListBox around them virtualised — with rows that change height when
             opened, its estimated extent moved under the scrollbar on every
             expand and every trim. A non-virtualising ItemsControl in one
             ScrollViewer has an exact extent, which is what lets the offset
             below be corrected precisely. -->
        <Border Grid.Row="1"
                Background="{DynamicResource BrushPanelBackground}"
                BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
            <ScrollViewer x:Name="JsonScroll" Padding="4,3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="JsonList" ItemsSource="{Binding DecodedPacketJsonEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:DecodedPacketJsonEntry">
                            <!-- Collapsed by default: the feed is scanned by header,
                                 and each body is a full packet dump. IsExpanded is
                                 bound so the open state rides on the entry, not on
                                 the row that happens to show it. -->
                            <StackPanel Margin="0,0,0,3">
                                <ToggleButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Padding="4,2" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                              IsCheckedChanged="OnEntryExpansionChanged">
                                    <DockPanel>
                                        <Panel DockPanel.Dock="Right" Margin="6,0,0,0">
                                            <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrushSubtle}"
                                                       IsVisible="{Binding !IsExpanded}" />
                                            <TextBlock Text="▴" FontSize="9" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrushSubtle}"
                                                       IsVisible="{Binding IsExpanded}" />
                                        </Panel>
                                        <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                                   Text="{Binding Header}" />
                                    </DockPanel>
                                </ToggleButton>
                                <Border IsVisible="{Binding IsExpanded}"
                                        Margin="10,3,0,4" Padding="6"
                                        Background="{DynamicResource BrushAppBackground}"
                                        BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                                    <SelectableTextBlock FontFamily="Consolas" FontSize="11"
                                                         TextWrapping="Wrap" Text="{Binding DisplayJson}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
