<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MeshRF.AvaloniaApp"
             x:Class="MeshRF.AvaloniaApp.MapPanel"
             x:DataType="local:RadioViewModel"
             ClipToBounds="True">
    <UserControl.Styles>
        <!-- Fluent paints a button's fill through its inner ContentPresenter
             per visual state, ignoring the button's own Background, so the
             states have to be coloured there or they fall back to the stock
             light brushes. -->
        <Style Selector="ToggleButton#WaypointToggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
        </Style>
        <Style Selector="ToggleButton#WaypointToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
        </Style>
        <Style Selector="ToggleButton#WaypointToggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
        </Style>
        <Style Selector="ToggleButton#WaypointToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
        </Style>
        <Style Selector="ToggleButton#WaypointToggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <!-- Base layer: the custom-drawn slippy map. Everything below is
             chrome floating over it. -->
        <local:MapCanvas x:Name="Canvas" />

        <TextBlock x:Name="AttributionText"
                   IsHitTestVisible="False"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,4,2" FontSize="10" Foreground="#AAFFFFFF" />

        <!-- Zoom / view controls -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="8" Padding="2" Background="#CC202020" CornerRadius="3">
            <StackPanel Orientation="Vertical" Spacing="2">
                <Button Content="+" Width="28" Height="28" FontSize="16" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="OnZoomIn" ToolTip.Tip="Zoom in" />
                <Button Content="–" Width="28" Height="28" FontSize="16" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="OnZoomOut" ToolTip.Tip="Zoom out" />
                <Button Content="⌂" Width="28" Height="28" FontSize="14" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="OnGoHome" ToolTip.Tip="Go to location" />
                <Button Content="⛶" Width="28" Height="28" FontSize="12" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="OnFitAll" ToolTip.Tip="Fit all visible nodes" />
                <ToggleButton x:Name="FollowHomeButton" Width="28" Height="28" FontSize="12" Padding="0"
                              Content="◎"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              IsCheckedChanged="OnFollowHomeToggle" ToolTip.Tip="Follow GPS / location" />
                <ToggleButton x:Name="ClusterNodesButton" Width="28" Height="28" FontSize="12" Padding="0"
                              Content="⁙" IsChecked="True"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              IsCheckedChanged="OnClusterToggle" ToolTip.Tip="Cluster overlapping nodes" />
            </StackPanel>
        </Border>

        <!-- Label / tile selectors -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="44,8,0,0" Padding="6,5"
                Background="#CC202020" CornerRadius="3"
                BorderBrush="#553A3A3A" BorderThickness="1">
            <StackPanel Orientation="Vertical" Width="160">
                <TextBlock Text="Map label" FontSize="11" Margin="0,0,0,3" Foreground="#DDDDDD" />
                <ComboBox x:Name="LabelModeCombo" Height="24" FontSize="11"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding MapNodeLabelModeOptions}"
                          SelectedItem="{Binding MapNodeLabelMode, Mode=TwoWay}"
                          ToolTip.Tip="Label shown on map markers; falls back to node number when data is unavailable" />
                <TextBlock Text="Show" FontSize="11" Margin="0,6,0,3" Foreground="#DDDDDD" />
                <ComboBox x:Name="MarkerFilterCombo" Height="24" FontSize="11"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding MapMarkerFilterOptions}"
                          SelectedItem="{Binding MapMarkerFilter, Mode=TwoWay}"
                          ToolTip.Tip="Which markers the map draws. Your own location is always shown." />
                <TextBlock Text="Map tiles" FontSize="11" Margin="0,6,0,3" Foreground="#DDDDDD" />
                <ComboBox x:Name="MapTileThemeCombo" Height="24" FontSize="11"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="OnMapTileThemeChanged"
                          ToolTip.Tip="Tile provider for the basemap" />
            </StackPanel>
        </Border>

        <!-- New-waypoint composer: what Ctrl+left-click sends.
             Deliberately not an Expander. Fluent's Expander header paints its
             hover fill through inner template presenters that don't span the
             whole header, which over a dark map showed as mismatched patches.
             A plain ToggleButton plus a Border is fully colour-controlled. -->
        <!-- Docked rather than stacked so the open panel is bounded by the map's
             height and scrolls, instead of overflowing and being clipped. -->
        <DockPanel HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="8" Width="232">
            <ToggleButton x:Name="WaypointToggle" DockPanel.Dock="Top" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" Padding="6,2"
                          Background="{DynamicResource BrushPanelBackground}"
                          BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                <DockPanel>
                    <Panel DockPanel.Dock="Right">
                        <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushSubtle}"
                                   IsVisible="{Binding !#WaypointToggle.IsChecked}" />
                        <TextBlock Text="▴" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushSubtle}"
                                   IsVisible="{Binding #WaypointToggle.IsChecked}" />
                    </Panel>
                    <TextBlock Text="Waypoint" VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushAppForeground}" />
                </DockPanel>
            </ToggleButton>

            <Border IsVisible="{Binding #WaypointToggle.IsChecked}" VerticalAlignment="Top"
                    Background="{DynamicResource BrushPanelBackground}"
                    BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1,0,1,1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical" Width="220" Margin="6,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="WP" VerticalAlignment="Center" />
                        <Button x:Name="EmojiButton" Width="28" Height="28" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Content="{Binding WaypointIconGlyph}"
                                Click="OnPickEmoji"
                                ToolTip.Tip="Click to pick waypoint emoji" />
                        <Button Content="Clear" VerticalAlignment="Center"
                                Command="{Binding ClearWaypointIconCommand}"
                                ToolTip.Tip="Send the waypoint with no icon at all" />
                    </StackPanel>

                    <TextBlock Text="Name" Margin="0,6,0,0" />
                    <TextBox Margin="0,2,0,0" Text="{Binding WaypointNameInput, Mode=TwoWay}"
                             ToolTip.Tip="Waypoint name for new Ctrl+left-click waypoints" />

                    <TextBlock Text="Description" Margin="0,6,0,0" />
                    <TextBox Margin="0,2,0,0" Text="{Binding WaypointDescriptionInput, Mode=TwoWay}"
                             ToolTip.Tip="Waypoint description for new Ctrl+left-click waypoints" />

                    <CheckBox Content="Lock to me" Margin="0,6,0,0"
                              IsChecked="{Binding WaypointLockToMe, Mode=TwoWay}"
                              ToolTip.Tip="Sets Waypoint.locked_to to your node number, so compliant clients refuse edits/deletes from other nodes" />

                    <CheckBox Content="Set expiration" Margin="0,6,0,0"
                              IsChecked="{Binding UseWaypointExpiry, Mode=TwoWay}" />
                    <StackPanel Orientation="Vertical" Margin="0,2,0,0" Spacing="4"
                                IsEnabled="{Binding UseWaypointExpiry}">
                        <DatePicker SelectedDate="{Binding WaypointExpiryDate, Mode=TwoWay}" />
                        <TimePicker ClockIdentifier="12HourClock" UseSeconds="True"
                                    SelectedTime="{Binding WaypointExpiryTime, Mode=TwoWay}" />
                    </StackPanel>

                    <CheckBox Content="Add geofence" Margin="0,6,0,0"
                              IsChecked="{Binding UseWaypointGeofence, Mode=TwoWay}"
                              ToolTip.Tip="Attach a circular geofence to this waypoint (Waypoint.geofence_radius)" />
                    <StackPanel Orientation="Vertical" Margin="0,2,0,0" Spacing="2"
                                IsEnabled="{Binding UseWaypointGeofence}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding WaypointGeofenceRadiusLabel}" VerticalAlignment="Center" />
                            <TextBox Width="80" Text="{Binding WaypointGeofenceRadiusInput, Mode=TwoWay}"
                                     ToolTip.Tip="Circular geofence radius, in your selected display units. Sent as metres, which is what Waypoint.geofence_radius carries." />
                        </StackPanel>
                        <CheckBox Content="Notify on enter" IsChecked="{Binding WaypointNotifyOnEnter, Mode=TwoWay}" />
                        <CheckBox Content="Notify on exit" IsChecked="{Binding WaypointNotifyOnExit, Mode=TwoWay}" />
                        <CheckBox Content="Favorites only" IsChecked="{Binding WaypointNotifyFavoritesOnly, Mode=TwoWay}"
                                  ToolTip.Tip="Only raise enter/exit notifications for nodes marked as favorites (per receiver)" />
                    </StackPanel>

                    <CheckBox Content="Add bounding box geofence" Margin="0,6,0,0"
                              IsChecked="{Binding UseWaypointBoundingBox, Mode=TwoWay}"
                              ToolTip.Tip="Attach a rectangular geofence to this waypoint (Waypoint.bounding_box). May be combined with the circular radius above." />
                    <StackPanel Orientation="Vertical" Margin="0,2,0,0" Spacing="4"
                                IsEnabled="{Binding UseWaypointBoundingBox}">
                        <ToggleButton Content="Pick corners on map" HorizontalAlignment="Left"
                                      IsChecked="{Binding IsPickingWaypointBoundingBox, Mode=TwoWay}"
                                      IsCheckedChanged="OnPickBoundingBoxCornersToggled"
                                      ToolTip.Tip="Click, then click two opposite corners on the map (no Ctrl needed while this is on)" />
                        <TextBlock Text="{Binding WaypointBoundingBoxSummary}" TextWrapping="Wrap" />
                        <Button Content="Clear box" HorizontalAlignment="Left"
                                Command="{Binding ClearWaypointBoundingBoxCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
