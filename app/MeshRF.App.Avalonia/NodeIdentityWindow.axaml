<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeshRF.AvaloniaApp"
        x:Class="MeshRF.AvaloniaApp.NodeIdentityWindow"
        x:DataType="local:RadioViewModel"
        Title="My Node — Identity &amp; Settings"
        Width="560" Height="640"
        MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushAppBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="12" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Node ID" Margin="0,4,8,4" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4,0,4" FontFamily="Consolas" IsReadOnly="True"
                     Foreground="{DynamicResource BrushSubtle}"
                     ToolTip.Tip="Derived from the public key, the way Meshtastic derives it. Generate a new key pair below to change it — a node number that does not hash back to its own key is the case the Nodes table flags as a mismatch."
                     Text="{Binding MyNodeIdText}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="MAC address" Margin="0,4,8,4" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" FontFamily="Consolas" IsReadOnly="True"
                     Foreground="{DynamicResource BrushSubtle}"
                     ToolTip.Tip="Derived from node ID (02:00 + last 4 bytes). Set the node ID to change this."
                     Text="{Binding MyMacAddress}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Long name" Margin="0,4,8,4" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,4" Text="{Binding MyLongName}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Short name" Margin="0,4,8,4" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,4" MaxLength="4" Text="{Binding MyShortName}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Role" Margin="0,4,8,4" VerticalAlignment="Center" />
            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4,0,4" HorizontalAlignment="Left" Width="160"
                      ItemsSource="{Binding NodeRoleOptions}" SelectedItem="{Binding MyRole}" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Licensed" Margin="0,4,8,4" VerticalAlignment="Center" />
            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,4,0,4">
                <CheckBox Content="Operate under amateur radio (ham) rules" IsChecked="{Binding MyIsLicensed}"
                          ToolTip.Tip="Encryption isn't permitted on amateur allocations, so PKC direct messages are disabled, rebroadcast is forced to local-only, traffic for nodes known to be unlicensed isn't relayed, and transmit is blocked on any channel that still has a PSK. Your Long name is transmitted as the call sign, exactly as Meshtastic firmware stores it." />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11"
                           Foreground="#E0A030"
                           IsVisible="{Binding HasLicensedEncryptedChannelWarning}"
                           Text="{Binding LicensedEncryptedChannelWarning}" />
            </StackPanel>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Unmessagable" Margin="0,4,8,4" VerticalAlignment="Center" />
            <CheckBox Grid.Row="6" Grid.Column="1" Margin="0,4,0,4" VerticalAlignment="Center"
                      Content="Advertise that this node shouldn't be messaged"
                      IsChecked="{Binding MyIsUnmessagable}"
                      ToolTip.Tip="Informational only — nothing here refuses an incoming DM. Some roles set this for you." />

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Hardware" Margin="0,4,8,4" VerticalAlignment="Center" />
            <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,4,0,4" HorizontalAlignment="Left" Width="200"
                      ItemsSource="{Binding HwModelOptions}" SelectedItem="{Binding MyHwModel}" />

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Public key" Margin="0,4,8,4" VerticalAlignment="Center" />
            <TextBox Grid.Row="8" Grid.Column="1" Margin="0,4,0,4" FontFamily="Consolas" IsReadOnly="True"
                     ToolTip.Tip="Derived from private key — not editable" Text="{Binding MyPublicKey}" />

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Private key" Margin="0,4,8,4" VerticalAlignment="Center" />
            <DockPanel Grid.Row="9" Grid.Column="1" Margin="0,4,0,4">
                <Button DockPanel.Dock="Right" Content="Generate" Margin="6,0,0,0" Padding="8,2"
                        Command="{Binding GenerateKeyPairCommand}" ToolTip.Tip="Generate a new random key pair. This also changes the node ID, which is derived from it — the mesh will see a different node." />
                <Button DockPanel.Dock="Right" Content="Show" Margin="6,0,0,0" Padding="8,2"
                        IsVisible="{Binding IsPrivateKeyHidden}"
                        Command="{Binding ToggleRevealPrivateKeyCommand}" ToolTip.Tip="Reveal the private key" />
                <Button DockPanel.Dock="Right" Content="Hide" Margin="6,0,0,0" Padding="8,2"
                        IsVisible="{Binding IsPrivateKeyRevealed}"
                        Command="{Binding ToggleRevealPrivateKeyCommand}" ToolTip.Tip="Hide the private key" />
                <Panel>
                    <TextBox FontFamily="Consolas" IsVisible="{Binding IsPrivateKeyRevealed}"
                             ToolTip.Tip="Base64 X25519 private key (kept locally)" Text="{Binding MyPrivateKey}" />
                    <TextBox FontFamily="Consolas" IsReadOnly="True" Focusable="False"
                             IsVisible="{Binding IsPrivateKeyHidden}"
                             ToolTip.Tip="Private key is hidden — click Show to reveal or edit"
                             Text="●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●●" />
                </Panel>
            </DockPanel>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Firmware" Margin="0,4,8,4" VerticalAlignment="Center" />
            <Grid Grid.Row="10" Grid.Column="1" Margin="0,4,0,4" ColumnDefinitions="*,6,*">
                <TextBox Grid.Column="0" Text="{Binding MyFirmwareVersion}"
                         ToolTip.Tip="Self-reported firmware version. MeshRF isn't real Meshtastic firmware — this is the compatibility baseline it presents." />
                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding FirmwareEditionOptions}" SelectedItem="{Binding MyFirmwareEdition}"
                          ToolTip.Tip="Self-reported firmware edition" />
            </Grid>

            <TextBlock Grid.Row="11" Grid.Column="0" Text="Rebroadcast" Margin="0,4,8,4" VerticalAlignment="Center" />
            <ComboBox Grid.Row="11" Grid.Column="1" Margin="0,4,0,4" HorizontalAlignment="Left" Width="200"
                      ItemsSource="{Binding RebroadcastModeOptions}" SelectedItem="{Binding RebroadcastMode}"
                      ToolTip.Tip="Which traffic this node rebroadcasts when relay routing is enabled. Some roles override this, and licensed operation forces local-only." />

            <TextBlock Grid.Row="12" Grid.Column="0" Text="Routing" Margin="0,4,8,4" VerticalAlignment="Center" />
            <CheckBox Grid.Row="12" Grid.Column="1" Margin="0,4,0,4" VerticalAlignment="Center"
                      Content="Enable relay routing (role + rebroadcast mode)"
                      IsChecked="{Binding RoutingRelayEnabled}"
                      ToolTip.Tip="Rebroadcast other nodes' traffic, subject to the role and rebroadcast mode above. Needs a TX-capable device." />

            <TextBlock Grid.Row="13" Grid.Column="0" Text="Location source" Margin="0,4,8,4" VerticalAlignment="Center" />
            <StackPanel Grid.Row="13" Grid.Column="1" Margin="0,4,0,4">
                <ComboBox HorizontalAlignment="Left" Width="160"
                          ItemsSource="{Binding HomeLocationSourceOptions}" SelectedItem="{Binding HomeLocationSource}"
                          ToolTip.Tip="Choose between a fixed manual location and an auto-detected USB serial GPS." />
                <Grid Margin="0,6,0,0" ColumnDefinitions="*,110" IsEnabled="{Binding IsUsbSerialLocationSource}">
                    <TextBox Grid.Column="0" Margin="0,0,4,0" FontFamily="Consolas" PlaceholderText="COM5"
                             Text="{Binding GpsSerialPort}" ToolTip.Tip="Optional COM port override; blank = auto-detect" />
                    <TextBox Grid.Column="1" Margin="4,0,0,0" FontFamily="Consolas" PlaceholderText="9600"
                             Text="{Binding GpsBaudRateText}" ToolTip.Tip="Optional baud override; blank = auto-detect" />
                </Grid>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource BrushSubtle}" Text="{Binding GpsStatus}" />
            </StackPanel>

            <!-- Row 14 sits under Location source because it only governs the
                 serial GPS: the manual boxes are typed, not streamed. -->
            <TextBlock Grid.Row="14" Grid.Column="0" Text="Smart position" Margin="0,4,8,4" VerticalAlignment="Center" />
            <StackPanel Grid.Row="14" Grid.Column="1" Margin="0,4,0,4" Orientation="Horizontal" Spacing="4"
                        IsEnabled="{Binding IsUsbSerialLocationSource}">
                <CheckBox Content="Enabled" VerticalAlignment="Center" IsChecked="{Binding GpsSmartPosition}"
                          ToolTip.Tip="Only take a fix that is both far enough from the last one taken and long enough after it. A receiver reports every second and wanders while standing still; without this the marker twitches in place and the settings file is rewritten all day." />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding GpsSmartPositionMinMoveLabel}" />
                <TextBox Width="60" FontFamily="Consolas" Text="{Binding GpsSmartPositionMinMoveInput}"
                         ToolTip.Tip="How far the receiver must have moved since the last fix taken. Distance accumulates, so a slow walk still gets there." />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Min gap" />
                <TextBox Width="60" FontFamily="Consolas" Text="{Binding GpsSmartPositionMinSeconds}"
                         ToolTip.Tip="Shortest time between two fixes being taken, measured from the last one taken." />
                <TextBlock VerticalAlignment="Center" Text="sec" />
            </StackPanel>

            <TextBlock Grid.Row="15" Grid.Column="0" Text="{Binding HomeAltitudeLabel}" Margin="0,4,8,4" VerticalAlignment="Center" />
            <Grid Grid.Row="15" Grid.Column="1" Margin="0,4,0,4" ColumnDefinitions="2*,2*,*"
                  IsEnabled="{Binding IsManualLocationSource}">
                <TextBox Grid.Column="0" Margin="0,0,2,0" FontFamily="Consolas"
                         ToolTip.Tip="Latitude in degrees (-90..90)" Text="{Binding HomeLatitudeText}" />
                <TextBox Grid.Column="1" Margin="2,0,2,0" FontFamily="Consolas"
                         ToolTip.Tip="Longitude in degrees (-180..180)" Text="{Binding HomeLongitudeText}" />
                <TextBox Grid.Column="2" Margin="2,0,0,0" FontFamily="Consolas"
                         ToolTip.Tip="Altitude (optional)" Text="{Binding HomeAltitudeText}" />
            </Grid>

            <TextBlock Grid.Row="16" Grid.Column="0" Text="Hop limit" Margin="0,4,8,4" VerticalAlignment="Center" />
            <DockPanel Grid.Row="16" Grid.Column="1" Margin="0,4,0,4">
                <TextBlock DockPanel.Dock="Right" Width="20" Margin="6,0,0,0" VerticalAlignment="Center"
                           TextAlignment="Center" Text="{Binding HopLimit}" />
                <Slider Minimum="1" Maximum="7" TickFrequency="1" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" Value="{Binding HopLimit}"
                        ToolTip.Tip="Hops a transmitted packet may travel (1..7). Meshtastic default is 3." />
            </DockPanel>

            <TextBlock Grid.Row="17" Grid.Column="0" Text="Ignore MQTT" Margin="0,4,8,4" VerticalAlignment="Center" />
            <CheckBox Grid.Row="17" Grid.Column="1" Margin="0,4,0,4" VerticalAlignment="Center"
                      Content="Don't relay traffic from nodes heard via MQTT"
                      IsChecked="{Binding IgnoreMqtt}"
                      ToolTip.Tip="While on, the relay never rebroadcasts a packet that arrived via MQTT downlink, or anything from a node marked heard-via-MQTT — mirrors firmware's ignore_mqtt. Off by default: relaying downlinked traffic onto RF is what makes a downlink gateway a gateway." />

            <TextBlock Grid.Row="18" Grid.Column="0" Text="OK to MQTT" Margin="0,4,8,4" VerticalAlignment="Center" />
            <CheckBox Grid.Row="18" Grid.Column="1" Margin="0,4,0,4" VerticalAlignment="Center"
                      Content="Allow gateways to uplink my packets to public MQTT"
                      IsChecked="{Binding OkToMqtt}" />

            <TextBlock Grid.Row="19" Grid.Column="0" Text="Status text" Margin="0,4,8,4" VerticalAlignment="Center" />
            <TextBox Grid.Row="19" Grid.Column="1" Margin="0,4,0,4" MaxLength="280" Text="{Binding MyNodeStatus}" />

            <!-- Auto-report schedules. Each fires on the poll loop once its
                 interval is up and a TX-capable device is configured. -->
            <TextBlock Grid.Row="20" Grid.Column="0" Text="Auto node info" Margin="0,4,8,4" VerticalAlignment="Center" />
            <StackPanel Grid.Row="20" Grid.Column="1" Margin="0,4,0,4" Orientation="Horizontal" Spacing="4">
                <CheckBox Content="Enabled" VerticalAlignment="Center" IsChecked="{Binding AutoReportNodeInfoEnabled}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Interval" />
                <TextBox Width="60" FontFamily="Consolas" Text="{Binding AutoReportNodeInfoSeconds}" />
                <TextBlock VerticalAlignment="Center" Text="sec" />
            </StackPanel>

            <TextBlock Grid.Row="21" Grid.Column="0" Text="Auto position" Margin="0,4,8,4" VerticalAlignment="Center" />
            <StackPanel Grid.Row="21" Grid.Column="1" Margin="0,4,0,4" Orientation="Horizontal" Spacing="4">
                <CheckBox Content="Enabled" VerticalAlignment="Center" IsChecked="{Binding AutoReportPositionEnabled}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Interval" />
                <TextBox Width="60" FontFamily="Consolas" Text="{Binding AutoReportPositionSeconds}" />
                <TextBlock VerticalAlignment="Center" Text="sec" />
            </StackPanel>

            <TextBlock Grid.Row="22" Grid.Column="0" Text="Auto device metrics" Margin="0,4,8,4" VerticalAlignment="Center" />
            <StackPanel Grid.Row="22" Grid.Column="1" Margin="0,4,0,4" Orientation="Horizontal" Spacing="4">
                <CheckBox Content="Enabled" VerticalAlignment="Center" IsChecked="{Binding AutoReportDeviceMetricsEnabled}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Interval" />
                <TextBox Width="60" FontFamily="Consolas" Text="{Binding AutoReportDeviceMetricsSeconds}" />
                <TextBlock VerticalAlignment="Center" Text="sec" />
            </StackPanel>

            <TextBlock Grid.Row="23" Grid.Column="0" Text="Auto env telemetry" Margin="0,4,8,4" VerticalAlignment="Center" />
            <StackPanel Grid.Row="23" Grid.Column="1" Margin="0,4,0,4" Orientation="Horizontal" Spacing="4">
                <CheckBox Content="Enabled" VerticalAlignment="Center" IsChecked="{Binding AutoReportEnvironmentMetricsEnabled}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Interval" />
                <TextBox Width="60" FontFamily="Consolas" Text="{Binding AutoReportEnvironmentMetricsSeconds}" />
                <TextBlock VerticalAlignment="Center" Text="sec" />
            </StackPanel>

            <TextBlock Grid.Row="24" Grid.Column="0" Text="Auto AQ telemetry" Margin="0,4,8,4" VerticalAlignment="Center" />
            <StackPanel Grid.Row="24" Grid.Column="1" Margin="0,4,0,4" Orientation="Horizontal" Spacing="4">
                <CheckBox Content="Enabled" VerticalAlignment="Center" IsChecked="{Binding AutoReportAirQualityMetricsEnabled}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Interval" />
                <TextBox Width="60" FontFamily="Consolas" Text="{Binding AutoReportAirQualityMetricsSeconds}" />
                <TextBlock VerticalAlignment="Center" Text="sec" />
            </StackPanel>

            <TextBlock Grid.Row="25" Grid.Column="0" Text="Auto status" Margin="0,4,8,4" VerticalAlignment="Center" />
            <StackPanel Grid.Row="25" Grid.Column="1" Margin="0,4,0,4" Orientation="Horizontal" Spacing="4">
                <CheckBox Content="Enabled" VerticalAlignment="Center" IsChecked="{Binding AutoReportNodeStatusEnabled}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Interval" />
                <TextBox Width="60" FontFamily="Consolas" Text="{Binding AutoReportNodeStatusSeconds}" />
                <TextBlock VerticalAlignment="Center" Text="sec" />
            </StackPanel>

            <TextBlock Grid.Row="26" Grid.Column="1" Margin="0,2,0,6" FontFamily="Consolas" FontSize="11"
                       TextWrapping="Wrap" Foreground="{DynamicResource BrushSubtle}"
                       Text="{Binding AutoReportLastSentSummary}"
                       ToolTip.Tip="Last successful auto-send times for NodeInfo, Position, Device Metrics, Environment Metrics, Air Quality, and Status." />

            <TextBlock Grid.Row="27" Grid.Column="0" Text="Weather status" Margin="0,4,8,4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="27" Grid.Column="1" Margin="0,4,0,4" FontFamily="Consolas" FontSize="11"
                       TextWrapping="Wrap" Foreground="{DynamicResource BrushSubtle}"
                       Text="{Binding WeatherTelemetryStatus}"
                       ToolTip.Tip="Live status of weather fetches used for environment telemetry (Open-Meteo)." />

            <TextBlock Grid.Row="28" Grid.Column="0" Text="AQ status" Margin="0,4,8,4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="28" Grid.Column="1" Margin="0,4,0,4" FontFamily="Consolas" FontSize="11"
                       TextWrapping="Wrap" Foreground="{DynamicResource BrushSubtle}"
                       Text="{Binding AirQualityTelemetryStatus}"
                       ToolTip.Tip="Live status of air quality fetches used for air quality telemetry (Open-Meteo AQ API)." />

            <TextBlock Grid.Row="29" Grid.Column="1" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushSubtle}"
                       Text="Relay routing rebroadcasts other nodes' traffic after a contention delay, following the role and rebroadcast mode above. It needs a TX-capable device, and stays off entirely while the Routing box is unchecked." />
        </Grid>
    </ScrollViewer>
</Window>
