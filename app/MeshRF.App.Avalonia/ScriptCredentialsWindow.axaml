<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:MeshRF.AvaloniaApp"
        x:Class="MeshRF.AvaloniaApp.ScriptCredentialsWindow"
        x:DataType="app:ScriptCredentialsViewModel"
        Title="Script Credentials"
        Width="620" Height="480"
        MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushAppBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource BrushSubtle}" FontSize="11"
                   Text="API keys a script's http: action can authenticate with. A script names a credential — the values never appear in a script file, are never readable as a placeholder, and are never written to the log, so a script cannot broadcast its own key. Values are stored protected alongside the MQTT password. An API issuing a pair (a client id and a client secret) is one credential: fill in the second parameter and value as well." />

        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Add" Padding="10,3" Margin="0,0,4,0" Click="OnAdd" />
            <Button DockPanel.Dock="Left" Content="Remove" Padding="10,3"
                    IsEnabled="{Binding HasSelection}" Click="OnRemove" />
        </DockPanel>

        <Grid Grid.Row="2" ColumnDefinitions="220,4,*">

            <Border Grid.Column="0" BorderThickness="1" CornerRadius="3"
                    BorderBrush="{DynamicResource BrushPanelBorder}"
                    Background="{DynamicResource BrushPanelBackground}">
                <ListBox Name="CredentialList" Background="Transparent"
                         ItemsSource="{Binding Credentials}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="app:ScriptCredentialItem">
                            <StackPanel Margin="0,1">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" FontSize="10" FontFamily="Consolas"
                                           Foreground="{DynamicResource BrushSubtle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource BrushSplitter}" />

            <ScrollViewer Grid.Column="2" Margin="8,0,0,0" IsVisible="{Binding HasSelection}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="0,4,8,4" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4,0,4" FontFamily="Consolas"
                             Text="{Binding Selected.Name, Mode=TwoWay}"
                             ToolTip.Tip="What a script writes after credential: — letters, digits, dashes." />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Attach as" Margin="0,4,8,4" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Placements}"
                              SelectedItem="{Binding Selected.Placement, Mode=TwoWay}"
                              ToolTip.Tip="Bearer token, a named header, or a query-string parameter." />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Parameter" Margin="0,4,8,4" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,0,4" FontFamily="Consolas"
                             IsEnabled="{Binding Selected.NeedsParameter}"
                             PlaceholderText="{Binding Selected.ParameterHint}"
                             Text="{Binding Selected.Parameter, Mode=TwoWay}"
                             ToolTip.Tip="Header name (e.g. X-API-Key) or query parameter name (e.g. appid). Not used for a bearer token." />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Value" Margin="0,4,8,4" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,4,0,4">
                        <Button DockPanel.Dock="Right" Content="Show" Margin="6,0,0,0" Padding="8,2"
                                IsVisible="{Binding IsValueHidden}" Click="OnToggleReveal" />
                        <Button DockPanel.Dock="Right" Content="Hide" Margin="6,0,0,0" Padding="8,2"
                                IsVisible="{Binding IsValueRevealed}" Click="OnToggleReveal" />
                        <TextBox FontFamily="Consolas" PasswordChar="●"
                                 RevealPassword="{Binding IsValueRevealed}"
                                 Text="{Binding Selected.Value, Mode=TwoWay}" />
                    </DockPanel>

                    <!-- Second half, for an API issuing an id and a secret. One
                         entry rather than two, because they are issued and
                         rotated together and are useless apart. Left blank for
                         an ordinary single-secret credential. -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="2nd parameter" Margin="0,4,8,4" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4,0,4" FontFamily="Consolas"
                             IsEnabled="{Binding Selected.NeedsParameter}"
                             PlaceholderText="{Binding Selected.Parameter2Hint}"
                             Text="{Binding Selected.Parameter2, Mode=TwoWay}"
                             ToolTip.Tip="Only for an API that wants two, e.g. client_id and client_secret. Leave empty otherwise." />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="2nd value" Margin="0,4,8,4" VerticalAlignment="Center" />
                    <!-- Its own Show/Hide, sharing the one reveal flag: the two
                         halves are a single credential, so revealing either
                         reveals both. Without a button here the row looks
                         permanently masked even while it isn't. -->
                    <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,4,0,4">
                        <Button DockPanel.Dock="Right" Content="Show" Margin="6,0,0,0" Padding="8,2"
                                IsVisible="{Binding IsValueHidden}" Click="OnToggleReveal" />
                        <Button DockPanel.Dock="Right" Content="Hide" Margin="6,0,0,0" Padding="8,2"
                                IsVisible="{Binding IsValueRevealed}" Click="OnToggleReveal" />
                        <TextBox FontFamily="Consolas" PasswordChar="●"
                                 IsEnabled="{Binding Selected.NeedsParameter}"
                                 RevealPassword="{Binding IsValueRevealed}"
                                 Text="{Binding Selected.Value2, Mode=TwoWay}" />
                    </DockPanel>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="In a script" Margin="0,10,8,4" VerticalAlignment="Top" />
                    <SelectableTextBlock Grid.Row="6" Grid.Column="1" Margin="0,10,0,4"
                                         FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                         Foreground="{DynamicResource BrushSubtle}"
                                         Text="{Binding UsageExample}" />
                </Grid>
            </ScrollViewer>

            <TextBlock Grid.Column="2" IsVisible="{Binding HasNoSelection}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource BrushSubtle}"
                       Text="Add a credential, or pick one to edit." />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0" Spacing="6"
                    HorizontalAlignment="Right">
            <TextBlock VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0"
                       Foreground="#FF6B6B" IsVisible="{Binding HasError}"
                       Text="{Binding Error}" />
            <Button Content="Close" Padding="12,4" IsDefault="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
