<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:MeshRF.AvaloniaApp"
        x:Class="MeshRF.AvaloniaApp.ScriptCredentialsWindow"
        x:DataType="app:ScriptCredentialsViewModel"
        Title="Script Credentials"
        Width="820" Height="440"
        MinWidth="640" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushAppBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource BrushSubtle}" FontSize="11"
                   Text="API keys a script's http: action can authenticate with. A script names one or more; the values never appear in a script file, are never readable as a placeholder, and are never written to the log, so a script cannot broadcast its own key. Stored protected alongside the MQTT password. An API wanting an id and a secret needs a row for each — reference both with credential: [id-row, secret-row]." />

        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Add" Padding="10,3" Margin="0,0,4,0" Click="OnAdd"
                    ToolTip.Tip="Add a row" />
            <Button DockPanel.Dock="Left" Content="Add pair" Padding="10,3" Margin="0,0,4,0" Click="OnAddPair"
                    ToolTip.Tip="Add two rows at once, for an API that wants a client id and a client secret" />
            <Button DockPanel.Dock="Left" Content="Remove" Padding="10,3"
                    IsEnabled="{Binding HasSelection}" Click="OnRemove" />
            <CheckBox DockPanel.Dock="Right" Content="Show values" VerticalAlignment="Center"
                      IsChecked="{Binding IsValueRevealed, Mode=TwoWay}" />
        </DockPanel>

        <Border Grid.Row="2" BorderThickness="1" CornerRadius="3"
                BorderBrush="{DynamicResource BrushPanelBorder}"
                Background="{DynamicResource BrushPanelBackground}">
            <DataGrid Name="CredentialGrid"
                      ItemsSource="{Binding Credentials}"
                      SelectedItem="{Binding Selected, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent">
                <DataGrid.Columns>
                    <!-- Template columns holding live controls rather than the
                         grid's own edit machinery: these are settings, and
                         having to commit each cell to see the next one is
                         friction for no benefit. -->
                    <DataGridTemplateColumn Header="Name" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="app:ScriptCredentialItem">
                                <TextBox Margin="2" FontFamily="Consolas" BorderThickness="0"
                                         Background="Transparent"
                                         Text="{Binding Name, Mode=TwoWay}"
                                         ToolTip.Tip="What a script writes after credential:" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Attach as" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="app:ScriptCredentialItem">
                                <ComboBox Margin="2" HorizontalAlignment="Stretch" BorderThickness="0"
                                          Background="Transparent"
                                          ItemsSource="{Binding $parent[Window].((app:ScriptCredentialsViewModel)DataContext).Placements}"
                                          SelectedItem="{Binding Placement, Mode=TwoWay}"
                                          ToolTip.Tip="Bearer token, a named header, or a query-string parameter" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Parameter" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="app:ScriptCredentialItem">
                                <TextBox Margin="2" FontFamily="Consolas" BorderThickness="0"
                                         Background="Transparent"
                                         IsEnabled="{Binding NeedsParameter}"
                                         PlaceholderText="{Binding ParameterHint}"
                                         Text="{Binding Parameter, Mode=TwoWay}"
                                         ToolTip.Tip="Header name (X-API-Key) or query parameter name (client_id). Not used for a bearer token." />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Value" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="app:ScriptCredentialItem">
                                <TextBox Margin="2" FontFamily="Consolas" BorderThickness="0"
                                         Background="Transparent" PasswordChar="●"
                                         RevealPassword="{Binding $parent[Window].((app:ScriptCredentialsViewModel)DataContext).IsValueRevealed}"
                                         Text="{Binding Value, Mode=TwoWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock FontSize="11" Foreground="#FF6B6B" TextWrapping="Wrap"
                           IsVisible="{Binding HasError}" Text="{Binding Error}" />
                <SelectableTextBlock FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"
                                     Foreground="{DynamicResource BrushSubtle}"
                                     IsVisible="{Binding HasUsage}" Text="{Binding UsageExample}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Close" Padding="12,4" IsDefault="True" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
