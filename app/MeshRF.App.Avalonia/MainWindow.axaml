<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeshRF.AvaloniaApp"
        xmlns:mesh="clr-namespace:MeshRF;assembly=MeshRF.Core"
        xmlns:nodes="clr-namespace:MeshRF.Nodes;assembly=MeshRF.Core"
        xmlns:scripting="clr-namespace:MeshRF.Scripting;assembly=MeshRF.Core"
        xmlns:waypoints="clr-namespace:MeshRF.Waypoints;assembly=MeshRF.Core"
        x:Class="MeshRF.AvaloniaApp.MainWindow"
        x:Name="RootWindow"
        x:DataType="local:RadioViewModel"
        Title="MeshRF"
        Width="1280" Height="900">

    <Window.Styles>
        <!-- Unseen-activity pulse on a tab header. Alternating playback fades
             out and back rather than snapping, and it runs until the tab is
             selected and the view model clears TabNeedsAttention. -->
        <!-- Reaction chips are buttons but should read as inline tags, so the
             stock button chrome is stripped back to a hover cue. They sit on a
             bubble rather than a panel, so the fill is the list background:
             darker than either bubble tint, which is what makes a chip read as
             set into the bubble instead of floating on it. -->
        <Style Selector="Button.reactionChip">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.reactionChip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Button.reactionChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
        </Style>

        <!-- Chat bubbles. Tint and border are set here rather than on the
             template's Border so the .outgoing class can swap both, and hover
             lifts the whole bubble as one target — it is what carries the
             reply / react context menu. -->
        <Style Selector="Border.bubble">
            <Setter Property="Background" Value="{DynamicResource BrushBubbleIncoming}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBubbleIncomingBorder}" />
        </Style>
        <Style Selector="Border.bubble.outgoing">
            <Setter Property="Background" Value="{DynamicResource BrushBubbleOutgoing}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBubbleOutgoingBorder}" />
        </Style>
        <Style Selector="Border.bubble:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushTabBorder}" />
        </Style>

        <!-- The message list is a transcript, not a picker: nothing acts on the
             selected row, so the selection and hover fills are cleared and the
             row padding goes to the bubble instead. Selection still works, it
             just leaves no mark behind the bubble it would fight with. -->
        <Style Selector="ListBox.chat">
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style Selector="ListBox.chat ListBoxItem">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.chat ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Channel / DM tab headers. Fluent's default is an underline cue with
             no box, which at this app's 12px type reads as a row of loose words
             rather than tabs. Padding is set on TabItem (it template-binds to
             the header presenter) while the chrome is set on the template's
             root Border: the theme's own :selected / :pointerover styles target
             that part, so setting Background/BorderBrush on TabItem itself
             would be overridden the moment a tab is selected or hovered. -->
        <!-- MinHeight is deliberately NOT forced to 0 here. Squeezing the header
             is what pulled the title down into Fluent's selection pipe, which is
             pinned to the bottom edge of the header and drew straight through
             the text. The visible box now comes from a Border inside the item
             template (see TabControl.ItemTemplate), which does not depend on
             the theme's internal part names. -->
        <!-- Horizontal Padding is 0, not the 6px this used to carry: the item
             template's Border (see TabControl.ItemTemplate) already insets its
             own content by 8px via its own Padding, so TabItem's Padding was
             adding a second, outer margin around that border rather than
             padding the text. Since the border doesn't stretch to fill it,
             each tab's outer padding stacked with its neighbour's, showing up
             as a visible gap between adjacent tab boxes rather than breathing
             room inside them. Vertical Padding stays for header height. -->
        <!-- One TabItem style, not two. A second block matching the same
             selector wins on the setters it repeats regardless of which looks
             more specific, and an earlier Margin binding was silently beaten
             by the Margin="0" here — leaving no gap, so the divider landed on
             the previous tab instead of between them.

             Margin is what opens that gap, because the tab's chrome (the
             LayoutRoot border styled below) is sized to the whole TabItem: a
             rule placed inside the header would be enclosed by the tab box
             rather than separating it from the one before. The rule is drawn
             back out into the gap with a negative margin, and ClipToBounds
             goes off for that one tab so the tab does not clip it away —
             there is no horizontal Padding here for it to sit inside. -->
        <Style Selector="TabItem" x:DataType="mesh:ITabItem">
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin"
                    Value="{Binding StartsTabGroup,
                                    Converter={x:Static local:TabGroupMarginConverter.Instance}}" />
            <Setter Property="ClipToBounds" Value="{Binding !StartsTabGroup}" />
        </Style>
        <!-- Fluent marks the selected tab with a coloured pipe pinned to the
             bottom edge of the header. With the shorter header this app uses it
             lands across the title instead of under it, and the box below makes
             it redundant anyway — selection now reads from the fill. -->
        <!-- Part names verified against Avalonia.Themes.Fluent 12.1.1 rather
             than assumed: the header root is "LayoutRoot" with no PART_ prefix,
             while the selection bar is "PART_SelectedPipe" with one. Both are
             matched by name only, without a type, so a template that swaps the
             element type still gets styled. -->
        <!-- A /template/ selector needs an element type or the setters have
             nothing to resolve against (AVLN2200), so the type cannot be left
             off even though only the name is load-bearing. The pipe is listed
             as both Border and Rectangle because the theme's choice is not
             visible from the compiled assembly; the one that does not match is
             simply inert. -->
        <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TabItem /template/ Rectangle#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TabItem /template/ Border#LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushTabBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource BrushHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushTabBorder}" />
        </Style>
        <Style Selector="TabItem:selected /template/ Border#LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource BrushAppBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushTabBorder}" />
        </Style>

        <!-- Compose byte counter: quiet until the message no longer fits,
             then the same red the app uses for an overridden value. -->
        <Style Selector="TextBlock.byteCount">
            <Setter Property="Foreground" Value="{DynamicResource BrushSubtle}" />
        </Style>
        <Style Selector="TextBlock.byteCount.over">
            <Setter Property="Foreground" Value="{DynamicResource BrushOverridden}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.attention">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Animations>
                <Animation Duration="0:0:0.45" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Window.Resources>
      <ResourceDictionary>
        <!-- Shared by both channel and DM-conversation tab content templates
             (see TabControl.Resources below) so the message list markup,
             including its reply/react context menu, isn't duplicated. -->
        <!-- Message bubble: an underlined sender · time header with the body,
             delivery mark and reaction chips stacked beneath it. Every bubble is
             left-aligned; outgoing traffic is told apart by its tint, not its
             side. -->
        <DataTemplate x:Key="MessageListTemplate" x:DataType="mesh:ITabItem">
            <ListBox Classes="chat" ItemsSource="{Binding Messages}"
                     local:AutoScrollBehavior.IsEnabled="{Binding #RootWindow.DataContext.AutoScroll}">
                <!-- Deliberately left on the default VirtualizingStackPanel.
                     This once carried a plain StackPanel, to stop the view
                     jumping when a reaction chip made a row taller. Measured
                     against Avalonia 12 with 500 rows, that trade no longer
                     holds in either direction: a TabControl rebuilds its
                     content on every switch, so a non-virtualizing panel
                     realized all 500 rows each time and roughly doubled the
                     cost of changing tabs — and it was the one that jumped,
                     when the row that grew was above the viewport rather than
                     below it. The virtualizing panel held the top row steady
                     in both cases. -->
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="mesh:ChannelMessage">
                        <!-- MaxWidth keeps a long message from stretching into a
                             full-width paragraph; the bubble otherwise shrinks to
                             its text. The squared bottom-left corner is the tail,
                             pointing at the column every bubble hangs from. -->
                        <Border Classes="bubble" Classes.outgoing="{Binding IsOutgoing}"
                                HorizontalAlignment="Left" MaxWidth="620"
                                Margin="2,3" Padding="10,5,12,7"
                                CornerRadius="12,12,12,3" BorderThickness="1"
                                ContextMenu="{DynamicResource MessageContextMenu}">
                            <Border.Resources>
                                <!-- Declared here rather than shared app-wide so each
                                     bubble gets its own instance and {Binding} resolves
                                     to that bubble's message. -->
                                <ContextMenu x:Key="MessageContextMenu">
                                    <MenuItem Header="Reply"
                                              Command="{Binding #RootWindow.DataContext.ReplyToMessageCommand}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="React…" Click="OnReactPick" />
                                    <Separator />
                                    <MenuItem Header="Copy message" Click="OnCopyMessage" />
                                </ContextMenu>
                            </Border.Resources>
                            <StackPanel>
                                <!-- One underlined header line. The separator carries
                                     the decoration too, so the rule runs unbroken
                                     across the whole line. -->
                                <StackPanel Orientation="Horizontal">
                                    <!-- Transparent, not unset: a TextBlock with no
                                         background is not hit tested, so the press
                                         would land on the bubble behind it and the
                                         double-click would never arrive. -->
                                    <TextBlock Text="{Binding FromId}" FontSize="12" FontWeight="Bold"
                                               TextDecorations="Underline"
                                               Background="Transparent"
                                               Cursor="Hand"
                                               DoubleTapped="OnMessageSenderDoubleTapped"
                                               ToolTip.Tip="{Binding FromId}" />
                                    <TextBlock Text=" · " FontSize="12" FontWeight="Bold"
                                               TextDecorations="Underline"
                                               Foreground="{DynamicResource BrushSubtle}" />
                                    <TextBlock Text="{Binding TimeLabel}" FontSize="12" FontWeight="Bold"
                                               TextDecorations="Underline"
                                               Foreground="{DynamicResource BrushSubtle}" />
                                    <!-- Marks a message the sender flagged as an alert.
                                         The bell character itself is non-printing, so
                                         without this an alert from a client that sends
                                         the bell alone would look like any other. -->
                                    <TextBlock Text="&#x00A0;&#x1F514;" FontSize="12" FontWeight="Bold"
                                               TextDecorations="Underline"
                                               IsVisible="{Binding HasAlertBell}"
                                               ToolTip.Tip="Sent as an alert - carries Meshtastic's bell character" />
                                </StackPanel>
                                <!-- SelectableTextBlock handles its own pointer input
                                     for text selection and doesn't let the request
                                     reach the Border, so it carries the menu itself —
                                     this is the part of the bubble people actually
                                     right-click. -->
                                <SelectableTextBlock local:MarkdownText.Text="{Binding DisplayText}"
                                                     local:MarkdownText.Suffix="{Binding DeliveryGlyph}"
                                                     local:MarkdownText.SuffixBrush="{Binding Delivery, Converter={StaticResource DeliveryMarkForeground}}"
                                                     Margin="0,2,0,0"
                                                     FontSize="13" TextWrapping="Wrap"
                                                     ContextMenu="{DynamicResource MessageContextMenu}" />
                                <ItemsControl ItemsSource="{Binding Reactions}" Margin="0,5,0,0"
                                              IsVisible="{Binding HasReactions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="mesh:MessageReaction">
                                            <!-- Tapping a chip sends the same reaction, so
                                                 agreeing with one costs a click instead of a
                                                 trip through the emoji picker. Tag carries the
                                                 message, which the reaction itself doesn't
                                                 reference. -->
                                            <Button Classes="reactionChip" Margin="0,0,4,0" Padding="7,1"
                                                    CornerRadius="9" FontSize="12"
                                                    BorderThickness="1"
                                                    Click="OnReactionChipTapped"
                                                    Tag="{Binding $parent[ListBoxItem].DataContext}"
                                                    ToolTip.Tip="{Binding Reactors}">
                                                <TextBlock Text="{Binding Display}" FontSize="12" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DataTemplate>
      </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Toolbar row 1: device / region / preset / slot / frequency / start-stop,
             with the About button pinned top-right (as in MeshRF.App). -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BrushPanelBackground}"
                BorderBrush="{DynamicResource BrushPanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="4,2">
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="&#x24D8;" FontSize="15"
                    Width="28" Height="26" Padding="0" Margin="6,0,0,2"
                    VerticalAlignment="Top"
                    Click="OnAbout" ToolTip.Tip="About MeshRF" />
            <WrapPanel>
                <TextBlock Text="RX" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" />
                <ComboBox ItemsSource="{Binding AvailableDevices}"
                          SelectedItem="{Binding SelectedDevice}"
                          IsEnabled="{Binding !IsRunning}"
                          FontSize="11" Width="150" Height="26" Margin="0,0,8,2"
                          ToolTip.Tip="Receive SDR backend">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="mesh:RadioDeviceKind">
                            <TextBlock Text="{Binding ., Converter={StaticResource DeviceKindLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <!-- Only shown with more than one stick attached: the EEPROM serial
                     is the only thing that tells two identical CH341 devices apart. -->
                <TextBlock Text="Stick" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2"
                           IsVisible="{Binding ShowSx1262SerialPicker}" />
                <ComboBox ItemsSource="{Binding Sx1262Serials}"
                          SelectedItem="{Binding SelectedSx1262Serial}"
                          IsEnabled="{Binding !IsRunning}"
                          IsVisible="{Binding ShowSx1262SerialPicker}"
                          FontSize="11" Width="110" Height="26" Margin="0,0,8,2"
                          ToolTip.Tip="Which SX1262 stick to use, by EEPROM serial number" />
                <TextBlock Text="Rate" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2"
                           IsVisible="{Binding HasSpectrum}" />
                <ComboBox ItemsSource="{Binding SampleRateOptions}"
                          IsVisible="{Binding HasSpectrum}"
                          SelectedItem="{Binding SelectedRxSampleRate}"
                          IsEnabled="{Binding CanSelectRxSampleRate}"
                          FontSize="11" Width="110" Height="26" Margin="0,0,8,2"
                          ToolTip.Tip="RX sample rate in MS/s; choices are limited to the selected receiver's supported rates" />
                <TextBlock Text="TX" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" />
                <ComboBox ItemsSource="{Binding AvailableTxDevices}"
                          SelectedItem="{Binding SelectedTxDevice}"
                          IsEnabled="{Binding !IsRunning}"
                          FontSize="11" Width="150" Height="26" Margin="0,0,8,2"
                          ToolTip.Tip="Transmit SDR backend; HackRF can transmit, RTL-SDR cannot">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="mesh:RadioDeviceKind">
                            <TextBlock Text="{Binding ., Converter={StaticResource DeviceKindLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border Width="1" Margin="2,2,10,6" Background="{DynamicResource BrushPanelBorder}" />
                <TextBlock Text="Region" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" />
                <ComboBox ItemsSource="{Binding AvailableRegions}"
                          SelectedItem="{Binding SelectedRegion}"
                          IsEnabled="{Binding !IsRunning}"
                          FontSize="11" Width="90" Height="26" Margin="0,0,8,2" />
                <TextBlock Text="Preset" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" />
                <ComboBox ItemsSource="{Binding AvailablePresets}"
                          SelectedItem="{Binding SelectedPreset}"
                          IsEnabled="{Binding !IsRunning}"
                          FontSize="11" Width="130" Height="26" Margin="0,0,8,2" />
                <TextBlock Text="SF" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,2"
                           ToolTip.Tip="Spreading factor — auto-filled from preset; edit to override" />
                <TextBox Text="{Binding OverrideSf}" IsEnabled="{Binding !IsRunning}" FontSize="11" Width="28" Height="26" Margin="0,0,6,2" />
                <TextBlock Text="BW" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,2"
                           ToolTip.Tip="Bandwidth in kHz — auto-filled from preset; edit to override" />
                <TextBox Text="{Binding OverrideBwKhz}" IsEnabled="{Binding !IsRunning}" FontSize="11" Width="52" Height="26" Margin="0,0,6,2" />
                <TextBlock Text="CR" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,2"
                           ToolTip.Tip="Coding rate denominator (4/N) — auto-filled from preset; edit to override" />
                <TextBox Text="{Binding OverrideCr}" IsEnabled="{Binding !IsRunning}" FontSize="11" Width="24" Height="26" Margin="0,0,8,2" />
                <TextBlock Text="Slot" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" />
                <ComboBox ItemsSource="{Binding Slots}"
                          SelectedItem="{Binding SelectedSlot}"
                          IsEnabled="{Binding !IsRunning}"
                          FontSize="11" Width="100" Height="26" Margin="0,0,8,2"
                          ToolTip.Tip="Frequency slot. Auto follows the region, preset and primary channel name, the way a node with no slot set does.">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:Int32">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource SlotLabel}">
                                        <Binding Path="." />
                                        <Binding Path="#RootWindow.DataContext.AutoResolvedSlot" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Freq (MHz)" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" />
                <TextBox Text="{Binding CenterFreqMHz}" IsEnabled="{Binding !IsRunning}"
                         FontSize="11" Width="100" Height="26" Margin="0,0,8,2" />
                <Border Width="1" Margin="2,2,10,6" Background="{DynamicResource BrushPanelBorder}" />
                <!-- Drawn, not typed: see ToggleButtonGeometry for why a ▶
                     character came out as a colour emoji next to a flat ■.
                     Square button, so neither state shifts the toolbar. -->
                <Button Command="{Binding ToggleRxCommand}"
                        ToolTip.Tip="{Binding ToggleButtonTip}"
                        Height="26" Width="26" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Margin="0,0,10,2">
                    <Path Data="{Binding ToggleButtonGeometry}"
                          Fill="{Binding $parent[Button].Foreground}"
                          Width="9" Height="9" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <TextBlock Text="{Binding RssiDbfs, StringFormat='RSSI: {0:F1} dBFS'}" FontSize="11"
                           IsVisible="{Binding IsRunning}" VerticalAlignment="Center" Margin="0,0,0,2" />
            </WrapPanel>
          </DockPanel>
        </Border>

        <!-- Toolbar row 2: RX/TX gains, gated by which device is selected (IsHackRf/IsRtlSdr/IsTxHackRf). -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BrushPanelBackground}"
                BorderBrush="{DynamicResource BrushPanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="4,1">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding IsHackRf}">
                    <TextBlock Text="RX" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,2" />
                    <TextBlock Text="LNA" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" ToolTip.Tip="HackRF LNA gain (RF-stage), 0..40 dB step 8" />
                    <Slider Width="110" Minimum="0" Maximum="40" TickFrequency="8" IsSnapToTickEnabled="True"
                            SmallChange="8" LargeChange="8" Value="{Binding LnaGainDb}" VerticalAlignment="Center" Margin="0,0,4,2" />
                    <TextBlock Width="32" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,2" Text="{Binding LnaGainDb, StringFormat='{}{0} dB'}" />
                    <TextBlock Text="VGA" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" ToolTip.Tip="HackRF baseband VGA gain, 0..62 dB step 2" />
                    <Slider Width="130" Minimum="0" Maximum="62" TickFrequency="2" IsSnapToTickEnabled="True"
                            SmallChange="2" LargeChange="2" Value="{Binding VgaGainDb}" VerticalAlignment="Center" Margin="0,0,4,2" />
                    <TextBlock Width="32" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,2" Text="{Binding VgaGainDb, StringFormat='{}{0} dB'}" />
                    <ToggleButton Content="AMP (+14 dB)" IsChecked="{Binding AmpEnable}" FontSize="11" Margin="0,0,8,2" ToolTip.Tip="Enable HackRF front-end RF amplifier" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" IsVisible="{Binding IsRtlSdr}">
                    <TextBlock Text="RX" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,2" />
                    <TextBlock Text="Gain" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" ToolTip.Tip="RTL-SDR manual tuner gain, 0..49 dB" />
                    <Slider Width="220" Minimum="0" Maximum="49" TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="5" Value="{Binding RtlGainDb}" IsEnabled="{Binding !RtlAgcEnable}"
                            VerticalAlignment="Center" Margin="0,0,4,2" />
                    <TextBlock Width="40" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,2" Text="{Binding RtlGainDb, StringFormat='{}{0} dB'}" />
                    <ToggleButton Content="AGC" IsChecked="{Binding RtlAgcEnable}" FontSize="11" Margin="0,0,8,2"
                                  ToolTip.Tip="Tuner automatic gain control (overrides the manual gain slider)" />
                    <ToggleButton Content="Bias-T" IsChecked="{Binding BiasTee}" FontSize="11" Margin="0,0,8,2"
                                  ToolTip.Tip="Enable 5V bias-T on the antenna port to power an external LNA/active antenna" />
                </StackPanel>

                <Border Width="1" Margin="2,2,10,6" Background="{DynamicResource BrushPanelBorder}" IsVisible="{Binding IsTxHackRf}" />

                <StackPanel Orientation="Horizontal" IsVisible="{Binding IsTxHackRf}">
                    <TextBlock Text="TX" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,2" />
                    <TextBlock Text="Gain" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" ToolTip.Tip="HackRF TX VGA gain, 0..47 dB" />
                    <Slider Width="120" Minimum="0" Maximum="47" TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="4" Value="{Binding TxGainDb}" VerticalAlignment="Center" Margin="0,0,4,2" />
                    <TextBlock Width="40" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,2" Text="{Binding TxGainDb, StringFormat='{}{0} dB'}" />
                    <ToggleButton Content="AMP (+14 dB)" IsChecked="{Binding TxAmpEnable}" FontSize="11" Margin="0,0,8,2"
                                  ToolTip.Tip="Enable the HackRF RF amplifier for transmit output" />
                </StackPanel>

                <Border Width="1" Margin="2,2,10,6" Background="{DynamicResource BrushPanelBorder}" IsVisible="{Binding IsTxSx1262}" />

                <!-- SX1262 USB stick. Unlike the HackRF row above this is real
                     antenna-port power, not a VGA setting, so the slider bounds
                     come from the selected board rather than being fixed. -->
                <StackPanel Orientation="Horizontal" IsVisible="{Binding IsTxSx1262}">
                    <TextBlock Text="TX" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,2" />
                    <TextBlock Text="Board" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" />
                    <ComboBox ItemsSource="{Binding AvailableSx1262Boards}"
                              SelectedItem="{Binding SelectedSx1262Board}"
                              IsEnabled="{Binding !IsRunning}"
                              FontSize="11" Width="165" Height="26" Margin="0,0,8,2"
                              ToolTip.Tip="Both sticks share USB IDs and wiring, so MeshRF cannot tell them apart — pick the one you have. This sets the power model only.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="mesh:Sx1262Board">
                                <TextBlock Text="{Binding ., Converter={StaticResource Sx1262BoardLabel}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- Power is meaningless until the board is known: the same
                         dBm means two different things 8 dB apart. Hidden
                         rather than disabled so there is no number to misread. -->
                    <TextBlock Text="Power" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2"
                               IsVisible="{Binding IsSx1262BoardChosen}" ToolTip.Tip="Transmit power at the antenna port" />
                    <Slider Width="120" Minimum="{Binding Sx1262MinPowerDbm}" Maximum="{Binding Sx1262MaxPowerDbm}"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="4" Value="{Binding Sx1262TxPowerDbm}"
                            IsVisible="{Binding IsSx1262BoardChosen}"
                            VerticalAlignment="Center" Margin="0,0,4,2" />
                    <TextBlock Width="48" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,2"
                               IsVisible="{Binding IsSx1262BoardChosen}"
                               Text="{Binding Sx1262TxPowerDbm, StringFormat='{}{0} dBm'}" />
                    <!-- Only when the region is the binding ceiling: a slider
                         that stops 9 dB below the board's maximum otherwise
                         looks like a bug. -->
                    <TextBlock FontSize="11" VerticalAlignment="Center" Margin="0,0,8,2"
                               Foreground="#888888"
                               IsVisible="{Binding ShowSx1262PowerCap}"
                               Text="{Binding Sx1262PowerCapText}"
                               ToolTip.Tip="Meshtastic firmware clamps transmit power to this regional limit, and MeshRF does the same. The limit is power at the antenna port, so antenna gain is yours to account for. Licensed (ham) operation lifts it — the checkbox is in Node identity." />
                    <TextBlock FontSize="11" VerticalAlignment="Center" Margin="0,0,8,2"
                               Foreground="#FFE0A030"
                               IsVisible="{Binding ShowSx1262BoardPrompt}"
                               Text="⚠ pick your board before transmitting — the two look identical over USB"
                               ToolTip.Tip="MeshStick and MeshToad share USB IDs and report no distinguishing product string, so MeshRF cannot detect which is plugged in. Guessing wrong misreports transmit power by about 8 dB, so transmit stays disabled until you choose." />
                    <TextBlock FontSize="11" VerticalAlignment="Center" Margin="0,0,8,2"
                               Foreground="#FFE0A030"
                               IsVisible="{Binding ShowSx1262PowerWarning}"
                               Text="⚠ over 22 dBm can exceed USB current — use a powered hub"
                               ToolTip.Tip="The MeshToad's PA draws up to ~900 mA on transmit, more than a USB 2.0 port is required to supply. Brownouts show up as failed transmits." />
                    <!-- A button, not a label: this one gates transmit, so it
                         needs somewhere to click. MeshRF cannot know which band
                         the stick was built for, so a deliberate 433 or 868
                         owner has to be able to proceed. -->
                    <Button FontSize="11" VerticalAlignment="Center" Margin="0,0,8,2"
                            Padding="6,1" Foreground="#FFE0A030"
                            IsVisible="{Binding ShowSx1262BandWarning}"
                            Command="{Binding AcknowledgeBandChangeCommand}"
                            Content="{Binding Sx1262BandWarningText}"
                            ToolTip.Tip="A stick's matching network, filter and PA are built for one band, and nothing in the hardware reports which — so changing to a band that doesn't overlap the last one has to be confirmed. Transmitting far outside the band the stick was built for can damage its PA. Click to confirm this is the right band for your hardware." />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Toolbar row 3: waterfall display settings. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BrushPanelBackground}"
                BorderBrush="{DynamicResource BrushPanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="4,1">
            <WrapPanel>
                <!-- Units live on the toolbar (as in MeshRF.App), not in the
                     identity dialog: they're a display preference, not part of
                     this node's identity. -->
                <TextBlock Text="Units" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" />
                <ComboBox ItemsSource="{Binding UnitSystems}" SelectedItem="{Binding UnitSystemName}"
                          FontSize="11" Width="92" VerticalAlignment="Center" Margin="0,0,10,2"
                          ToolTip.Tip="Display units used throughout the app" />
                <Border Width="1" Margin="0,2,10,6" Background="{DynamicResource BrushPanelBorder}" />
                <TextBlock Text="Colormap" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" />
                <ComboBox ItemsSource="{Binding AvailableColormaps}"
                          SelectedItem="{Binding WaterfallColormap}"
                          FontSize="11" Width="90" VerticalAlignment="Center" Margin="0,0,10,2" />
                <ToggleButton Content="Auto levels" IsChecked="{Binding WaterfallAutoLevels}" FontSize="11" Margin="0,0,8,2"
                              ToolTip.Tip="Track 5th/99th percentile of recent frames" />
                <TextBlock Text="floor" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" />
                <Slider Width="140" Minimum="-140" Maximum="0" TickFrequency="5" Value="{Binding WaterfallFloorDb}" VerticalAlignment="Center" Margin="0,0,4,2" />
                <TextBlock Width="48" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,2"
                           Text="{Binding WaterfallFloorDb, StringFormat='{}{0:F0} dB'}" />
                <TextBlock Text="ceil" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" />
                <Slider Width="140" Minimum="-100" Maximum="20" TickFrequency="5" Value="{Binding WaterfallCeilDb}" VerticalAlignment="Center" Margin="0,0,4,2" />
                <TextBlock Width="48" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,2"
                           Text="{Binding WaterfallCeilDb, StringFormat='{}{0:F0} dB'}" />
                <Border Width="1" Margin="2,2,10,6" Background="{DynamicResource BrushPanelBorder}" />
                <TextBlock Text="Speed" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,2" />
                <Slider Width="120" Minimum="5" Maximum="480" TickFrequency="5" Value="{Binding WaterfallRowsPerSecond}" VerticalAlignment="Center" Margin="0,0,4,2"
                        ToolTip.Tip="Waterfall scroll speed in rows per second (time resolution). Caps out at the receiver's native frame rate (sample rate / 1024)." />
                <TextBlock Width="48" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,2"
                           Text="{Binding WaterfallRowsPerSecond, StringFormat='{}{0:F0}/s'}" />
                <Border Width="1" Margin="2,2,10,6" Background="{DynamicResource BrushPanelBorder}" />
                <ToggleButton Content="DC block" IsChecked="{Binding DcBlockEnable}" FontSize="11" Margin="0,0,8,2"
                              ToolTip.Tip="IIR high-pass to remove the LO leakage spike at the tuned centre frequency" />
            </WrapPanel>
        </Border>

        <!-- Status bar. -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BrushPanelBackground}"
                BorderBrush="{DynamicResource BrushPanelBorder}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushSubtle}" />
                <TextBlock Text="{Binding DeviceStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushSubtle}" />
            </StackPanel>
        </Border>

        <!-- Main content: a 2x2 quadrant layout — map / nodes on the left,
             spectrum+waterfall / chat+log on the right (see SpectrumView /
             WaterfallView / FrequencyAxis). -->
        <Grid x:Name="MainLayoutGrid" Margin="6">
            <!-- Equal halves: left pane / splitter / right pane. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Left: map (top) over nodes/waypoints (bottom). -->
            <Grid x:Name="LeftPaneGrid" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" MinHeight="120" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="1*" MinHeight="120" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,3"
                        Background="{DynamicResource BrushSpectrumBackground}"
                        BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                    <local:MapPanel x:Name="Map" />
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              Background="{DynamicResource BrushSplitter}" />

                <Grid x:Name="NodesWaypointsGrid" Grid.Row="2" Margin="0,3,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="80" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="1*" MinHeight="80" />
                    </Grid.RowDefinitions>
                    <!-- Compact My Node bar — opens the identity settings dialog. -->
                    <Border Grid.Row="0" Margin="0,0,0,4" Padding="6,4"
                            Background="{DynamicResource BrushPanelBackground}"
                            BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Configure" Padding="8,2"
                                    Click="OnOpenNodeIdentity" ToolTip.Tip="Open My Node identity and settings" />
                            <Button DockPanel.Dock="Right" Content="MQTT" Padding="8,2" Margin="0,0,4,0"
                                    Click="OnOpenMqttSettings"
                                    ToolTip.Tip="Open the MQTT bridge settings (uplink/downlink to a broker)" />
                            <Button DockPanel.Dock="Right" Content="Scripts" Padding="8,2" Margin="0,0,4,0"
                                    Click="OnOpenScripts"
                                    ToolTip.Tip="Automation scripts: reply to messages and send on a schedule" />
                            <Button DockPanel.Dock="Right" Content="Notifications" Padding="8,2" Margin="0,0,4,0"
                                    Click="OnOpenRingtoneSettings"
                                    ToolTip.Tip="Alert tones and volume: the message, geofence and alert bell tunes, and how long each plays" />
                            <!-- Our own recorded history, the counterpart of the
                                 per-node entries in the node grid's menu. -->
                            <Button DockPanel.Dock="Right" Content="Location" Padding="8,2" Margin="0,0,4,0"
                                    Click="OnOpenSelfLocationHistory" ToolTip.Tip="My recorded location history" />
                            <Button DockPanel.Dock="Right" Content="Telemetry" Padding="8,2" Margin="0,0,4,0"
                                    Click="OnOpenSelfTelemetryHistory" ToolTip.Tip="My recorded telemetry history" />
                            <TextBlock Text="My Node" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource BrushSubtle}"
                                       Text="{Binding MyLongName}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <!-- Quick send bar. Each button prompts for the destination
                         channel (or an open DM peer) first, as MeshRF.App does. -->
                    <Border Grid.Row="1" Margin="0,0,0,4" Padding="6,4"
                            Background="{DynamicResource BrushPanelBackground}"
                            BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Quick send" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button Content="Node info" Padding="10,3" Click="OnSendNodeInfoPrompted"
                                    ToolTip.Tip="Broadcast your NODEINFO payload on the primary channel" />
                            <Button Content="Position" Padding="10,3" Click="OnSendPositionPrompted"
                                    ToolTip.Tip="Broadcast your POSITION payload on the primary channel" />
                            <Button Content="Device metrics" Padding="10,3" Click="OnSendDeviceMetricsPrompted"
                                    ToolTip.Tip="Broadcast your device-metrics telemetry on the primary channel" />
                            <Button Content="Env telemetry" Padding="10,3" Click="OnSendEnvironmentMetricsPrompted"
                                    ToolTip.Tip="Fetch weather for your home location, then broadcast TELEMETRY environment metrics" />
                            <Button Content="AQ telemetry" Padding="10,3" Click="OnSendAirQualityMetricsPrompted"
                                    ToolTip.Tip="Fetch PM2.5/PM10 from the Open-Meteo air quality API, then broadcast TELEMETRY air quality metrics" />
                            <Button Content="Status" Padding="10,3" Click="OnSendNodeStatusPrompted"
                                    ToolTip.Tip="Broadcast your NODE_STATUS_APP text on the primary channel" />
                            <!-- Buttons the scripts asked for, after the built-in
                                 ones. Empty unless a script has a quick_send
                                 trigger, so the bar looks unchanged without one. -->
                            <ItemsControl ItemsSource="{Binding ScriptQuickSends}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="scripting:QuickSendButton">
                                        <Button Content="{Binding Label}" Padding="10,3"
                                                Click="OnRunScriptQuickSend"
                                                ToolTip.Tip="{Binding FileName}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <TextBlock Margin="4,0,0,4" FontWeight="Bold" Text="{Binding NodesHeader}"
                                   ToolTip.Tip="Online = heard in the last 2 hours, counted across every known node rather than just the filtered ones" />

                        <!-- Node list filter bar. -->
                        <Border Margin="0,0,0,3" Padding="4,3"
                                Background="{DynamicResource BrushPanelBackground}"
                                BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                    <Button DockPanel.Dock="Right" Content="Clear" FontSize="11" Padding="8,2"
                                            Margin="6,0,0,0" Command="{Binding ClearNodeFiltersCommand}"
                                            ToolTip.Tip="Clear all filters" />
                                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11"
                                               Margin="0,0,6,0" Text="Search" />
                                    <TextBox Height="22" FontSize="11" Text="{Binding NodeSearchText}"
                                             ToolTip.Tip="Search by name, short name, or node ID" />
                                </DockPanel>

                                <!-- Not an Expander, for the same reason as the map's
                                     waypoint panel: Fluent's Expander header paints its
                                     hover fill through inner template presenters that
                                     don't span the whole header, so it highlights in
                                     mismatched patches. -->
                                <ToggleButton x:Name="FiltersToggle" HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch" Padding="4,2" FontSize="11">
                                    <DockPanel>
                                        <Panel DockPanel.Dock="Right">
                                            <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrushSubtle}"
                                                       IsVisible="{Binding !#FiltersToggle.IsChecked}" />
                                            <TextBlock Text="▴" FontSize="9" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrushSubtle}"
                                                       IsVisible="{Binding #FiltersToggle.IsChecked}" />
                                        </Panel>
                                        <TextBlock Text="Filters" FontSize="11" VerticalAlignment="Center" />
                                    </DockPanel>
                                </ToggleButton>
                                <Border IsVisible="{Binding #FiltersToggle.IsChecked}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" MaxHeight="220">
                                        <Grid Margin="0,6,0,0" ColumnDefinitions="120,*"
                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Hops" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="0" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding NodeHopsFilterOptions}" SelectedItem="{Binding NodeHopsFilter}" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Key status" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding NodeKeyFilterOptions}" SelectedItem="{Binding NodeKeyFilter}" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Signed" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="2" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding NodeSignedFilterOptions}" SelectedItem="{Binding NodeSignedFilter}" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Position" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="3" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding NodeLocationFilterOptions}" SelectedItem="{Binding NodeLocationFilter}" />

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ignored nodes" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="4" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding NodeIgnoredFilterOptions}" SelectedItem="{Binding NodeIgnoredFilter}" />

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Favorites" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="5" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding NodeFavoriteFilterOptions}" SelectedItem="{Binding NodeFavoriteFilter}" />

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Via MQTT" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="6" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding NodeMqttFilterOptions}" SelectedItem="{Binding NodeMqttFilter}" />

                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Heard within" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <TextBox Grid.Row="7" Grid.Column="1" Height="22" FontSize="11" Text="{Binding NodeMaxAgeMinutesText}"
                                                     PlaceholderText="minutes" ToolTip.Tip="Only show nodes heard within this many minutes" />

                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Max distance" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <TextBox Grid.Row="8" Grid.Column="1" Height="22" FontSize="11" Text="{Binding NodeDistanceKmText}"
                                                     PlaceholderText="{Binding NodeDistanceUnitShort}" ToolTip.Tip="Needs a home location set in My Node → Configure" />

                                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Has temperature" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="9" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodeTemperatureFilter}" />

                                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Has humidity" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="10" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodeHumidityFilter}" />

                                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Has pressure" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="11" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodePressureFilter}" />

                                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Has gas resist." FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="12" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodeGasResistanceFilter}" />

                                            <TextBlock Grid.Row="13" Grid.Column="0" Text="Has IAQ" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="13" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodeIaqFilter}" />

                                            <TextBlock Grid.Row="14" Grid.Column="0" Text="Has PM1.0 std" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="14" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodePm10StdFilter}" />

                                            <TextBlock Grid.Row="15" Grid.Column="0" Text="Has PM2.5 std" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="15" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodePm25StdFilter}" />

                                            <TextBlock Grid.Row="16" Grid.Column="0" Text="Has PM10 std" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="16" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodePm100StdFilter}" />

                                            <TextBlock Grid.Row="17" Grid.Column="0" Text="Has PM1.0 env" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="17" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodePm10EnvFilter}" />

                                            <TextBlock Grid.Row="18" Grid.Column="0" Text="Has PM2.5 env" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="18" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodePm25EnvFilter}" />

                                            <TextBlock Grid.Row="19" Grid.Column="0" Text="Has PM10 env" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <ComboBox Grid.Row="19" Grid.Column="1" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodePm100EnvFilter}" />

                                            <TextBlock Grid.Row="20" Grid.Column="0" Text="Has Ch1 V / A" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <Grid Grid.Row="20" Grid.Column="1" ColumnDefinitions="*,4,*">
                                                <ComboBox Grid.Column="0" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodeCh1VoltageFilter}" />
                                                <ComboBox Grid.Column="2" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodeCh1CurrentFilter}" />
                                            </Grid>

                                            <TextBlock Grid.Row="21" Grid.Column="0" Text="Has Ch2 V / A" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <Grid Grid.Row="21" Grid.Column="1" ColumnDefinitions="*,4,*">
                                                <ComboBox Grid.Column="0" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodeCh2VoltageFilter}" />
                                                <ComboBox Grid.Column="2" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodeCh2CurrentFilter}" />
                                            </Grid>

                                            <TextBlock Grid.Row="22" Grid.Column="0" Text="Has Ch3 V / A" FontSize="11" VerticalAlignment="Center" Margin="0,2,8,2" />
                                            <Grid Grid.Row="22" Grid.Column="1" ColumnDefinitions="*,4,*">
                                                <ComboBox Grid.Column="0" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodeCh3VoltageFilter}" />
                                                <ComboBox Grid.Column="2" Height="22" FontSize="11" HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding TelemetryHasFilterOptions}" SelectedItem="{Binding NodeCh3CurrentFilter}" />
                                            </Grid>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <DataGrid Grid.Row="3" x:Name="NodesGridProxy" ItemsSource="{Binding NodesView}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              CanUserSortColumns="True" CanUserResizeColumns="True"
                              SelectionMode="Extended"
                              DoubleTapped="OnNodeDoubleTapped"
                              KeyDown="OnNodesGridKeyDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Message"
                                          Command="{Binding #RootWindow.DataContext.MessageNodeCommand}"
                                          CommandParameter="{Binding #NodesGridProxy.SelectedItem}" />
                                <MenuItem Header="Show on map" Click="OnShowOnMap" />
                                <MenuItem Header="Telemetry history…" Click="OnOpenNodeTelemetryHistory" />
                                <MenuItem Header="Location history…" Click="OnOpenNodeLocationHistory" />
                                <Separator />
                                <MenuItem Header="Request node info"
                                          Command="{Binding #RootWindow.DataContext.RequestNodeInfoCommand}"
                                          CommandParameter="{Binding #NodesGridProxy.SelectedItem}" />
                                <MenuItem Header="Exchange node info"
                                          Command="{Binding #RootWindow.DataContext.ExchangeNodeInfoCommand}"
                                          CommandParameter="{Binding #NodesGridProxy.SelectedItem}" />
                                <MenuItem Header="Request location"
                                          Command="{Binding #RootWindow.DataContext.RequestLocationCommand}"
                                          CommandParameter="{Binding #NodesGridProxy.SelectedItem}" />
                                <MenuItem Header="Exchange location"
                                          Command="{Binding #RootWindow.DataContext.ExchangeLocationCommand}"
                                          CommandParameter="{Binding #NodesGridProxy.SelectedItem}" />
                                <MenuItem Header="Request telemetry"
                                          Command="{Binding #RootWindow.DataContext.RequestTelemetryCommand}"
                                          CommandParameter="{Binding #NodesGridProxy.SelectedItem}" />
                                <MenuItem Header="Traceroute"
                                          Command="{Binding #RootWindow.DataContext.TracerouteCommand}"
                                          CommandParameter="{Binding #NodesGridProxy.SelectedItem}" />
                                <MenuItem Header="Request new keys"
                                          Command="{Binding #RootWindow.DataContext.RequestNewKeysCommand}"
                                          CommandParameter="{Binding #NodesGridProxy.SelectedItem}" />
                                <Separator />
                                <MenuItem Header="Toggle ignore"
                                          Command="{Binding #RootWindow.DataContext.ToggleIgnoreNodeCommand}"
                                          CommandParameter="{Binding #NodesGridProxy.SelectedItem}" />
                                <MenuItem Header="Toggle favorite"
                                          Command="{Binding #RootWindow.DataContext.ToggleFavoriteNodeCommand}"
                                          CommandParameter="{Binding #NodesGridProxy.SelectedItem}" />
                                <MenuItem Header="Copy" Click="OnCopyNode" InputGesture="Ctrl+C" />
                                <Separator />
                                <MenuItem Header="Delete" Click="OnDeleteNodes" InputGesture="Delete" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <!-- Indicator columns. Plain Unicode symbols rather than
                                 Segoe MDL2 glyphs, which are Windows-only.

                                 Each sorts on the same bool its cell shows, spelled
                                 out for the same reason as the text columns below:
                                 compiled bindings leave SortMemberPath empty. Since
                                 these are bools, the first header click (ascending)
                                 puts the unflagged nodes first and the second click
                                 brings the flagged ones to the top. -->
                            <DataGridTemplateColumn Width="Auto" SortMemberPath="Favorite">
                                <DataGridTemplateColumn.Header>
                                    <!-- Foreground is set here as well as on the cell:
                                         the header inherits BrushAppForeground from the
                                         DataGridColumnHeader style, so an untinted ★
                                         title came out plain grey while the cells were
                                         gold. (Only works because ★ is a plain text
                                         glyph — see the color-emoji note below.) -->
                                    <TextBlock Text="★" Foreground="#FFD479" ToolTip.Tip="Favorite" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="nodes:NodeRecord">
                                        <TextBlock Text="★" Foreground="#FFD479" ToolTip.Tip="Favorite"
                                                   IsVisible="{Binding Favorite}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto" SortMemberPath="HasPublicKey">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="🔑" ToolTip.Tip="Public key on file (green dot = node ID derived from key, red dot = key mismatch)" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <!-- 🔑 is a full-color emoji glyph: Skia's text renderer draws
                                         color-emoji glyphs from the font's own embedded artwork and
                                         ignores Foreground entirely, so a tinted 🔑 (as this used to
                                         be) never actually changes color. A small plain-shape Ellipse
                                         badge overlaid on the glyph is used instead, since ordinary
                                         vector shapes do respect Fill. -->
                                    <DataTemplate x:DataType="nodes:NodeRecord">
                                        <Panel IsVisible="{Binding HasPublicKey}" ToolTip.Tip="Public key on file">
                                            <TextBlock Text="🔑" />
                                            <Ellipse Width="5" Height="5" Fill="#7BD88F"
                                                     Stroke="{DynamicResource BrushPanelBackground}" StrokeThickness="0.75"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                     IsVisible="{Binding HasDerivedNodeNumMatch}"
                                                     ToolTip.Tip="Public key matches this node's Meshtastic PKI-derived node number" />
                                            <Ellipse Width="5" Height="5" Fill="#FF6B6B"
                                                     Stroke="{DynamicResource BrushPanelBackground}" StrokeThickness="0.75"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                     IsVisible="{Binding HasKeyMismatch}"
                                                     ToolTip.Tip="Key mismatch — this node's key changed" />
                                        </Panel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto" SortMemberPath="IsXeddsaVerified">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="🛡" ToolTip.Tip="Verified: a valid XEdDSA signature was confirmed from this node" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="nodes:NodeRecord">
                                        <TextBlock Text="🛡" Foreground="#7BD88F"
                                                   ToolTip.Tip="Verified: a valid XEdDSA signature was confirmed from this node"
                                                   IsVisible="{Binding IsXeddsaVerified}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto" SortMemberPath="IsUnmessagableTrue">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="🚫" ToolTip.Tip="Node is marked unmessagable" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="nodes:NodeRecord">
                                        <TextBlock Text="🚫" ToolTip.Tip="Node is marked unmessagable"
                                                   IsVisible="{Binding IsUnmessagableTrue}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto" SortMemberPath="HasLocation">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="📍" ToolTip.Tip="Position known" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="nodes:NodeRecord">
                                        <TextBlock Text="📍" IsVisible="{Binding HasLocation}" ToolTip.Tip="Location known" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto" SortMemberPath="IsSeenViaMqtt">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="🌉" ToolTip.Tip="Last heard via MQTT rather than over the air" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="nodes:NodeRecord">
                                        <TextBlock Text="🌉" ToolTip.Tip="Last heard via MQTT rather than over the air"
                                                   IsVisible="{Binding IsSeenViaMqtt}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- SortMemberPath is spelled out because Avalonia only infers it
                                 from a classic Binding, not the compiled bindings this project
                                 uses by default. Without it every column reports an empty path,
                                 so the saved node sort can be neither restored nor read back.

                                 These are DataGridTemplateColumns rather than the plainer
                                 DataGridTextColumn (which has no per-cell Foreground to bind)
                                 specifically so ignored nodes can render in red text: a Style
                                 targeting DataGridRow/DataGridCell was tried first, since that
                                 would have applied to every column in one place, but it did not
                                 reliably take effect. Binding Foreground directly on each cell's
                                 own TextBlock is the same mechanism already used by the icon
                                 columns above (HasPublicKey, IsXeddsaVerified, ...), so it is
                                 known to work. -->
                            <DataGridTemplateColumn Header="Short" Width="Auto" SortMemberPath="ShortName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="nodes:NodeRecord">
                                        <TextBlock Text="{Binding ShortName}" FontFamily="Consolas, Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji"
                                                   Foreground="{Binding Ignored, Converter={StaticResource IgnoredForeground}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Node name" Width="*" SortMemberPath="LongName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="nodes:NodeRecord">
                                        <TextBlock Text="{Binding LongName}"
                                                   Foreground="{Binding Ignored, Converter={StaticResource IgnoredForeground}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="*" SortMemberPath="NodeStatus">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="nodes:NodeRecord">
                                        <TextBlock Text="{Binding NodeStatus}"
                                                   Foreground="{Binding Ignored, Converter={StaticResource IgnoredForeground}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Role" Width="Auto" SortMemberPath="Role">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="nodes:NodeRecord">
                                        <TextBlock Text="{Binding Role}"
                                                   Foreground="{Binding Ignored, Converter={StaticResource IgnoredForeground}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Node ID" Width="Auto" SortMemberPath="DisplayId">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="nodes:NodeRecord">
                                        <TextBlock Text="{Binding DisplayId}" FontFamily="Consolas, Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji"
                                                   Foreground="{Binding Ignored, Converter={StaticResource IgnoredForeground}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Last heard" Width="Auto" SortMemberPath="LastHeard">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="nodes:NodeRecord">
                                        <TextBlock Text="{Binding LastHeard, Converter={x:Static local:UiStampConverter.Instance}}"
                                                   Foreground="{Binding Ignored, Converter={StaticResource IgnoredForeground}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="RSSI" Width="Auto" SortMemberPath="RssiDbm">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="nodes:NodeRecord">
                                        <TextBlock Text="{Binding RssiDbm, StringFormat='{}{0:F0} dBm'}"
                                                   Foreground="{Binding Ignored, Converter={StaticResource IgnoredForeground}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SNR" Width="Auto" SortMemberPath="SnrDb">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="nodes:NodeRecord">
                                        <TextBlock Text="{Binding SnrDb, StringFormat='{}{0:F1}'}"
                                                   Foreground="{Binding Ignored, Converter={StaticResource IgnoredForeground}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto" SortMemberPath="HopsAway">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="🐇" ToolTip.Tip="Hops away" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="nodes:NodeRecord">
                                        <TextBlock Text="{Binding HopsAway}"
                                                   Foreground="{Binding Ignored, Converter={StaticResource IgnoredForeground}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource BrushSplitter}" />

                    <!-- The count label rides inside the waypoint row rather than
                         in an Auto row of its own: a GridSplitter resizes the two
                         definitions either side of it, so a separate label row is
                         what the drag would fight against instead of the table. -->
                    <DockPanel Grid.Row="5">
                        <TextBlock DockPanel.Dock="Top" Margin="4,3,0,4" FontWeight="Bold"
                                   Text="{Binding Waypoints.Count, StringFormat='Waypoints ({0})'}" />
                        <DataGrid x:Name="WaypointsGridProxy" ItemsSource="{Binding Waypoints}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  CanUserSortColumns="True" CanUserResizeColumns="True"
                                  SelectionMode="Extended"
                                  DoubleTapped="OnWaypointDoubleTapped"
                                  KeyDown="OnWaypointsGridKeyDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit..." Click="OnEditWaypoint" />
                                    <MenuItem Header="Resend"
                                              Command="{Binding #RootWindow.DataContext.ResendWaypointCommand}"
                                              CommandParameter="{Binding #WaypointsGridProxy.SelectedItem}" />
                                    <Separator />
                                    <MenuItem Header="Delete" Click="OnDeleteWaypoints" InputGesture="Delete" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Icon" Width="42" Binding="{Binding IconText}" />
                                <!-- Whose lock, not merely whether there is one. 🔒 is a
                                     colour-emoji glyph and ignores Foreground, so the state
                                     rides on an overlaid Ellipse exactly as the Nodes table's
                                     🔑 does — see the note there. -->
                                <DataGridTemplateColumn Width="Auto" SortMemberPath="LockedTo">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="🔒" ToolTip.Tip="Locked to whoever placed it (green dot = ours, red dot = another node's). Nothing shown when anyone may edit it." />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="waypoints:WaypointRecord">
                                            <Panel IsVisible="{Binding IsLocked}">
                                                <TextBlock Text="🔒" />
                                                <Ellipse Width="5" Height="5" Fill="#7BD88F"
                                                         Stroke="{DynamicResource BrushPanelBackground}" StrokeThickness="0.75"
                                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                         IsVisible="{Binding IsLockedToUs}"
                                                         ToolTip.Tip="Locked to this node — you can edit it, and deleting it retires it on the mesh" />
                                                <Ellipse Width="5" Height="5" Fill="#FF6B6B"
                                                         Stroke="{DynamicResource BrushPanelBackground}" StrokeThickness="0.75"
                                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                         IsVisible="{Binding IsLockedToAnother}"
                                                         ToolTip.Tip="Locked to another node — it cannot be edited here, and deleting it only removes it from this list" />
                                            </Panel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Type" Width="80" Binding="{Binding GeofenceKindText}" />
                                <DataGridTextColumn Header="Name" Width="2*" Binding="{Binding DisplayName}" />
                                <DataGridTextColumn Header="Description" Width="2*" Binding="{Binding Description}" />
                                <DataGridTextColumn Header="From" Width="96" Binding="{Binding FromId}" FontFamily="Consolas, Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji" />
                                <DataGridTextColumn Header="Channel" Width="110" Binding="{Binding ChannelText}" />
                                <DataGridTextColumn Header="To" Width="96" Binding="{Binding ToId}" FontFamily="Consolas, Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji" />
                                <DataGridTextColumn Header="Lat" Width="88" Binding="{Binding Latitude, StringFormat='{}{0:F5}'}" FontFamily="Consolas, Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji" />
                                <DataGridTextColumn Header="Lon" Width="88" Binding="{Binding Longitude, StringFormat='{}{0:F5}'}" FontFamily="Consolas, Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji" />
                                <DataGridTextColumn Header="Status" Width="74" Binding="{Binding ExpiryStatus}" />
                                <DataGridTextColumn Header="Expires" Width="132" Binding="{Binding ExpireTime, Converter={x:Static local:UiStampConverter.Instance}}" />
                                <DataGridTextColumn Header="Heard" Width="156" Binding="{Binding RxTime, Converter={x:Static local:UiStampConverter.Instance}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BrushSplitter}" />

            <!-- Right: spectrum/waterfall (top) over chat tabs + log (bottom). -->
            <Grid x:Name="RightPaneGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" MinHeight="120" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="1*" MinHeight="120" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="3,0,0,3"
                        Background="{DynamicResource BrushSpectrumBackground}"
                        BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                    <Grid>
                    <!-- Receiving through the SX1262 leaves nothing to draw here: a
                         hardware modem hands up decoded frames, never IQ. The whole
                         spectrum stack is replaced by an explanation rather than
                         left as a dead black rectangle the user has to interpret. -->
                    <TextBlock IsVisible="{Binding !HasSpectrum}"
                               Text="{Binding NoSpectrumMessage}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="560" Margin="24"
                               FontSize="12" LineHeight="19"
                               Foreground="{DynamicResource BrushSubtle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Grid x:Name="SpectrumLayoutGrid" RowDefinitions="1*,5,2*"
                          IsVisible="{Binding HasSpectrum}">
                        <local:SpectrumView x:Name="Spectrum" Grid.Row="0"
                                            FloorDb="{Binding WaterfallFloorDb}"
                                            CeilDb="{Binding WaterfallCeilDb}" />

                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource BrushSplitter}" />

                        <!-- 22 (freq axis) / * (live waterfall) / 84 (frozen "last packet"
                             snapshot panel). The snapshot panel's height is fixed rather
                             than proportional so the live waterfall above it keeps a
                             stable on-screen height — a fixed real-world time span then
                             always renders the same number of rows tall. -->
                        <Grid Grid.Row="2" x:Name="WaterfallStackGrid" Background="{DynamicResource BrushSpectrumBackground}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22" />
                                <RowDefinition Height="*" />
                                <!-- Collapsing the last-packet panel sets this row to Auto
                                     (header only) and back; see ApplyLastPacketExpandedState. -->
                                <RowDefinition Height="84" MinHeight="64" />
                            </Grid.RowDefinitions>
                            <local:FrequencyAxis Grid.Row="0"
                                                 CenterFreqHz="{Binding SpectrumCenterHz}"
                                                 SpanHz="{Binding SpectrumSpanHz}"
                                                 Foreground="{DynamicResource BrushAppForeground}" />
                            <local:WaterfallView x:Name="Waterfall" Grid.Row="1"
                                                 FloorDb="{Binding WaterfallFloorDb, Mode=TwoWay}"
                                                 CeilDb="{Binding WaterfallCeilDb, Mode=TwoWay}"
                                                 AutoLevels="{Binding WaterfallAutoLevels, Mode=TwoWay}"
                                                 Colormap="{Binding WaterfallColormap}" />
                            <!-- Frozen spectrogram of the most recently decoded packet. -->
                            <Border Grid.Row="2" Margin="0,2,0,2"
                                    Background="#DD101418"
                                    BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                                <DockPanel>
                                    <!-- Click the header strip to collapse/expand the panel. -->
                                    <DockPanel DockPanel.Dock="Top" Background="Transparent" Cursor="Hand"
                                               PointerReleased="OnLastPacketToggle">
                                        <TextBlock DockPanel.Dock="Right" x:Name="LastPacketToggleIcon"
                                                   Text="&#x25BC;" Margin="4,0,4,0" FontSize="8"
                                                   Foreground="#888888" VerticalAlignment="Center" />
                                        <TextBlock Name="LastPacketTitle" Text="Last packet"
                                                   Margin="4,2,2,2" FontWeight="SemiBold" FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <local:WaterfallView x:Name="LastPacket" Margin="2"
                                                         AutoLevels="True" ScaleToFit="True" TimeHorizontal="True"
                                                         SmoothPixels="True"
                                                         Colormap="{Binding WaterfallColormap}" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              Background="{DynamicResource BrushSplitter}" />

                <Grid x:Name="MessagesLayoutGrid" Grid.Row="2" Margin="3,3,0,0" RowDefinitions="Auto,2*,5,1*">
                    <!-- Header layout is kept identical to the Log header below:
                         title on the left, Auto-scroll rightmost, other actions
                         immediately to its left. -->
                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,3" MinHeight="26">
                        <ToggleButton DockPanel.Dock="Right" Content="Auto-scroll" FontSize="11" Padding="6,1"
                                      Margin="4,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding AutoScroll}"
                                      ToolTip.Tip="Keep the newest message in view" />
                        <!-- Click rather than the command directly: removing a
                             channel is confirmed first, and a dialog needs an
                             owning window. Enablement is bound separately, so
                             it still greys out on the primary. -->
                        <Button DockPanel.Dock="Right" Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                                Content="&#x2212;" FontSize="13" VerticalAlignment="Center"
                                IsEnabled="{Binding CanRemoveSelectedChannel}"
                                Click="OnRemoveChannel"
                                ToolTip.Tip="Remove selected channel" />
                        <Button DockPanel.Dock="Right" Width="22" Height="22" Padding="0"
                                Content="+" FontSize="13" VerticalAlignment="Center"
                                Command="{Binding AddChannelCommand}"
                                ToolTip.Tip="Add a new channel (random PSK)" />
                        <TextBlock Text="Channels" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Tabs, reply banner and composer live in one outer row so
                         the splitter below resizes the chat area against the log
                         instead of squeezing the composer. -->
                    <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto">
                    <!-- Drag-to-reorder: secondary channels among themselves and
                         DM tabs among themselves, matching MeshRF.App. Handled
                         on the TabControl rather than each TabItem because the
                         events bubble, so the tab under the pointer is found
                         from the event source. -->
                    <TabControl Grid.Row="0" Name="MainTabs"
                                ItemsSource="{Binding Tabs}"
                                SelectedItem="{Binding SelectedTab}"
                                DragDrop.AllowDrop="True">
                        <TabControl.ItemTemplate>
                            <DataTemplate x:DataType="mesh:ITabItem">
                                <!-- The box around the title lives here rather than in a
                                     style targeting the TabItem template. Two attempts at
                                     the latter failed silently on Avalonia 12's Fluent
                                     theme (the root is "LayoutRoot", not the expected
                                     "PART_LayoutRoot"), and a name that stops matching
                                     after a theme update is invisible until someone
                                     notices the chrome is gone. Owning the element makes
                                     it independent of the theme's internals. -->
                                <!-- The rule between the channels and the DMs
                                     rides on the first conversation tab, since
                                     the two kinds share one TabControl and its
                                     items are all a template can reach. The
                                     negative margin puts it back out into the
                                     gap the TabItem's margin opens (see the
                                     TabItem style above): inside the tab it
                                     would be enclosed by the tab's own box
                                     rather than separating it from the one
                                     before. The margin is the negative of
                                     TabGroupMarginConverter.GapWidth, which is
                                     what centres the rule in the gap — see the
                                     arithmetic there. -->
                                <StackPanel Orientation="Horizontal">
                                <Rectangle Width="1" Margin="-17,3,0,3"
                                           IsVisible="{Binding StartsTabGroup}"
                                           Fill="{DynamicResource BrushTabBorder}" />
                                <Border Padding="8,3" CornerRadius="3" Background="Transparent"
                                        BorderBrush="{DynamicResource BrushTabBorder}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <!-- Classes.attention drives the pulse animation in
                                             Window.Styles: Avalonia has no DataTrigger, so a
                                             bound style class is how the animation is
                                             driven off view-model state. -->
                                        <TextBlock Text="{Binding TabHeader}" VerticalAlignment="Center"
                                                   Classes.attention="{Binding TabNeedsAttention}" />
                                        <Button Content="&#x2715;" FontSize="9" Padding="3,0" Margin="2,0,-4,0"
                                                BorderThickness="0" Background="Transparent"
                                                ToolTip.Tip="Close conversation"
                                                IsVisible="{Binding CanClose}"
                                                Command="{Binding #RootWindow.DataContext.CloseTabCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.DataTemplates>
                            <DataTemplate DataType="local:ChannelTabViewModel">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Padding="6,4" Margin="0,0,0,4"
                                            Background="{DynamicResource BrushPanelBackground}"
                                            BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right" Spacing="4">
                                            <Button Content="Settings" Padding="6,1" Click="OnOpenChannelSettings"
                                                    ToolTip.Tip="Configure channel name, role, PSK and location sharing" />
                                            <Button Content="Copy" Padding="6,1" Click="OnCopyMessages"
                                                    ToolTip.Tip="Copy this channel's messages to the clipboard" />
                                            <Button Content="Clear" Padding="6,1" Click="OnClearMessages"
                                                    ToolTip.Tip="Clear this channel's messages (cannot be undone)" />
                                        </StackPanel>
                                    </Border>
                                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource MessageListTemplate}" />
                                </DockPanel>
                            </DataTemplate>
                            <DataTemplate DataType="local:ConversationTabViewModel">
                                <DockPanel>
                                    <!-- Peer header: identity plus the per-conversation
                                         toggles MeshRF.App puts here. -->
                                    <Border DockPanel.Dock="Top" Padding="6,4" Margin="0,0,0,4"
                                            Background="{DynamicResource BrushPanelBackground}"
                                            BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Clear" Padding="6,1"
                                                    VerticalAlignment="Center" Margin="4,0,0,0"
                                                    Click="OnClearConversationMessages"
                                                    ToolTip.Tip="Clear this conversation from the view" />
                                            <ToggleButton DockPanel.Dock="Right" Content="Mute Ringtone"
                                                          Padding="6,1" VerticalAlignment="Center" Margin="4,0,0,0"
                                                          IsChecked="{Binding MuteRtttl, Mode=TwoWay}"
                                                          ToolTip.Tip="Mute the incoming ringtone for this node" />
                                            <!-- This peer's recorded history, the counterpart of the
                                                 My Node buttons and the node grid's menu entries. -->
                                            <Button DockPanel.Dock="Right" Content="Location" Padding="6,1"
                                                    VerticalAlignment="Center" Margin="4,0,0,0"
                                                    Click="OnOpenConversationLocationHistory"
                                                    ToolTip.Tip="This node's recorded location history" />
                                            <Button DockPanel.Dock="Right" Content="Telemetry" Padding="6,1"
                                                    VerticalAlignment="Center" Margin="4,0,0,0"
                                                    Click="OnOpenConversationTelemetryHistory"
                                                    ToolTip.Tip="This node's recorded telemetry history" />
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding PeerName}" />
                                                <TextBlock FontFamily="Consolas" Text="{Binding PeerId}"
                                                           Foreground="{DynamicResource BrushSubtle}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Messages beside the peer's current values. A DockPanel,
                                         not a Grid: the panel and its handle collapse to nothing
                                         for a peer we hold no record for, which a splitter-sized
                                         column can't do. The handle drags the panel's own width
                                         (OnTelemetrySplitterDrag) instead of a column's. -->
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Padding="6,4"
                                                Width="{Binding TelemetryPanelWidth}"
                                                IsVisible="{Binding HasTelemetry}"
                                                Background="{DynamicResource BrushPanelBackground}"
                                                BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Telemetry}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:TelemetryItem">
                                                            <Grid ColumnDefinitions="110,*" Margin="0,0,0,2">
                                                                <TextBlock Grid.Column="0" FontSize="11" Text="{Binding Label}"
                                                                           Foreground="{DynamicResource BrushSubtle}" />
                                                                <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                                                                           Text="{Binding Value}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                        <Border DockPanel.Dock="Right" Width="5" Cursor="SizeWestEast"
                                                IsVisible="{Binding HasTelemetry}"
                                                Background="{DynamicResource BrushSplitter}"
                                                PointerPressed="OnTelemetrySplitterPressed"
                                                PointerMoved="OnTelemetrySplitterMoved"
                                                PointerReleased="OnTelemetrySplitterReleased" />
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource MessageListTemplate}" />
                                    </DockPanel>
                                </DockPanel>
                            </DataTemplate>
                        </TabControl.DataTemplates>
                    </TabControl>

                    <Border Grid.Row="1" IsVisible="{Binding HasPendingReply}"
                            Background="{DynamicResource BrushPanelBackground}"
                            BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1"
                            Padding="6,3" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding PendingReplyContext}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="&#x2715;" FontSize="9" Padding="3,0"
                                    BorderThickness="0" Background="Transparent"
                                    Command="{Binding CancelReplyCommand}" />
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="2" Margin="0,6,0,0" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Classes="byteCount"
                                   Classes.over="{Binding ComposeOverLimit}"
                                   Text="{Binding ComposeByteCounter}"
                                   FontFamily="Consolas" FontSize="11" MinWidth="52"
                                   Margin="6,0,0,0" TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="UTF-8 bytes used of what one LoRa frame carries to this destination. An emoji costs four; most non-ASCII costs two or three." />
                        <Button DockPanel.Dock="Right" Content="Send" Margin="4,0,0,0"
                                Command="{Binding SendMessageCommand}" />
                        <Button DockPanel.Dock="Left" Content="😀" Margin="0,0,4,0" Padding="6,1"
                                Click="OnPickComposeEmoji" ToolTip.Tip="Insert an emoji" />
                        <Button DockPanel.Dock="Left" Content="🔔" Margin="0,0,4,0" Padding="6,1"
                                Click="OnInsertAlertBell"
                                ToolTip.Tip="Insert Meshtastic's alert bell, which asks the receiving node to sound its notification for this message" />
                        <TextBox Name="ComposeBox" Text="{Binding MessageText}"
                                 PlaceholderText="Type a message and press Enter or Send"
                                 KeyDown="OnComposeKeyDown" />
                    </DockPanel>
                    </Grid>

                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                  Background="{DynamicResource BrushSplitter}" />

                    <DockPanel Grid.Row="3" Margin="0,3,0,0">
                        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,3" MinHeight="26">
                            <ToggleButton DockPanel.Dock="Right" Content="Auto-scroll" FontSize="11" Padding="6,1"
                                          Margin="4,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding LogAutoScroll}"
                                          ToolTip.Tip="Keep the newest log line in view" />
                            <Button DockPanel.Dock="Right" Content="Clear" FontSize="11" Padding="6,1"
                                    Margin="4,0,0,0" VerticalAlignment="Center" Click="OnClearLog"
                                    ToolTip.Tip="Clear the log" />
                            <Button DockPanel.Dock="Right" Content="Copy" FontSize="11" Padding="6,1"
                                    VerticalAlignment="Center" Click="OnCopyLog"
                                    ToolTip.Tip="Copy the log to the clipboard" />
                            <Button DockPanel.Dock="Right" Content="Raw JSON" FontSize="11" Padding="6,1"
                                    Margin="4,0,4,0" VerticalAlignment="Center" Click="OnOpenRawJsonLog"
                                    ToolTip.Tip="Every decoded packet as JSON" />
                            <TextBlock Text="Log" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <!-- One text block, not a row per line: a selection has
                             to be able to run across lines so a few of them can
                             be copied out. Long lines wrap instead of running
                             off the right edge. -->
                        <Border Background="{DynamicResource BrushPanelBackground}"
                                BorderBrush="{DynamicResource BrushPanelBorder}" BorderThickness="1">
                            <ScrollViewer x:Name="LogScroll" Padding="4,2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <SelectableTextBlock x:Name="LogView" Text="{Binding LogText}" TextWrapping="Wrap"
                                                     FontFamily="Consolas, Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji"
                                                     FontSize="11" />
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>

</Window>
