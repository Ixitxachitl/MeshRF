<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeshRF.AvaloniaApp"
        x:Class="MeshRF.AvaloniaApp.MainWindow"
        x:DataType="local:RadioViewModel"
        Title="MeshRF (cross-platform scaffold)"
        Width="480" Height="320">

    <StackPanel Margin="24" Spacing="12">
        <TextBlock Text="MeshRF — Avalonia scaffold" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding DeviceStatus}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="RX device:" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding AvailableDevices}"
                      SelectedItem="{Binding SelectedDevice}"
                      IsEnabled="{Binding !IsRunning}"
                      Width="140" />
        </StackPanel>

        <Button Content="{Binding ToggleButtonText}"
                Command="{Binding ToggleRxCommand}"
                HorizontalAlignment="Left" />

        <TextBlock Text="{Binding RssiDbfs, StringFormat='RSSI: {0:F1} dBFS'}"
                   IsVisible="{Binding IsRunning}" />
    </StackPanel>

</Window>
