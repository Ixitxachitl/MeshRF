<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MeshRF.AvaloniaApp.WaypointEditWindow"
        Title="Edit waypoint"
        Width="360" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12" Spacing="8">
        <TextBlock Text="Name" FontSize="11" />
        <TextBox Name="NameBox" />
        <TextBlock Text="Description" FontSize="11" />
        <TextBox Name="DescriptionBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBlock Text="Latitude" FontSize="11" />
                <TextBox Name="LatBox" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                <TextBlock Text="Longitude" FontSize="11" />
                <TextBox Name="LonBox" />
            </StackPanel>
        </Grid>
        <TextBlock Name="ErrorText" Foreground="#C62828" FontSize="11" IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancel" Click="OnCancel" />
            <Button Content="Save &amp; resend" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
