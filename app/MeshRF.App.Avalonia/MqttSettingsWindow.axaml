<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:MeshRF.AvaloniaApp"
        xmlns:mesh="clr-namespace:MeshRF;assembly=MeshRF.Core"
        x:Class="MeshRF.AvaloniaApp.MqttSettingsWindow"
        x:DataType="app:RadioViewModel"
        Title="MQTT Bridge"
        Width="600" Height="500"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushAppBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="12" ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,10"
                       Foreground="{DynamicResource BrushSubtle}" FontSize="11"
                       Text="Gateways mesh traffic to and from an MQTT broker, mirroring Meshtastic firmware's MQTT module. Defaults match firmware exactly: the public mqtt.meshtastic.org broker, username/password meshdev/large4cats, root topic &quot;msh&quot;, and encrypted (not JSON) publishing. Per-channel Uplink/Downlink is set in each channel's Settings." />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Enabled" Margin="0,4,8,4" VerticalAlignment="Center" />
            <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" VerticalAlignment="Center"
                      Content="Enable the MQTT bridge"
                      IsChecked="{Binding MqttEnabled, Mode=TwoWay}"
                      ToolTip.Tip="Master switch. Off by default, matching firmware ModuleConfig.MQTTConfig.enabled." />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Status" Margin="0,4,8,4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,4" FontFamily="Consolas"
                       VerticalAlignment="Center" Foreground="{DynamicResource BrushSubtle}"
                       Text="{Binding MqttStatus}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Server" Margin="0,4,8,4" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,4" FontFamily="Consolas"
                     Text="{Binding MqttAddress, Mode=TwoWay}"
                     ToolTip.Tip="Broker address, optionally host:port. Empty = the public mqtt.meshtastic.org broker (port 1883, or 8883 with TLS)." />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Username" Margin="0,4,8,4" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4,0,4" FontFamily="Consolas"
                     Text="{Binding MqttUsername, Mode=TwoWay}"
                     ToolTip.Tip="Empty = firmware default username (meshdev)." />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Password" Margin="0,4,8,4" VerticalAlignment="Center" />
            <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,4,0,4">
                <Button DockPanel.Dock="Right" Content="Show" Margin="6,0,0,0" Padding="8,2"
                        IsVisible="{Binding IsMqttPasswordHidden}"
                        Command="{Binding ToggleRevealMqttPasswordCommand}"
                        ToolTip.Tip="Reveal the password" />
                <Button DockPanel.Dock="Right" Content="Hide" Margin="6,0,0,0" Padding="8,2"
                        IsVisible="{Binding IsMqttPasswordRevealed}"
                        Command="{Binding ToggleRevealMqttPasswordCommand}"
                        ToolTip.Tip="Hide the password" />
                <!-- RevealPassword toggles masking in place, so this needs one
                     box rather than a hidden/shown pair. -->
                <TextBox FontFamily="Consolas" PasswordChar="●"
                         RevealPassword="{Binding IsMqttPasswordRevealed}"
                         Text="{Binding MqttPassword, Mode=TwoWay}"
                         ToolTip.Tip="Empty = firmware default password (large4cats)." />
            </DockPanel>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Root topic" Margin="0,4,8,4" VerticalAlignment="Center" />
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4,0,4" FontFamily="Consolas"
                     Text="{Binding MqttRootTopic, Mode=TwoWay}"
                     ToolTip.Tip="Empty = firmware default (&quot;msh&quot;)." />

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Options" Margin="0,4,8,4" VerticalAlignment="Center" />
            <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,4,0,4">
                <CheckBox Content="Publish/accept channel-encrypted packets (not decrypted contents)"
                          IsChecked="{Binding MqttEncryptionEnabled, Mode=TwoWay}"
                          ToolTip.Tip="On by default, matching firmware encryption_enabled. Turning this off is not recommended — it publishes decrypted channel contents to the broker." />
                <CheckBox Margin="0,6,0,0" Content="Connect over TLS"
                          IsChecked="{Binding MqttTlsEnabled, Mode=TwoWay}"
                          ToolTip.Tip="Off by default, matching firmware tls_enabled." />
                <CheckBox Margin="0,6,0,0" Content="Also publish human-readable JSON"
                          IsChecked="{Binding MqttJsonEnabled, Mode=TwoWay}"
                          ToolTip.Tip="Publishes a parallel JSON copy of every uplinked packet to &quot;.../2/json/...&quot; and accepts 'sendtext'/'sendposition' JSON commands on a channel named 'mqtt' (with Downlink enabled), matching firmware json_enabled. Off by default." />
            </StackPanel>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Map reporting" Margin="0,4,8,4" VerticalAlignment="Center" />
            <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,4,0,4">
                <CheckBox Content="Publish periodic map reports"
                          IsChecked="{Binding MqttMapReportingEnabled, Mode=TwoWay}"
                          ToolTip.Tip="Publishes an unencrypted MapReport (name, role, hardware, firmware version, region/preset, approximate location) to the broker's map topic, matching firmware's map_reporting_enabled. Off by default." />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Spacing="4">
                    <TextBlock VerticalAlignment="Center" Text="Interval" />
                    <TextBox app:RejectInvalidBehavior.IsEnabled="True" Width="60" FontFamily="Consolas"
                             Text="{Binding MqttMapReportIntervalSeconds, Mode=TwoWay}" />
                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Text="sec" />
                    <TextBlock VerticalAlignment="Center" Text="Precision" />
                    <ComboBox Name="PrecisionCombo" Width="140"
                              ToolTip.Tip="Approximate radius your location is fuzzed to before publishing. Firmware default: 14 bits (~1.5 km).">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="mesh:PositionPrecisionOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
