<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Renders offscreen through the real Skia pipeline, so what these tests
         sample is what the app draws, not a stand-in for it. Avalonia's own
         xunit integration is not referenced: at 12.1 it is built against xunit
         v3 while this repo is on v2, and its attributes are never discovered.
         HeadlessAvalonia drives the dispatcher instead. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\app\MeshRF.App.Avalonia\MeshRF.App.Avalonia.csproj" />
  </ItemGroup>

  <!-- These tests construct the real MainWindow, whose view model talks to the
       native bridge on the way up, so the library has to be beside the test
       assembly as well as beside the app. -->
  <Import Project="..\..\NativeBridge.targets" />

</Project>
