<Project>

  <!-- Imported by anything that has to run the managed code: the app, and the
       headless UI tests, which build a real MainWindow and so reach the same
       P/Invokes. Shared rather than duplicated so the two cannot drift on
       which native build they pick up. -->

  <!-- Copy the native bridge library produced by CMake into the output dir so
       P/Invoke can find it at runtime. The native DSP hot path is far too slow
       in a Debug (unoptimized, bounds-checked) build to sustain 2.4 MS/s, so
       this defaults to the optimized RelWithDebInfo native build even when the
       managed app is built Debug. Override with -p:NativeConfig=Debug if you
       need to debug the C++ side. Each OS has its own CMake preset (and so its
       own build dir) and its own shared-library extension; override
       NativeConfig/NativeBinDir directly to point somewhere else. The macOS
       branch is untested — see the macos-arm64 preset in CMakePresets.json. -->
  <PropertyGroup>
    <NativeConfig Condition="'$(NativeConfig)' == ''">RelWithDebInfo</NativeConfig>
    <NativeBinDir Condition="'$(NativeBinDir)' == '' AND '$(OS)' == 'Windows_NT'">$(MSBuildThisFileDirectory)build\windows-x64\bin\$(NativeConfig)</NativeBinDir>
    <!-- The Linux CMake presets are named for the RID they target
         (linux-x64, linux-arm64), so the build directory follows straight
         from it. An explicit -r wins; otherwise the SDK's own host RID picks
         the right one when building natively on a Pi or a uConsole. -->
    <_NativeLinuxRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_NativeLinuxRid>
    <_NativeLinuxRid Condition="'$(_NativeLinuxRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_NativeLinuxRid>
    <_NativeLinuxRid Condition="'$(_NativeLinuxRid)' == ''">linux-x64</_NativeLinuxRid>
    <NativeBinDir Condition="'$(NativeBinDir)' == '' AND '$([MSBuild]::IsOSPlatform(`Linux`))'">$(MSBuildThisFileDirectory)build/$(_NativeLinuxRid)/bin</NativeBinDir>
    <NativeBinDir Condition="'$(NativeBinDir)' == '' AND '$([MSBuild]::IsOSPlatform(`OSX`))'">$(MSBuildThisFileDirectory)build/macos-arm64/bin</NativeBinDir>
  </PropertyGroup>
  <Target Name="CopyNativeBridge" AfterTargets="Build">
    <ItemGroup>
      <_NativeBridgeLib Include="$(NativeBinDir)\MeshRF.Native.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <_NativeBridgeLib Include="$(NativeBinDir)/libMeshRF.Native.so" Condition="'$([MSBuild]::IsOSPlatform(`Linux`))'" />
      <_NativeBridgeLib Include="$(NativeBinDir)/libMeshRF.Native.dylib" Condition="'$([MSBuild]::IsOSPlatform(`OSX`))'" />
      <_NativeRuntimeDll Include="$(NativeBinDir)\hackrf.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <_NativeRuntimeDll Include="$(NativeBinDir)\libusb-1.0.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <_NativeRuntimeDll Include="$(NativeBinDir)\pthreadVC2.dll" Condition="'$(OS)' == 'Windows_NT'" />
      <_NativeRuntimeDll Include="$(NativeBinDir)\rtlsdr.dll" Condition="'$(OS)' == 'Windows_NT'" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeBridgeLib)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_NativeBridgeLib.FullPath)')" />
    <Copy SourceFiles="@(_NativeRuntimeDll)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_NativeRuntimeDll.FullPath)')" />
    <Warning Text="Native bridge library not found under $(NativeBinDir). Build the native CMake project first."
             Condition="'@(_NativeBridgeLib)' == '' Or !Exists('%(_NativeBridgeLib.FullPath)')" />
  </Target>

</Project>
